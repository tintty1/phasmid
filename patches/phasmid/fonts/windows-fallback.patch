+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_LINUX_WINDOWS_FALLBACK_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_LINUX_WINDOWS_FALLBACK_H_
+
+#include <unicode/uscript.h>
+
+#include "base/containers/span.h"
+#include "third_party/blink/renderer/platform/fonts/font_description.h"
+#include "third_party/blink/renderer/platform/fonts/font_fallback_priority.h"
+#include "third_party/blink/renderer/platform/wtf/text/atomic_string.h"
+
+class SkFontMgr;
+
+namespace blink {
+
+class LayoutLocale;
+
+// Phasmid: Windows Chrome's per-character fallback family, as
+// win/font_fallback_win.cc GetFallbackFamily. A family counts as present
+// when `font_manager` matches it by name, which asks the browser's name
+// gate. Returns a null atom when nothing applies; `script_out` is the script
+// used, or USCRIPT_INVALID_CODE when a block or emoji rule picked the family.
+const AtomicString& GetWindowsFallbackFamily(
+    UChar32 character,
+    FontDescription::GenericFamilyType generic,
+    const LayoutLocale* content_locale,
+    FontFallbackPriority fallback_priority,
+    const SkFontMgr& font_manager,
+    UScriptCode& script_out);
+
+// The fonts with wide coverage that Windows tries when the family above
+// cannot render the character (win/font_cache_skia_win.cc
+// GetFallbackFamilyNameFromHardcodedChoices): the CJK list for Han, the
+// common one otherwise. Lowercase, in Windows' order.
+base::span<const char* const> WindowsPanUnicodeFonts(UScriptCode script);
+
+}  // namespace blink
