+// Phasmid: a windows profile maps the names Windows Chrome maps before
+// matching (AdjustFamilyNameToAvoidUnsupportedFonts under IS_WIN): the
+// bitmap-only Courier, MS Sans Serif and MS Serif, and Times.
+const AtomicString& AdjustFamilyNameForProfile(const AtomicString& family) {
+  if (phasmid::ClaimsWindows()) {
+    if (EqualIgnoringAsciiCase(family, font_family_names::kCourier)) {
+      return font_family_names::kCourierNew;
+    }
+    if (EqualIgnoringAsciiCase(family, font_family_names::kMSSansSerif)) {
+      return font_family_names::kMicrosoftSansSerif;
+    }
+    if (EqualIgnoringAsciiCase(family, font_family_names::kMSSerif) ||
+        EqualIgnoringAsciiCase(family, font_family_names::kTimes)) {
+      return font_family_names::kTimesNewRoman;
+    }
+  }
+  return AdjustFamilyNameToAvoidUnsupportedFonts(family);
+}
