+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+// Phasmid: the Windows 11 menu font (NONCLIENTMETRICS) for the UI language,
+// the first of locale.languages.
+std::string PhasmidWindowsMenuFontFamily() {
+  const std::string language =
+      base::ToLowerASCII(phasmid::Profile::Get()->languages().front());
+  const auto is = [&language](std::string_view base_language) {
+    return language == base_language ||
+           (language.starts_with(base_language) &&
+            language[base_language.size()] == '-');
+  };
+  if (is("ja")) {
+    return "Yu Gothic UI";
+  }
+  if (is("ko")) {
+    return "Malgun Gothic";
+  }
+  if (is("zh")) {
+    for (std::string_view hant : {"-hant", "-tw", "-hk", "-mo"}) {
+      if (language.find(hant) != std::string::npos) {
+        return "Microsoft JhengHei UI";
+      }
+    }
+    return "Microsoft YaHei UI";
+  }
+  return "Segoe UI";
+}
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
