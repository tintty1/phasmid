@@ -0,0 +1,274 @@
+// Copyright 2026 The Phasmid Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/fonts/windows_text_metrics.h"
+
+#include <stddef.h>
+
+#include <algorithm>
+
+#include "components/phasmid/profile.h"
+#include "third_party/skia/include/core/SkFont.h"
+#include "third_party/skia/include/core/SkFontTypes.h"
+#include "third_party/skia/include/core/SkScalar.h"
+#include "third_party/skia/include/core/SkTypeface.h"
+#include "third_party/skia/include/core/SkTypes.h"
+
+namespace blink::windows_text_metrics {
+
+namespace {
+
+constexpr SkFontTableTag kOs2Tag = SkSetFourByteTag('O', 'S', '/', '2');
+constexpr SkFontTableTag kHheaTag = SkSetFourByteTag('h', 'h', 'e', 'a');
+constexpr SkFontTableTag kEblcTag = SkSetFourByteTag('E', 'B', 'L', 'C');
+constexpr SkFontTableTag kEbscTag = SkSetFourByteTag('E', 'B', 'S', 'C');
+constexpr SkFontTableTag kGaspTag = SkSetFourByteTag('g', 'a', 's', 'p');
+constexpr SkFontTableTag kHdmxTag = SkSetFourByteTag('h', 'd', 'm', 'x');
+
+// OS/2 fsSelection bit 7.
+constexpr uint16_t kUseTypoMetrics = 1 << 7;
+// EBLC and EBSC version 2.0 (SkOTTable_EBLC.h, SkOTTable_EBSC.h
+// version_initial).
+constexpr uint32_t kBitmapTableVersion = 0x00020000;
+// SkScalerContext_win_dw.cpp has_bitmap_strike and get_gasp_range limits.
+constexpr uint32_t kMaxBitmapSizes = 1024;
+constexpr uint16_t kMaxGaspRanges = 1024;
+// gasp behaviour GASP_GRIDFIT alone (is_gridfit_only).
+constexpr uint16_t kGaspGridfitOnly = 0x0001;
+
+// The first `length` bytes of `tag`, or an empty vector when the table is
+// shorter.
+Vector<uint8_t> ReadTable(const SkTypeface& typeface,
+                          SkFontTableTag tag,
+                          wtf_size_t length) {
+  Vector<uint8_t> data(length);
+  if (!length || typeface.getTableData(tag, 0, length, data.data()) != length) {
+    return {};
+  }
+  return data;
+}
+
+Vector<uint8_t> ReadWholeTable(const SkTypeface& typeface,
+                               SkFontTableTag tag) {
+  const size_t size = typeface.getTableSize(tag);
+  // No table this code reads comes near 16 MB.
+  if (size > (1u << 24)) {
+    return {};
+  }
+  return ReadTable(typeface, tag, static_cast<wtf_size_t>(size));
+}
+
+uint16_t U16(const Vector<uint8_t>& data, wtf_size_t offset) {
+  return static_cast<uint16_t>((data[offset] << 8) | data[offset + 1]);
+}
+
+int16_t S16(const Vector<uint8_t>& data, wtf_size_t offset) {
+  return static_cast<int16_t>(U16(data, offset));
+}
+
+uint32_t U32(const Vector<uint8_t>& data, wtf_size_t offset) {
+  return (static_cast<uint32_t>(U16(data, offset)) << 16) |
+         U16(data, offset + 2);
+}
+
+// get_gasp_range: the gasp range holding `ppem`, as [min, max], and whether
+// its behaviour is gridfit only.
+bool GaspRange(const SkTypeface& typeface,
+               int ppem,
+               int* min,
+               int* max,
+               bool* gridfit_only) {
+  const Vector<uint8_t> gasp = ReadWholeTable(typeface, kGaspTag);
+  if (gasp.size() < 4) {
+    return false;
+  }
+  const uint16_t version = U16(gasp, 0);
+  const uint16_t ranges = U16(gasp, 2);
+  if ((version != 0 && version != 1) || ranges > kMaxGaspRanges ||
+      gasp.size() < 4u + 4u * ranges) {
+    return false;
+  }
+  int min_ppem = -1;
+  for (uint16_t i = 0; i < ranges; ++i) {
+    const int max_ppem = U16(gasp, 4 + 4 * i);
+    if (min_ppem < ppem && ppem <= max_ppem) {
+      *min = min_ppem + 1;
+      *max = max_ppem;
+      *gridfit_only = U16(gasp, 6 + 4 * i) == kGaspGridfitOnly;
+      return true;
+    }
+    min_ppem = max_ppem;
+  }
+  return false;
+}
+
+// has_bitmap_strike: an EBLC strike of at least 4 glyphs with square ppem in
+// [min, max], or, when EBLC has none, an EBSC entry there.
+bool HasBitmapStrike(const SkTypeface& typeface, int min, int max) {
+  // Only the headers and the size tables are read: EBLC's index subtables
+  // can be large.
+  const Vector<uint8_t> eblc_header = ReadTable(typeface, kEblcTag, 8);
+  if (eblc_header.empty() || U32(eblc_header, 0) != kBitmapTableVersion ||
+      U32(eblc_header, 4) > kMaxBitmapSizes) {
+    return false;
+  }
+  // BitmapSizeTable: 48 bytes; startGlyphIndex at 40, endGlyphIndex at 42,
+  // ppemX at 44, ppemY at 45.
+  const uint32_t sizes = U32(eblc_header, 4);
+  const Vector<uint8_t> eblc = ReadTable(typeface, kEblcTag, 8 + 48 * sizes);
+  if (eblc.empty()) {
+    return false;
+  }
+  for (uint32_t i = 0; i < sizes; ++i) {
+    const wtf_size_t table = 8 + 48 * i;
+    const int ppem_x = eblc[table + 44];
+    if (ppem_x == eblc[table + 45] && min <= ppem_x && ppem_x <= max &&
+        U16(eblc, table + 42) >= U16(eblc, table + 40) + 3) {
+      return true;
+    }
+  }
+  const Vector<uint8_t> ebsc_header = ReadTable(typeface, kEbscTag, 8);
+  if (ebsc_header.empty() || U32(ebsc_header, 0) != kBitmapTableVersion ||
+      U32(ebsc_header, 4) > kMaxBitmapSizes) {
+    return false;
+  }
+  // BitmapScaleTable: 28 bytes; ppemX at 24, ppemY at 25.
+  const uint32_t scales = U32(ebsc_header, 4);
+  const Vector<uint8_t> ebsc = ReadTable(typeface, kEbscTag, 8 + 28 * scales);
+  if (ebsc.empty()) {
+    return false;
+  }
+  for (uint32_t i = 0; i < scales; ++i) {
+    const wtf_size_t table = 8 + 28 * i;
+    const int ppem_x = ebsc[table + 24];
+    if (ppem_x == ebsc[table + 25] && min <= ppem_x && ppem_x <= max) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+bool Enabled() {
+  return phasmid::ClaimsWindows();
+}
+
+float GdiTextSize(float size) {
+  const float gdi = SkScalarRoundToScalar(size * 64.0f) / 64.0f;
+  return gdi == 0 ? SK_Scalar1 : gdi;
+}
+
+int GdiPpem(const SkFont& font) {
+  return SkScalarTruncToInt(GdiTextSize(font.getSize()));
+}
+
+bool IsGdiClassic(const SkFont& font) {
+  const SkTypeface* typeface = font.getTypeface();
+  if (!typeface || !font.isEmbeddedBitmaps()) {
+    return false;
+  }
+  const int ppem = GdiPpem(font);
+  int min = ppem;
+  int max = ppem;
+  bool gridfit_only = false;
+  if (!GaspRange(*typeface, ppem, &min, &max, &gridfit_only) ||
+      !gridfit_only) {
+    min = max = ppem;
+  }
+  return HasBitmapStrike(*typeface, min, max);
+}
+
+std::optional<VerticalMetrics> DirectWriteVerticalMetrics(const SkFont& font) {
+  const SkTypeface* typeface = font.getTypeface();
+  if (!typeface) {
+    return std::nullopt;
+  }
+  const int upem = typeface->getUnitsPerEm();
+  // OS/2 up to usWinDescent (offset 76), hhea up to lineGap (offset 8).
+  const Vector<uint8_t> os2 = ReadTable(*typeface, kOs2Tag, 78);
+  const Vector<uint8_t> hhea = ReadTable(*typeface, kHheaTag, 10);
+  if (upem <= 0 || os2.empty() || hhea.empty()) {
+    return std::nullopt;
+  }
+  int ascent;
+  int descent;
+  int line_gap;
+  if (U16(os2, 62) & kUseTypoMetrics) {
+    ascent = S16(os2, 68);
+    descent = -S16(os2, 70);
+    line_gap = S16(os2, 72);
+  } else {
+    // GDI's external leading: what hhea spaces lines by beyond the win
+    // ascent and descent.
+    ascent = U16(os2, 74);
+    descent = U16(os2, 76);
+    line_gap = std::max(0, S16(hhea, 4) - S16(hhea, 6) + S16(hhea, 8) -
+                               ascent - descent);
+  }
+  const float size =
+      IsGdiClassic(font) ? GdiTextSize(font.getSize()) : font.getSize();
+  return VerticalMetrics{size * ascent / upem, size * descent / upem,
+                         size * line_gap / upem};
+}
+
+SkFont NaturalAdvanceFont(const SkFont& font) {
+  SkFont natural(font);
+  natural.setEmbeddedBitmaps(false);
+  natural.setHinting(SkFontHinting::kNone);
+  natural.setLinearMetrics(true);
+  natural.setSubpixel(true);
+  return natural;
+}
+
+SkFont GdiClassicAdvanceFont(const SkFont& font) {
+  SkFont gdi_classic = NaturalAdvanceFont(font);
+  gdi_classic.setEmbeddedBitmaps(true);
+  return gdi_classic;
+}
+
+Vector<uint8_t> HdmxWidths(const SkTypeface& typeface, int ppem) {
+  const Vector<uint8_t> hdmx = ReadWholeTable(typeface, kHdmxTag);
+  const int glyphs = typeface.countGlyphs();
+  if (hdmx.size() < 8 || U16(hdmx, 0) != 0 || glyphs <= 0) {
+    return {};
+  }
+  const int records = S16(hdmx, 2);
+  const uint32_t record_size = U32(hdmx, 4);
+  const wtf_size_t glyph_count = static_cast<wtf_size_t>(glyphs);
+  if (records <= 0 || record_size < 2 + glyph_count) {
+    return {};
+  }
+  const uint64_t records_end =
+      8 + uint64_t{record_size} * static_cast<uint32_t>(records);
+  if (hdmx.size() < records_end) {
+    return {};
+  }
+  for (int i = 0; i < records; ++i) {
+    const wtf_size_t record = 8 + record_size * static_cast<uint32_t>(i);
+    if (hdmx[record] == ppem) {
+      Vector<uint8_t> widths;
+      widths.reserve(glyph_count);
+      for (wtf_size_t glyph = 0; glyph < glyph_count; ++glyph) {
+        widths.push_back(hdmx[record + 2 + glyph]);
+      }
+      return widths;
+    }
+  }
+  return {};
+}
+
+float GlyphAdvance(const SkFont& font, uint16_t glyph) {
+  if (!IsGdiClassic(font)) {
+    return NaturalAdvanceFont(font).getWidth(glyph);
+  }
+  const SkTypeface* typeface = font.getTypeface();
+  const Vector<uint8_t> hdmx = HdmxWidths(*typeface, GdiPpem(font));
+  return wtf_size_t{glyph} < hdmx.size()
+             ? hdmx[glyph]
+             : SkScalarRoundToScalar(
+                   GdiClassicAdvanceFont(font).getWidth(glyph));
+}
