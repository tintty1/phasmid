+// found in the LICENSE file.
+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_WINDOWS_TEXT_METRICS_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_WINDOWS_TEXT_METRICS_H_
+
+#include <stdint.h>
+
+#include <optional>
+
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+
+class SkFont;
+class SkTypeface;
+
+namespace blink {
+
+// For a profile that claims Windows, text is measured as Windows Chrome
+// measures it through DirectWrite
+// (SkScalerContext_win_dw.cpp at the Skia pin): OS/2 vertical metrics, the
+// GDI line gap, natural (unhinted, linear) advances, and integer advances in
+// DirectWrite's GDI-classic mode. The same font files give the same values.
+namespace windows_text_metrics {
+
+// Whether the profile claims Windows. Without a profile, or for a Linux
+// profile, every caller keeps Chromium's own path.
+bool Enabled();
+
+// DirectWrite's vertical metrics for `font`, in pixels and unrounded: the
+// OS/2 win metrics, or the typo metrics when USE_TYPO_METRICS is set, and
+// the line gap DirectWrite derives from them. nullopt when the font has no
+// usable OS/2 and hhea tables.
+struct VerticalMetrics {
+  float ascent = 0;
+  float descent = 0;
+  float line_gap = 0;
+};
+std::optional<VerticalMetrics> DirectWriteVerticalMetrics(const SkFont& font);
+
+// Whether DirectWrite measures `font` in GDI-classic mode: embedded bitmaps
+// requested and an EBLC strike (or EBSC entry) at the GDI ppem, widened to
+// the gasp range when that range is gridfit-only.
+bool IsGdiClassic(const SkFont& font);
+
+// The font size DirectWrite renders and measures with in GDI modes:
+// round(size * 64) / 64, at least 1.
+float GdiTextSize(float size);
+
+// The ppem DirectWrite picks bitmap strikes and GDI widths at:
+// trunc(GdiTextSize(size)).
+int GdiPpem(const SkFont& font);
+
+// `font` set up so that Skia returns DirectWrite's natural advances, the
+// linear design advances: no embedded bitmaps, no hinting, linear metrics,
+// subpixel.
+SkFont NaturalAdvanceFont(const SkFont& font);
+
+// The advance font for GDI-classic mode, before rounding: NaturalAdvanceFont
+// with the embedded bitmaps kept, so a glyph that has a bitmap in the strike
+// measures with the bitmap's advance (EBDT), as GDI does, and every other
+// glyph with its linear advance.
+SkFont GdiClassicAdvanceFont(const SkFont& font);
+
+// The hdmx device widths of `typeface` at `ppem`, indexed by glyph, or an
+// empty vector when the font has no record for that size. GDI measures with
+// these widths in GDI-classic mode.
+Vector<uint8_t> HdmxWidths(const SkTypeface& typeface, int ppem);
+
+// The advance of one glyph as DirectWrite measures it with `font`.
+float GlyphAdvance(const SkFont& font, uint16_t glyph);
+
+}  // namespace windows_text_metrics
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_FONTS_WINDOWS_TEXT_METRICS_H_
