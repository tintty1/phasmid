+// The first of locale.languages as Windows Chrome's UI locale: Japanese,
+// Korean and Chinese tags reduce to ja, ko, zh-CN or zh-TW (Hant, TW, HK,
+// MO).
+std::string PhasmidWindowsUiLocale() {
+  const std::string& tag = phasmid::Profile::Get()->languages().front();
+  const std::string lower = base::ToLowerASCII(tag);
+  const auto is = [&lower](std::string_view language) {
+    return lower == language ||
+           (lower.starts_with(language) && lower[language.size()] == '-');
+  };
+  if (is("ja")) {
+    return "ja";
+  }
+  if (is("ko")) {
+    return "ko";
+  }
+  if (is("zh")) {
+    for (std::string_view hant : {"-hant", "-tw", "-hk", "-mo"}) {
+      if (lower.find(hant) != std::string::npos) {
+        return "zh-TW";
+      }
+    }
+    return "zh-CN";
+  }
+  return tag;
+}
+
+// RegisterProfilePrefs's kFontDefaults loop on the Windows table: the UI
+// locale's translations, Consolas for a Courier fixed font (ClearType, as
+// ShouldUseAlternateDefaultFixedFont), no default for the UI locale's own
+// script, and fonts.default_* last.
+void PhasmidRegisterWindowsFontDefaults(
+    user_prefs::PrefRegistrySyncable* registry,
+    std::set<std::string>* fonts_with_defaults) {
+  const std::string ui_locale = PhasmidWindowsUiLocale();
+  const UScriptCode ui_script = GetScriptOfBrowserLocale(ui_locale);
+  for (const PhasmidWindowsFont& font : kPhasmidWindowsFonts) {
+    if (GetScriptOfFontPref(font.pref_name) == ui_script) {
+      continue;
+    }
+    std::string value = font.family;
+    for (const PhasmidWindowsLocaleFont& translated :
+         kPhasmidWindowsLocaleFonts) {
+      if (ui_locale == translated.locale &&
+          std::string_view(font.pref_name) == translated.pref_name) {
+        value = translated.family;
+      }
+    }
+    if (std::string_view(font.pref_name) == prefs::kWebKitFixedFontFamily &&
+        base::StartsWith(value, "courier",
+                         base::CompareCase::INSENSITIVE_ASCII)) {
+      value = "Consolas";
+    }
+#if PREFS_FONT_LIST
+    if (value.starts_with(',')) {
+      value = gfx::FontList::FirstAvailableOrFirst(value);
+    }
+#endif
+    if (const std::string* family = PhasmidGenericFamily(font.pref_name)) {
+      value = *family;
+    }
+    registry->RegisterStringPref(font.pref_name, value);
+    fonts_with_defaults->insert(font.pref_name);
+  }
+}
+
+// Windows Chrome's IDS_MINIMUM_LOGICAL_FONT_SIZE for the UI locale.
+int PhasmidWindowsMinimumLogicalFontSize() {
+  const std::string ui_locale = PhasmidWindowsUiLocale();
+  if (ui_locale == "ja" || ui_locale == "ko") {
+    return 10;
+  }
+  if (ui_locale == "zh-CN" || ui_locale == "zh-TW") {
+    return 12;
+  }
+  return 6;
+}
