+// Phasmid: the profile's family for a generic family pref, or null to keep
+// Chrome's default. The standard font follows serif, as on Linux.
+const std::string* PhasmidGenericFamily(const char* pref_name) {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile) {
+    return nullptr;
+  }
+  const phasmid::Profile::Fonts& fonts = profile->fonts();
+  const std::string* family = nullptr;
+  if (pref_name == prefs::kWebKitStandardFontFamily ||
+      pref_name == prefs::kWebKitSerifFontFamily) {
+    family = &fonts.default_serif;
+  } else if (pref_name == prefs::kWebKitSansSerifFontFamily) {
+    family = &fonts.default_sans;
+  } else if (pref_name == prefs::kWebKitFixedFontFamily) {
+    family = &fonts.default_monospace;
+  }
+  return family && !family->empty() ? family : nullptr;
+}
