+// Phasmid: the Windows endpoint name's adapter, "Realtek(R) Audio" in
+// "Speakers (Realtek(R) Audio)", or empty.
+std::string PhasmidEndpointAdapter(const std::string& label) {
+  const size_t open = label.rfind(" (");
+  if (open == std::string::npos || label.back() != ')') {
+    return std::string();
+  }
+  return label.substr(open + 2, label.size() - open - 3);
+}
+
+// Phasmid: the profile's devices, listed as the claimed OS's audio manager
+// lists them. Linux: a "Default" entry first, groups "input" and "default";
+// an input shares the group of the output with the same label. Windows:
+// "Default - <first>" and "Communications - <first>" first, in that
+// device's group; an input shares the group of the output on the same
+// adapter. "Communications" exists only in Windows resources; this is its
+// en-US text. Video groups are left to GuessVideoGroupID. No host device has
+// these raw IDs, so capture on one fails to start.
+blink::WebMediaDeviceInfoArray GetProfileDevices(
+    MediaDeviceType type,
+    const phasmid::Profile::MediaDevices& devices,
+    bool windows) {
+  auto raw_id = [](const char* kind, size_t index) {
+    return base::StringPrintf("phasmid-%s-%zu", kind, index);
+  };
+  auto input_group = [&](size_t i) {
+    const std::string& input = devices.audio_inputs[i];
+    const std::string adapter = PhasmidEndpointAdapter(input);
+    for (size_t j = 0; j < devices.audio_outputs.size(); ++j) {
+      const std::string& output = devices.audio_outputs[j];
+      if (windows ? !adapter.empty() &&
+                        PhasmidEndpointAdapter(output) == adapter
+                  : output == input) {
+        return raw_id("audiooutput", j);
+      }
+    }
+    return raw_id("audioinput", i) + "input";
+  };
+  constexpr char kCommunications[] = "Communications";
+  blink::WebMediaDeviceInfoArray result;
+  switch (type) {
+    case MediaDeviceType::kMediaAudioInput:
+      if (!devices.audio_inputs.empty() && windows) {
+        result.emplace_back(
+            media::AudioDeviceDescription::kDefaultDeviceId,
+            media::AudioDeviceDescription::GetDefaultDeviceName(
+                devices.audio_inputs.front()),
+            input_group(0));
+        result.emplace_back(
+            media::AudioDeviceDescription::kCommunicationsDeviceId,
+            base::StringPrintf("%s - %s", kCommunications,
+                               devices.audio_inputs.front().c_str()),
+            input_group(0));
+      } else if (!devices.audio_inputs.empty()) {
+        result.emplace_back(
+            media::AudioDeviceDescription::kDefaultDeviceId,
+            media::AudioDeviceDescription::GetDefaultDeviceName(), "input");
+      }
+      for (size_t i = 0; i < devices.audio_inputs.size(); ++i) {
+        result.emplace_back(raw_id("audioinput", i), devices.audio_inputs[i],
+                            input_group(i));
+      }
+      break;
+    case MediaDeviceType::kMediaAudioOutput:
+      if (!devices.audio_outputs.empty() && windows) {
+        result.emplace_back(
+            media::AudioDeviceDescription::kDefaultDeviceId,
+            media::AudioDeviceDescription::GetDefaultDeviceName(
+                devices.audio_outputs.front()),
+            raw_id("audiooutput", 0));
+        result.emplace_back(
+            media::AudioDeviceDescription::kCommunicationsDeviceId,
+            base::StringPrintf("%s - %s", kCommunications,
+                               devices.audio_outputs.front().c_str()),
+            raw_id("audiooutput", 0));
+      } else if (!devices.audio_outputs.empty()) {
+        result.emplace_back(
+            media::AudioDeviceDescription::kDefaultDeviceId,
+            media::AudioDeviceDescription::GetDefaultDeviceName(),
+            media::AudioDeviceDescription::kDefaultDeviceId);
+      }
+      for (size_t i = 0; i < devices.audio_outputs.size(); ++i) {
+        result.emplace_back(raw_id("audiooutput", i), devices.audio_outputs[i],
+                            raw_id("audiooutput", i));
+      }
+      break;
+    case MediaDeviceType::kMediaVideoInput:
+      for (size_t i = 0; i < devices.video_inputs.size(); ++i) {
+        result.emplace_back(raw_id("videoinput", i), devices.video_inputs[i],
+                            std::string());
+      }
+      break;
+    default:
+      NOTREACHED();
+  }
+  return result;
+}
