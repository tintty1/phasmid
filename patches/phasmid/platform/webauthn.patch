+                // Phasmid: Linux Chrome never counts GPM on google.com
+                // (below); Windows Hello counts everywhere.
+                if (const phasmid::Profile* claim = phasmid::Profile::Get()) {
+                  const bool available =
+                      claim->capabilities()
+                          .user_verifying_platform_authenticator &&
+                      !(is_google && claim->os_family() == "linux");
+                  std::move(callback).Run(
+                      available ? std::optional<bool>(true) : std::nullopt);
+                  return;
+                }
