+// Phasmid: the "Google Network Speech" component extension, which this build
+// does not load, so an utterance gets no event until it is cancelled, as in
+// Google Chrome when its speech server cannot be reached.
+constexpr char kPhasmidNetworkSpeechEngineId[] =
+    "fignfifoniblkonapihmkfakmlgkbkcf";
+
+// Phasmid: the first voice is the default (SendVoiceListToObserver). Event
+// types are the network engine's, as TtsExtensionEngine::GetVoices builds them.
+void ReplaceWithPhasmidVoices(std::vector<VoiceData>* out_voices) {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile) {
+    return;
+  }
+  out_voices->clear();
+  for (const phasmid::Profile::SpeechVoice& profile_voice :
+       profile->speech_voices()) {
+    VoiceData& voice = out_voices->emplace_back();
+    voice.name = profile_voice.name;
+    voice.lang = profile_voice.lang;
+    voice.engine_id = kPhasmidNetworkSpeechEngineId;
+    // localService is !remote (SendVoiceListToObserver). A local voice is
+    // still non-native, so speak() takes the same silent engine path.
+    voice.remote = !profile_voice.local_service;
+    voice.native = false;
+    voice.events = {TTS_EVENT_START, TTS_EVENT_END, TTS_EVENT_ERROR,
+                    TTS_EVENT_CANCELLED, TTS_EVENT_INTERRUPTED};
+  }
+}
+
 }  // namespace
 
