+# Phasmid fingerprint inspector: members listed in this file get a
+# PhasmidFingerprintTraceScope in their callback.
+_PHASMID_FINGERPRINT_ALLOWLIST = (
+    "third_party/blink/renderer/bindings/phasmid_fingerprint_allowlist.txt")
+_phasmid_fingerprint_entries = None
+
+
+def _phasmid_fingerprint_allowlist():
+    global _phasmid_fingerprint_entries
+    if _phasmid_fingerprint_entries is None:
+        entries = set()
+        with open(PathManager.src_path_to(_PHASMID_FINGERPRINT_ALLOWLIST)) as f:
+            for line in f:
+                line = line.split("#", 1)[0].strip()
+                if line:
+                    entries.add(line)
+        _phasmid_fingerprint_entries = frozenset(entries)
+    return _phasmid_fingerprint_entries
+
+
+def _phasmid_is_no_alloc_direct_call(member, operation_group):
+    if operation_group is not None:
+        return "NoAllocDirectCall" in operation_group.extended_attributes
+    return member is not None and (
+        "NoAllocDirectCall" in member.extended_attributes)
+
+
+def check_phasmid_fingerprint_allowlist(web_idl_database):
+    """Fails on an entry that names no member, or a [NoAllocDirectCall]
+    member: its fast path skips the slow callback that carries the trace."""
+    class_likes = {}
+    for class_like in itertools.chain(web_idl_database.interfaces,
+                                      web_idl_database.namespaces):
+        class_likes[class_like.identifier] = class_like
+    errors = []
+    for entry in sorted(_phasmid_fingerprint_allowlist()):
+        if entry == "*":
+            continue
+        class_name, _, member_name = entry.partition(".")
+        class_like = class_likes.get(class_name)
+        if class_like is None or not member_name:
+            errors.append("{}: no such interface or namespace".format(entry))
+            continue
+        if member_name == "*":
+            continue
+        found = False
+        if member_name == "constructor":
+            found = bool(getattr(class_like, "constructor_groups", None))
+        for attribute in class_like.attributes:
+            if attribute.identifier == member_name:
+                found = True
+                if _phasmid_is_no_alloc_direct_call(attribute, None):
+                    errors.append("{}: [NoAllocDirectCall]".format(entry))
+        for operation_group in class_like.operation_groups:
+            if operation_group.identifier == member_name:
+                found = True
+                if _phasmid_is_no_alloc_direct_call(None, operation_group):
+                    errors.append("{}: [NoAllocDirectCall]".format(entry))
+        if not found:
+            errors.append("{}: matches no member".format(entry))
+    if errors:
+        raise ValueError("{}: {}".format(_PHASMID_FINGERPRINT_ALLOWLIST,
+                                         "; ".join(errors)))
+
+
+def make_phasmid_fingerprint_trace(cg_context):
+    assert isinstance(cg_context, CodeGenContext)
+
+    if cg_context.v8_callback_type != CodeGenContext.V8_FUNCTION_CALLBACK:
+        return None
+    if cg_context.constructor_group:
+        if cg_context.is_legacy_factory_function:
+            return None
+        member_name = "constructor"
+    else:
+        member_name = cg_context.property_.identifier
+    class_name = cg_context.class_like.identifier
+    entries = _phasmid_fingerprint_allowlist()
+    if not ("*" in entries or "{}.*".format(class_name) in entries
+            or "{}.{}".format(class_name, member_name) in entries):
+        return None
+    # Wildcards skip [NoAllocDirectCall] members; a named entry for one is
+    # refused by check_phasmid_fingerprint_allowlist.
+    if _phasmid_is_no_alloc_direct_call(cg_context.attribute,
+                                        cg_context.operation_group):
+        return None
+    node = TextNode("PhasmidFingerprintTraceScope phasmid_fingerprint_trace("
+                    "${{info}}, \"{}\");".format(
+                        _make_bindings_logging_id(cg_context)))
+    node.accumulate(
+        CodeGenAccumulator.require_include_headers([
+            "third_party/blink/renderer/platform/bindings/"
+            "phasmid_fingerprint_trace.h"
+        ]))
+    return node
+
+
