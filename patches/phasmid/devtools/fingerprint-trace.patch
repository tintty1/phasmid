+# Members traced by the Phasmid fingerprint inspector, one per line:
+# "Interface.member" (an attribute covers its getter and setter,
+# "Interface.constructor" the constructor) or "Interface.*". Mixin and partial
+# members carry the including interface's name. "*" alone traces every Web
+# API and is for local runs only. The generator fails on an entry that
+# matches nothing and on a [NoAllocDirectCall] member, whose fast path skips
+# the trace.
+
+# Navigator and workers
+Navigator.*
+WorkerNavigator.*
+NavigatorUAData.*
+
+# Screen and window geometry
+Screen.*
+Window.devicePixelRatio
+Window.innerHeight
+Window.innerWidth
+Window.matchMedia
+Window.outerHeight
+Window.outerWidth
+Window.screen
+Window.screenLeft
+Window.screenTop
+Window.screenX
+Window.screenY
+Window.speechSynthesis
+
+# Canvas 2D readback and text metrics
+CanvasRenderingContext2D.getContextAttributes
+CanvasRenderingContext2D.getImageData
+CanvasRenderingContext2D.measureText
+HTMLCanvasElement.getContext
+HTMLCanvasElement.toBlob
+HTMLCanvasElement.toDataURL
+ImageData.data
+OffscreenCanvas.convertToBlob
+OffscreenCanvas.getContext
+OffscreenCanvasRenderingContext2D.getContextAttributes
+OffscreenCanvasRenderingContext2D.getImageData
+OffscreenCanvasRenderingContext2D.measureText
+TextMetrics.*
+
+# WebGL
+WebGL2RenderingContext.*
+WebGLDebugShaders.*
+WebGLRenderingContext.*
+
+# WebGPU
+GPU.*
+GPUAdapter.*
+GPUAdapterInfo.*
+GPUSupportedFeatures.*
+GPUSupportedLimits.*
+
+# Web Audio
+AnalyserNode.*
+AudioBuffer.*
+AudioContext.*
+AudioDestinationNode.*
+BaseAudioContext.*
+OfflineAudioContext.*
+
+# Fonts
+Document.fonts
+FontFace.*
+FontFaceSet.*
+WorkerGlobalScope.fonts
+
+# Client rects
+Element.getBoundingClientRect
+Element.getClientRects
+Range.getBoundingClientRect
+Range.getClientRects
+
+# Platform capabilities
+BatteryManager.*
+HTMLMediaElement.canPlayType
+Keyboard.*
+KeyboardLayoutMap.*
+MediaCapabilities.*
+MediaDevices.*
+MediaSource.isTypeSupported
+MimeTypeArray.*
+Notification.permission
+Permissions.*
