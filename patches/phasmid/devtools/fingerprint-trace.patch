+namespace v8 {
+class Isolate;
+class Promise;
+class Value;
+}  // namespace v8
+
+namespace blink {
+
+// Phasmid fingerprint inspector. Events go to the dynamic category
+// "disabled-by-default-phasmid.fingerprint", which only an explicit include
+// in a tracing session enables. Nothing here runs page script: values are
+// described from V8's own slots and Blink-created objects are walked through
+// own data property descriptors only.
+class PLATFORM_EXPORT PhasmidFingerprintTrace {
+  STATIC_ONLY(PhasmidFingerprintTrace);
+
+ public:
+  // One relaxed atomic load while no tracing session runs.
+  static bool IsEnabled() {
+    return base::TrackEvent::IsEnabled() && IsCategoryEnabled();
+  }
+
+  // A promise resolver settles (ScriptPromiseResolverBase). `promise` carries
+  // the identity hash a traced call recorded for the promise it returned.
+  static void PromiseSettled(v8::Isolate* isolate,
+                             v8::Local<v8::Promise> promise,
+                             bool resolved,
+                             v8::Local<v8::Value> value,
+                             const char* class_name,
+                             const char* property_name);
+
+  // A CSS media feature evaluated (MediaQueryEvaluator::EvalFeature).
+  static void MediaFeature(const String& feature, const char* result);
+
+  // A font family looked up for a document or worker (CSSFontSelector,
+  // OffscreenFontSelector): `result` is "webfont", "platform" or "miss".
+  static void FontLookup(const char* selector,
+                         const AtomicString& family,
+                         const AtomicString& resolved,
+                         const char* result);
+
+ private:
+  static bool IsCategoryEnabled();
+};
+
+// Placed by the bindings generator in the callback of every member listed in
+// bindings/phasmid_fingerprint_allowlist.txt. When the category is enabled,
+// the destructor emits one event named after the member with the arguments,
+// the return value (or that it threw), the calling script location and the
+// world.
+class PLATFORM_EXPORT PhasmidFingerprintTraceScope {
+  STACK_ALLOCATED();
+
+ public:
+  PhasmidFingerprintTraceScope(const v8::FunctionCallbackInfo<v8::Value>& info,
+                               const char* api) {
+    if (PhasmidFingerprintTrace::IsEnabled()) [[unlikely]] {
+      info_ = &info;
+      api_ = api;
+    }
+  }
+  PhasmidFingerprintTraceScope(const PhasmidFingerprintTraceScope&) = delete;
+  PhasmidFingerprintTraceScope& operator=(const PhasmidFingerprintTraceScope&) =
+      delete;
+  ~PhasmidFingerprintTraceScope() {
+    if (info_) [[unlikely]] {
+      Emit();
+    }
+  }
+
+ private:
+  void Emit();
+
+  const v8::FunctionCallbackInfo<v8::Value>* info_ = nullptr;
+  const char* api_ = nullptr;
+};
+
+}  // namespace blink
