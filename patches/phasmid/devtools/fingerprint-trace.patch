+// Copyright 2026 The Phasmid Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/platform/bindings/phasmid_fingerprint_trace.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <string>
+
+#include "base/containers/span.h"
+#include "base/no_destructor.h"
+#include "base/strings/stringprintf.h"
+#include "base/trace_event/typed_macros.h"
+#include "third_party/blink/renderer/platform/bindings/dom_wrapper_world.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+#include "third_party/blink/renderer/platform/bindings/v8_dom_wrapper.h"
+#include "third_party/blink/renderer/platform/bindings/wrapper_type_info.h"
+#include "third_party/blink/renderer/platform/wtf/vector.h"
+#include "v8/include/v8-array-buffer.h"
+#include "v8/include/v8-container.h"
+#include "v8/include/v8-context.h"
+#include "v8/include/v8-debug.h"
+#include "v8/include/v8-isolate.h"
+#include "v8/include/v8-object.h"
+#include "v8/include/v8-primitive.h"
+#include "v8/include/v8-promise.h"
+#include "v8/include/v8-typed-array.h"
+#include "v8/include/v8-value.h"
+
+namespace blink {
+
+namespace {
+
+constexpr char kCategory[] = "disabled-by-default-phasmid.fingerprint";
+// UTF-8 bytes of a string kept verbatim; the whole string is hashed.
+constexpr size_t kStringPrefixBytes = 1024;
+// Elements of an array, typed array or object kept per value.
+constexpr uint32_t kMaxItems = 64;
+// Levels of Blink-created arrays and objects walked in a return value.
+constexpr int kMaxDepth = 2;
+// JavaScript frames recorded for the caller.
+constexpr int kCallerFrames = 3;
+
+// FNV-1a, 64 bit: stable across builds and easy to recompute from a capture
+// (strings are hashed as UTF-16LE code units, buffers as their bytes).
+uint64_t Fnv1a64(base::span<const uint8_t> bytes) {
+  uint64_t hash = 0xcbf29ce484222325ull;
+  for (uint8_t byte : bytes) {
+    hash ^= byte;
+    hash *= 0x100000001b3ull;
+  }
+  return hash;
+}
+
+std::string Hex(uint64_t hash) {
+  return base::StringPrintf("%016llx", static_cast<unsigned long long>(hash));
+}
+
+std::string Utf8Prefix(v8::Isolate* isolate, v8::Local<v8::String> string) {
+  std::string prefix(kStringPrefixBytes, '\0');
+  size_t written =
+      string->WriteUtf8(isolate, prefix.data(), prefix.size(),
+                        v8::String::WriteFlags::kReplaceInvalidUtf8);
+  prefix.resize(written);
+  return prefix;
+}
+
+void WriteNumber(perfetto::TracedValue out, double number) {
+  if (std::isnan(number)) {
+    std::move(out).WriteString("NaN");
+  } else if (std::isinf(number)) {
+    std::move(out).WriteString(number > 0 ? "Infinity" : "-Infinity");
+  } else if (number == 0 && std::signbit(number)) {
+    std::move(out).WriteString("-0");
+  } else {
+    std::move(out).WriteDouble(number);
+  }
+}
+
+void WriteString(perfetto::TracedDictionary& dict,
+                 v8::Isolate* isolate,
+                 v8::Local<v8::String> string) {
+  const int length = string->Length();
+  Vector<uint16_t> units(static_cast<wtf_size_t>(length));
+  string->Write(isolate, 0, static_cast<uint32_t>(length), units.data());
+  dict.Add("type", "string");
+  dict.Add("length", length);
+  dict.Add("hash", Hex(Fnv1a64(base::as_byte_span(units))));
+  dict.Add("value", Utf8Prefix(isolate, string));
+}
+
+template <typename T>
+void WriteElements(perfetto::TracedArray& array,
+                   v8::Local<v8::ArrayBufferView> view,
+                   size_t count) {
+  Vector<T> items(static_cast<wtf_size_t>(count));
+  view->CopyContents(items.data(), count * sizeof(T));
+  for (T item : items) {
+    WriteNumber(array.AppendItem(), static_cast<double>(item));
+  }
+}
+
+// A protozero parent must not be written while a child is open, so every
+// field of `dict` is added before the "items" array.
+void WriteView(perfetto::TracedDictionary& dict,
+               v8::Local<v8::ArrayBufferView> view) {
+  Vector<uint8_t> bytes(static_cast<wtf_size_t>(view->ByteLength()));
+  view->CopyContents(bytes.data(), bytes.size());
+  if (!view->IsTypedArray()) {
+    dict.Add("type", "DataView");
+  } else if (view->IsUint8Array()) {
+    dict.Add("type", "Uint8Array");
+  } else if (view->IsUint8ClampedArray()) {
+    dict.Add("type", "Uint8ClampedArray");
+  } else if (view->IsInt8Array()) {
+    dict.Add("type", "Int8Array");
+  } else if (view->IsUint16Array()) {
+    dict.Add("type", "Uint16Array");
+  } else if (view->IsInt16Array()) {
+    dict.Add("type", "Int16Array");
+  } else if (view->IsUint32Array()) {
+    dict.Add("type", "Uint32Array");
+  } else if (view->IsInt32Array()) {
+    dict.Add("type", "Int32Array");
+  } else if (view->IsFloat32Array()) {
+    dict.Add("type", "Float32Array");
+  } else if (view->IsFloat64Array()) {
+    dict.Add("type", "Float64Array");
+  } else {
+    // Float16Array and the BigInt arrays: length and hash only.
+    dict.Add("type", "TypedArray");
+  }
+  dict.Add("byteLength", bytes.size());
+  dict.Add("hash", Hex(Fnv1a64(base::span(bytes))));
+  if (!view->IsTypedArray()) {
+    return;
+  }
+  const size_t length = view.As<v8::TypedArray>()->Length();
+  dict.Add("length", length);
+  const size_t count = std::min<size_t>(length, kMaxItems);
+  perfetto::TracedArray items = dict.AddArray("items");
+  if (view->IsUint8Array() || view->IsUint8ClampedArray()) {
+    WriteElements<uint8_t>(items, view, count);
+  } else if (view->IsInt8Array()) {
+    WriteElements<int8_t>(items, view, count);
+  } else if (view->IsUint16Array()) {
+    WriteElements<uint16_t>(items, view, count);
+  } else if (view->IsInt16Array()) {
+    WriteElements<int16_t>(items, view, count);
+  } else if (view->IsUint32Array()) {
+    WriteElements<uint32_t>(items, view, count);
+  } else if (view->IsInt32Array()) {
+    WriteElements<int32_t>(items, view, count);
+  } else if (view->IsFloat32Array()) {
+    WriteElements<float>(items, view, count);
+  } else if (view->IsFloat64Array()) {
+    WriteElements<double>(items, view, count);
+  }
+}
+
+void WriteValue(perfetto::TracedValue out,
+                v8::Isolate* isolate,
+                v8::Local<v8::Value> value,
+                int depth);
+
+// Own enumerable data properties of a Blink-created object or array, read
+// through property descriptors so that no getter, prototype lookup or
+// interceptor can run.
+void WriteOwnData(perfetto::TracedDictionary& dict,
+                  v8::Isolate* isolate,
+                  v8::Local<v8::Object> object,
+                  int depth) {
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  v8::Local<v8::Array> keys;
+  if (!object
+           ->GetOwnPropertyNames(context,
+                                 static_cast<v8::PropertyFilter>(
+                                     v8::ONLY_ENUMERABLE | v8::SKIP_SYMBOLS),
+                                 v8::KeyConversionMode::kConvertToString)
+           .ToLocal(&keys)) {
+    return;
+  }
+  dict.Add("size", keys->Length());
+  v8::Local<v8::String> value_key =
+      v8::String::NewFromUtf8Literal(isolate, "value");
+  perfetto::TracedDictionary entries = dict.AddDictionary("entries");
+  const uint32_t count = std::min(keys->Length(), kMaxItems);
+  for (uint32_t i = 0; i < count; ++i) {
+    v8::Local<v8::Value> key;
+    v8::Local<v8::Value> descriptor;
+    if (!keys->Get(context, i).ToLocal(&key) || !key->IsString() ||
+        !object->GetOwnPropertyDescriptor(context, key.As<v8::Name>())
+             .ToLocal(&descriptor) ||
+        !descriptor->IsObject()) {
+      continue;
+    }
+    std::string name = Utf8Prefix(isolate, key.As<v8::String>());
+    v8::Local<v8::Object> fields = descriptor.As<v8::Object>();
+    v8::Local<v8::Value> field;
+    if (fields->HasOwnProperty(context, value_key).FromMaybe(false) &&
+        fields->Get(context, value_key).ToLocal(&field)) {
+      WriteValue(entries.AddItem(perfetto::DynamicString(name)), isolate, field,
+                 depth - 1);
+    } else {
+      perfetto::TracedDictionary accessor =
+          entries.AddDictionary(perfetto::DynamicString(name));
+      accessor.Add("type", "accessor");
+    }
+  }
+}
+
+void WriteValue(perfetto::TracedValue out,
+                v8::Isolate* isolate,
+                v8::Local<v8::Value> value,
+                int depth) {
+  perfetto::TracedDictionary dict = std::move(out).WriteDictionary();
+  if (value.IsEmpty() || value->IsUndefined()) {
+    dict.Add("type", "undefined");
+    return;
+  }
+  if (value->IsNull()) {
+    dict.Add("type", "null");
+    return;
+  }
+  if (value->IsBoolean()) {
+    dict.Add("type", "boolean");
+    dict.Add("value", value.As<v8::Boolean>()->Value());
+    return;
+  }
+  if (value->IsNumber()) {
+    dict.Add("type", "number");
+    WriteNumber(dict.AddItem("value"), value.As<v8::Number>()->Value());
+    return;
+  }
+  if (value->IsBigInt()) {
+    bool lossless = false;
+    int64_t number = value.As<v8::BigInt>()->Int64Value(&lossless);
+    dict.Add("type", "bigint");
+    dict.Add("value",
+             base::StringPrintf("%lld", static_cast<long long>(number)));
+    dict.Add("lossless", lossless);
+    return;
+  }
+  if (value->IsString()) {
+    WriteString(dict, isolate, value.As<v8::String>());
+    return;
+  }
+  if (value->IsSymbol()) {
+    dict.Add("type", "symbol");
+    v8::Local<v8::Value> description =
+        value.As<v8::Symbol>()->Description(isolate);
+    if (description->IsString()) {
+      dict.Add("description",
+               Utf8Prefix(isolate, description.As<v8::String>()));
+    }
+    return;
+  }
+  if (!value->IsObject()) {
+    dict.Add("type", "other");
+    return;
+  }
+  // Any access to a Proxy could run its traps.
+  if (value->IsProxy()) {
+    dict.Add("type", "Proxy");
+    return;
+  }
+  v8::Local<v8::Object> object = value.As<v8::Object>();
+  if (value->IsPromise()) {
+    v8::Local<v8::Promise> promise = value.As<v8::Promise>();
+    dict.Add("type", "Promise");
+    dict.Add("id", promise->GetIdentityHash());
+    switch (promise->State()) {
+      case v8::Promise::kPending:
+        dict.Add("state", "pending");
+        break;
+      case v8::Promise::kFulfilled:
+        dict.Add("state", "fulfilled");
+        WriteValue(dict.AddItem("value"), isolate, promise->Result(),
+                   kMaxDepth);
+        break;
+      case v8::Promise::kRejected:
+        dict.Add("state", "rejected");
+        WriteValue(dict.AddItem("value"), isolate, promise->Result(),
+                   kMaxDepth);
+        break;
+    }
+    return;
+  }
+  if (value->IsArrayBufferView()) {
+    WriteView(dict, value.As<v8::ArrayBufferView>());
+    return;
+  }
+  if (value->IsArrayBuffer()) {
+    dict.Add("type", "ArrayBuffer");
+    dict.Add("byteLength", value.As<v8::ArrayBuffer>()->ByteLength());
+    return;
+  }
+  if (value->IsSharedArrayBuffer()) {
+    dict.Add("type", "SharedArrayBuffer");
+    return;
+  }
+  if (V8DOMWrapper::IsWrapper(isolate, object)) {
+    dict.Add("type", "wrapper");
+    if (const WrapperTypeInfo* info = ToWrapperTypeInfo(object)) {
+      dict.Add("interface", info->interface_name);
+    }
+    return;
+  }
+  if (value->IsFunction()) {
+    dict.Add("type", "function");
+    return;
+  }
+  if (value->IsArray()) {
+    dict.Add("type", "array");
+    dict.Add("length", value.As<v8::Array>()->Length());
+    if (depth > 0) {
+      WriteOwnData(dict, isolate, object, depth);
+    }
+    return;
+  }
+  std::string constructor = Utf8Prefix(isolate, object->GetConstructorName());
+  dict.Add("type", "object");
+  dict.Add("constructor", constructor);
+  if (depth > 0 && constructor == "Object") {
+    WriteOwnData(dict, isolate, object, depth);
+  }
+}
+
+struct ValueTrace {
+  STACK_ALLOCATED();
+
+ public:
+  void WriteIntoTrace(perfetto::TracedValue context) const {
+    WriteValue(std::move(context), isolate, value, depth);
+  }
+
+  v8::Isolate* isolate;
+  v8::Local<v8::Value> value;
+  int depth;
+};
+
+// The arguments as the page passed them: never converted, never walked, so
+// nothing the page defined (getters, valueOf, toString) runs.
+struct ArgumentsTrace {
+  STACK_ALLOCATED();
+
+ public:
+  void WriteIntoTrace(perfetto::TracedValue context) const {
+    perfetto::TracedArray array = std::move(context).WriteArray();
+    for (int i = 0; i < info->Length(); ++i) {
+      WriteValue(array.AppendItem(), info->GetIsolate(), (*info)[i], 0);
+    }
+  }
+
+  const v8::FunctionCallbackInfo<v8::Value>* info;
+};
+
+// The innermost JavaScript frames, without running Error.prepareStackTrace
+// or reading Error.stackTraceLimit.
+struct CallerTrace {
+  STACK_ALLOCATED();
+
+ public:
+  void WriteIntoTrace(perfetto::TracedValue context) const {
+    perfetto::TracedArray frames = std::move(context).WriteArray();
+    v8::Local<v8::StackTrace> trace =
+        v8::StackTrace::CurrentStackTrace(isolate, kCallerFrames);
+    for (int i = 0; i < trace->GetFrameCount(); ++i) {
+      v8::Local<v8::StackFrame> frame =
+          trace->GetFrame(isolate, static_cast<uint32_t>(i));
+      perfetto::TracedDictionary dict = frames.AppendDictionary();
+      v8::Local<v8::String> url = frame->GetScriptNameOrSourceURL();
+      dict.Add("url", url.IsEmpty() ? std::string() : Utf8Prefix(isolate, url));
+      dict.Add("line", frame->GetLineNumber());
+      dict.Add("column", frame->GetColumn());
+      v8::Local<v8::String> function = frame->GetFunctionName();
+      if (!function.IsEmpty()) {
+        dict.Add("function", Utf8Prefix(isolate, function));
+      }
+    }
+  }
+
+  v8::Isolate* isolate;
+};
+
+}  // namespace
+
+bool PhasmidFingerprintTrace::IsCategoryEnabled() {
+  static const base::NoDestructor<perfetto::DynamicCategory> category(
+      kCategory);
+  return base::TrackEvent::IsDynamicCategoryEnabled(*category);
+}
+
+void PhasmidFingerprintTraceScope::Emit() {
+  v8::Isolate* isolate = info_->GetIsolate();
+  v8::HandleScope handle_scope(isolate);
+  // The exception itself is not reachable from here; a promise-returning
+  // member has already turned it into a rejected promise.
+  const bool threw = isolate->HasPendingException();
+  v8::Local<v8::Value> result;
+  if (!threw) {
+    result = info_->GetReturnValue().Get();
+  }
+  const DOMWrapperWorld& world = DOMWrapperWorld::Current(isolate);
+  perfetto::DynamicCategory category(kCategory);
+  TRACE_EVENT_INSTANT(
+      category, perfetto::StaticString(api_), [&](perfetto::EventContext ctx) {
+        ctx.AddDebugAnnotation("args", ArgumentsTrace{info_});
+        ctx.AddDebugAnnotation("threw", threw);
+        if (!threw) {
+          ctx.AddDebugAnnotation("ret", ValueTrace{isolate, result, kMaxDepth});
+          if (result->IsPromise()) {
+            ctx.AddDebugAnnotation("promise",
+                                   result.As<v8::Promise>()->GetIdentityHash());
+          }
+        }
+        ctx.AddDebugAnnotation("caller", CallerTrace{isolate});
+        ctx.AddDebugAnnotation("world", world.GetWorldId());
+        ctx.AddDebugAnnotation("main_world", world.IsMainWorld());
+      });
+}
+
+void PhasmidFingerprintTrace::PromiseSettled(v8::Isolate* isolate,
+                                             v8::Local<v8::Promise> promise,
+                                             bool resolved,
+                                             v8::Local<v8::Value> value,
+                                             const char* class_name,
+                                             const char* property_name) {
+  v8::HandleScope handle_scope(isolate);
+  perfetto::DynamicCategory category(kCategory);
+  TRACE_EVENT_INSTANT(
+      category, "Promise.settle", [&](perfetto::EventContext ctx) {
+        ctx.AddDebugAnnotation("promise", promise->GetIdentityHash());
+        ctx.AddDebugAnnotation("state", resolved ? "fulfilled" : "rejected");
+        ctx.AddDebugAnnotation("value", ValueTrace{isolate, value, kMaxDepth});
+        if (class_name && property_name) {
+          ctx.AddDebugAnnotation(
+              "api", base::StringPrintf("%s.%s", class_name, property_name));
+        }
+      });
+}
+
+void PhasmidFingerprintTrace::MediaFeature(const String& feature,
+                                           const char* result) {
+  perfetto::DynamicCategory category(kCategory);
+  TRACE_EVENT_INSTANT(category, "CSS.mediaFeature",
+                      [&](perfetto::EventContext ctx) {
+                        ctx.AddDebugAnnotation("feature", feature.Utf8());
+                        ctx.AddDebugAnnotation("result", result);
+                      });
+}
+
+void PhasmidFingerprintTrace::FontLookup(const char* selector,
+                                         const AtomicString& family,
+                                         const AtomicString& resolved,
+                                         const char* result) {
+  perfetto::DynamicCategory category(kCategory);
+  TRACE_EVENT_INSTANT(category, "CSS.fontFamily",
+                      [&](perfetto::EventContext ctx) {
+                        ctx.AddDebugAnnotation("selector", selector);
+                        ctx.AddDebugAnnotation("family", family.Utf8());
+                        ctx.AddDebugAnnotation("resolved", resolved.Utf8());
+                        ctx.AddDebugAnnotation("result", result);
+                      });
+}
