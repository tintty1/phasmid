Phasmid: fingerprint inspector, Intl

What:     With the category disabled-by-default-phasmid.fingerprint in a
          tracing session, resolvedOptions() of Intl.DateTimeFormat,
          NumberFormat, Collator, PluralRules, RelativeTimeFormat and
          ListFormat emits an event with the resolved locale, calendar,
          numberingSystem, timeZone and other string fields, read with
          GetDataProperty so no getter or trap runs. Off, the cost is one
          relaxed atomic load per call.
Why:      Intl is a V8 builtin, not a Web API binding, so the bindings trace
          cannot see the locale and time zone probes that go through it.
Profile:  none
Hooks:    v8/src/builtins/builtins-intl.cc *PrototypeResolvedOptions
Contexts: main, iframe, worker, shared worker, service worker
Guard:    tests/guards/devtools/fingerprint-trace.py

--- a/v8/src/builtins/builtins-intl.cc
+++ b/v8/src/builtins/builtins-intl.cc
@@ -35,11 +35,39 @@
 #include "src/objects/option-utils.h"
 #include "src/objects/property-descriptor.h"
 #include "src/objects/smi.h"
+#include "src/tracing/trace-event.h"
 #include "unicode/brkiter.h"
 
 namespace v8 {
 namespace internal {
 
+namespace {
+
+// Phasmid fingerprint inspector: one event per resolvedOptions() call. Read
+// with GetDataProperty, so no getter or proxy trap can run.
+void PhasmidTraceResolvedOptions(Isolate* isolate, const char* api,
+                                 DirectHandle<JSObject> options) {
+#if defined(V8_USE_PERFETTO)
+  if (!TrackEvent::IsEnabled()) return;
+  perfetto::DynamicCategory category{"disabled-by-default-phasmid.fingerprint"};
+  if (!TRACE_EVENT_CATEGORY_ENABLED(category)) return;
+  TRACE_EVENT_INSTANT(
+      category, perfetto::StaticString(api), [&](perfetto::EventContext ctx) {
+        for (const char* key :
+             {"locale", "calendar", "numberingSystem", "timeZone", "hourCycle",
+              "collation", "usage", "sensitivity", "type", "style"}) {
+          DirectHandle<Object> value = JSReceiver::GetDataProperty(
+              isolate, options, isolate->factory()->InternalizeUtf8String(key));
+          if (IsString(*value)) {
+            ctx.AddDebugAnnotation(key, Cast<String>(*value)->ToStdString());
+          }
+        }
+      });
+#endif  // defined(V8_USE_PERFETTO)
+}
+
+}  // namespace
+
