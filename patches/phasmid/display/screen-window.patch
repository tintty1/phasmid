+    if (const phasmid::Profile* profile = phasmid::Profile::Get()) {
+      base::CommandLine* current = base::CommandLine::ForCurrentProcess();
+      const phasmid::Profile::Display& d = profile->display();
+      current->AppendSwitchASCII(::switches::kForceDeviceScaleFactor,
+                                 base::NumberToString(d.device_pixel_ratio));
+      // Headless mode was initialized before the profile loaded, with an
+      // 800x600 screen; --screen-info overrides it. The spec is in physical
+      // pixels, the profile in CSS pixels.
+      if (headless::IsHeadlessMode() &&
+          !current->HasSwitch(::switches::kScreenInfo)) {
+        const auto px = [&d](int css) {
+          return static_cast<int>(std::lround(css * d.device_pixel_ratio));
