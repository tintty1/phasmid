+// Phasmid: the nearest coordinate at or below `css` on a whole physical pixel.
+// At a fractional DPR an origin between pixels widens the viewport by a pixel
+// on each side. The reported screenX/screenY stay the profile's.
+int PixelAlignedOrigin(int css, double device_pixel_ratio) {
+  for (int candidate = css; candidate > css - 64 && candidate >= 0;
+       --candidate) {
+    const double px = candidate * device_pixel_ratio;
+    if (px == static_cast<double>(static_cast<int64_t>(px))) {
+      return candidate;
+    }
+  }
+  return 0;
+}
