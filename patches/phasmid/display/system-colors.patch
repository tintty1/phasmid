+// Phasmid: null when no profile is active, the used color scheme is not the
+// profile's, or the keyword is internal.
+const phasmid::Profile::SystemColor* PhasmidSystemColor(
+    CSSValueID css_value_id,
+    mojom::blink::ColorScheme color_scheme) {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile || profile->system_colors_dark() !=
+                      (color_scheme == mojom::blink::ColorScheme::kDark)) {
+    return nullptr;
+  }
+  return profile->system_color(GetCSSValueName(css_value_id));
+}
+
 }  // namespace
 
