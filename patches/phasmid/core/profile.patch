+// Required: without it the host's network quality estimate would reach
+// navigator.connection and the ECT, RTT and Downlink Client Hints.
+std::string ParseConnection(const base::DictValue& network,
+                            Profile::Connection* out) {
+  using EffectiveType = Profile::Connection::EffectiveType;
+  // kHttpRttEffectiveConnectionTypeThresholds of net::NetworkQualityEstimator.
+  struct Threshold {
+    const char* name;
+    EffectiveType type;
+    int min_rtt_ms;
+  };
+  static constexpr Threshold kThresholds[] = {
+      {"slow-2g", EffectiveType::kSlow2G, 2010},
+      {"2g", EffectiveType::k2G, 1420},
+      {"3g", EffectiveType::k3G, 272},
+      {"4g", EffectiveType::k4G, 0},
+  };
+  const base::DictValue* connection = network.FindDict("connection");
+  if (!connection) {
+    return Err("network.connection",
+               "is required: it replaces the host's network quality estimate");
+  }
+  std::string error;
+  std::optional<int> rtt =
+      RequireInt(*connection, "rtt", "network.connection.rtt", 0, &error);
+  if (!rtt) {
+    return error;
+  }
+  // Stock Chrome reports on a 50 kbps grid. Whole steps also keep the
+  // Downlink header (integer kbps) and the renderer's value (Mbps) on the same
+  // side of every rounding boundary.
+  std::optional<double> downlink = connection->FindDouble("downlink");
+  const double steps = downlink ? std::round(*downlink * 1000.0 / 50.0) : 0.0;
+  if (!downlink || !(*downlink > 0.0) || *downlink > 2000000.0 ||
+      std::abs(*downlink * 1000.0 - steps * 50.0) > 1e-6) {
+    return Err("network.connection.downlink",
+               "must be a number of Mbps in (0, 2000000], in steps of 0.05");
+  }
+  const std::string* effective_type = RequireString(
+      *connection, "effective_type", "network.connection.effective_type",
+      &error);
+  if (!effective_type) {
+    return error;
+  }
+  // The last threshold is 0 ms, so one always matches.
+  const Threshold* derived = nullptr;
+  for (const Threshold& threshold : kThresholds) {
+    if (*rtt >= threshold.min_rtt_ms) {
+      derived = &threshold;
+      break;
+    }
+  }
+  if (*effective_type != derived->name) {
+    return Err("network.connection.effective_type",
+               base::StringPrintf("is \"%s\", but the estimator reports \"%s\" "
+                                  "for an HTTP RTT of %d ms",
+                                  effective_type->c_str(), derived->name,
+                                  *rtt));
+  }
+  out->effective_type = derived->type;
+  out->rtt_ms = *rtt;
+  out->downlink_kbps = static_cast<int>(steps) * 50;
+  return std::string();
+}
+
+// The schema has no charging or discharging times: both OSes report Infinity
+// when the OS gives no estimate.
+std::string ParseBattery(const base::DictValue& capabilities,
+                         Profile::Capabilities* out) {
+  const base::DictValue* battery = capabilities.FindDict("battery");
+  if (!battery) {
+    return Err("capabilities.battery",
+               "is required: navigator.getBattery() reports it");
+  }
+  std::string error;
+  std::optional<bool> charging = RequireBool(
+      *battery, "charging", "capabilities.battery.charging", &error);
+  if (!charging) {
+    return error;
+  }
+  std::optional<double> level = battery->FindDouble("level");
+  const double percent = level ? std::round(*level * 100.0) : -1.0;
+  if (!level || percent < 0.0 || percent > 100.0 ||
+      std::abs(*level * 100.0 - percent) > 1e-6) {
+    return Err("capabilities.battery.level",
+               "must be a number in [0, 1] in steps of 0.01");
+  }
+  out->battery_charging = *charging;
+  out->battery_level = percent / 100.0;
+  return std::string();
+}
