+Profile::Profile() = default;
+Profile::~Profile() = default;
+
+std::string Profile::Init(base::DictValue dict) {
+  std::string error;
+  std::optional<int> schema_version = dict.FindInt("schema_version");
+  if (!schema_version || *schema_version != kSchemaVersion) {
+    return Err("schema_version", base::StringPrintf("must be %d", kSchemaVersion));
+  }
+  const std::string* id = dict.FindString("id");
+  if (!id || id->empty()) {
+    return Err("id", "is required");
+  }
+  const std::string* seed = dict.FindString("seed");
+  if (!seed || seed->size() != 32 ||
+      seed->find_first_not_of("0123456789abcdef") != std::string::npos) {
+    return Err("seed", "must be 32 lowercase hex characters");
+  }
+  for (const char* section : kRequiredSections) {
+    if (!dict.FindDict(section)) {
+      return Err(section, "is required and must be an object");
+    }
+  }
+
+  // Every os.* string is reported verbatim, so each enum is checked against
+  // the values stock Chrome can produce.
+  const base::DictValue* os = dict.FindDict("os");
+  const std::string* os_family = RequireString(*os, "family", "os.family", &error);
+  if (!os_family) {
+    return error;
+  }
+  if (!OneOf(*os_family, kOsFamilies)) {
+    return Err("os.family", "must be one of " + Listed(kOsFamilies));
+  }
+  const std::string* ua_platform_token =
+      RequireString(*os, "ua_platform_token", "os.ua_platform_token", &error);
+  if (!ua_platform_token) {
+    return error;
+  }
+  if (ua_platform_token->empty()) {
+    return Err("os.ua_platform_token", "must not be empty");
+  }
+  const std::string* navigator_platform =
+      RequireString(*os, "navigator_platform", "os.navigator_platform", &error);
+  if (!navigator_platform) {
+    return error;
+  }
+  if (!OneOf(*navigator_platform, kNavigatorPlatforms)) {
+    return Err("os.navigator_platform",
+               "must be one of " + Listed(kNavigatorPlatforms));
+  }
+  const std::string* ch_platform =
+      RequireString(*os, "ch_platform", "os.ch_platform", &error);
+  if (!ch_platform) {
+    return error;
+  }
+  if (!OneOf(*ch_platform, kChPlatforms)) {
+    return Err("os.ch_platform", "must be one of " + Listed(kChPlatforms));
+  }
+  const std::string* ch_platform_version = RequireString(
+      *os, "ch_platform_version", "os.ch_platform_version", &error);
+  if (!ch_platform_version) {
+    return error;
+  }
+  const std::string* architecture =
+      RequireString(*os, "architecture", "os.architecture", &error);
+  if (!architecture) {
+    return error;
+  }
+  if (!OneOf(*architecture, kArchitectures)) {
+    return Err("os.architecture", "must be one of " + Listed(kArchitectures));
+  }
+  const std::string* bitness = RequireString(*os, "bitness", "os.bitness", &error);
+  if (!bitness) {
+    return error;
+  }
+  if (!OneOf(*bitness, kBitnesses)) {
+    return Err("os.bitness", "must be one of " + Listed(kBitnesses));
+  }
+  std::optional<bool> wow64 = RequireBool(*os, "wow64", "os.wow64", &error);
+  if (!wow64) {
+    return error;
+  }
+  const std::string* model = RequireString(*os, "model", "os.model", &error);
+  if (!model) {
+    return error;
+  }
+  const base::ListValue* form_factors = os->FindList("form_factors");
+  if (!form_factors || form_factors->empty()) {
+    return Err("os.form_factors", "must be a non-empty list");
+  }
+  std::vector<std::string> form_factor_values;
+  for (const base::Value& entry : *form_factors) {
+    if (!entry.is_string() || !OneOf(entry.GetString(), kFormFactors)) {
+      return Err("os.form_factors",
+                 "entries must be one of " + Listed(kFormFactors));
+    }
+    form_factor_values.push_back(entry.GetString());
+  }
+
+  const base::DictValue* hardware = dict.FindDict("hardware");
+  std::optional<int> concurrency = hardware->FindInt("concurrency");
+  if (!concurrency || *concurrency < 1 || *concurrency > 256) {
+    return Err("hardware.concurrency", "must be an integer in [1, 256]");
+  }
+  std::optional<int> device_memory = hardware->FindInt("device_memory");
+  bool bucket_ok = false;
+  for (int bucket : kDeviceMemoryBuckets) {
+    bucket_ok |= device_memory && *device_memory == bucket;
+  }
+  if (!bucket_ok) {
+    return Err("hardware.device_memory", "must be one of 2, 4, 8, 16, 32");
+  }
+  std::optional<int> physical_memory_mb = hardware->FindInt("physical_memory_mb");
+  if (physical_memory_mb) {
+    if (*physical_memory_mb < 1024) {
+      return Err("hardware.physical_memory_mb", "must be at least 1024");
+    }
+    // Chrome rounds physical memory to the nearest power of two in GB and
+    // clamps it to [2, 32] on desktop (ApproximatedDeviceMemory).
+    int64_t lower = *physical_memory_mb;
+    int power = 0;
+    while (lower > 1) {
+      lower >>= 1;
+      power++;
+    }
+    int64_t upper = (lower + 1) << power;
+    lower <<= power;
+    int64_t nearest = (*physical_memory_mb - lower <= upper - *physical_memory_mb) ? lower : upper;
+    const int rounded_gb = static_cast<int>(std::clamp<int64_t>(nearest / 1024, 2, 32));
+    if (rounded_gb != *device_memory) {
+      return Err("hardware.physical_memory_mb",
+                 base::StringPrintf("rounds to %d GB but hardware.device_memory is %d",
+                                    rounded_gb, *device_memory));
+    }
+  }
+
+  // The available area must fit the screen and the window the available area.
+  const base::DictValue* display = dict.FindDict("display");
+  Display d;
+  struct IntField {
+    const char* key;
+    const char* field;
+    int minimum;
+    int* out;
+  };
+  const IntField display_ints[] = {
+      {"width", "display.width", 1, &d.width},
+      {"height", "display.height", 1, &d.height},
+      {"avail_left", "display.avail_left", 0, &d.avail_left},
+      {"avail_top", "display.avail_top", 0, &d.avail_top},
+      {"avail_width", "display.avail_width", 1, &d.avail_width},
+      {"avail_height", "display.avail_height", 1, &d.avail_height},
+  };
+  for (const IntField& f : display_ints) {
+    std::optional<int> v = RequireInt(*display, f.key, f.field, f.minimum, &error);
+    if (!v) {
+      return error;
+    }
+    *f.out = *v;
+  }
+  if (d.avail_left + d.avail_width > d.width ||
+      d.avail_top + d.avail_height > d.height) {
+    return Err("display.avail_*", "must lie inside display.width x height");
+  }
+  std::optional<int> color_depth = display->FindInt("color_depth");
+  bool depth_ok = false;
+  for (int depth : kColorDepths) {
+    depth_ok |= color_depth && *color_depth == depth;
+  }
+  if (!depth_ok) {
+    return Err("display.color_depth", "must be one of 24, 30");
+  }
+  d.color_depth = *color_depth;
+  std::optional<double> dpr = display->FindDouble("device_pixel_ratio");
+  if (!dpr || *dpr <= 0.0 || *dpr > 8.0) {
+    return Err("display.device_pixel_ratio", "must be a number in (0, 8]");
+  }
+  d.device_pixel_ratio = *dpr;
+  std::optional<bool> is_extended =
+      RequireBool(*display, "is_extended", "display.is_extended", &error);
+  if (!is_extended) {
+    return error;
+  }
+  d.is_extended = *is_extended;
+  const base::DictValue* orientation = display->FindDict("orientation");
+  if (!orientation) {
+    return Err("display.orientation", "is required and must be an object");
+  }
+  const std::string* orientation_type = RequireString(
+      *orientation, "type", "display.orientation.type", &error);
+  if (!orientation_type) {
+    return error;
+  }
+  if (!OneOf(*orientation_type, kOrientations)) {
+    return Err("display.orientation.type",
+               "must be one of " + Listed(kOrientations));
+  }
+  std::optional<int> orientation_angle = orientation->FindInt("angle");
+  if (!orientation_angle ||
+      (*orientation_angle != 0 && *orientation_angle != 90 &&
+       *orientation_angle != 180 && *orientation_angle != 270)) {
+    return Err("display.orientation.angle", "must be 0, 90, 180 or 270");
+  }
+  d.orientation_type = *orientation_type;
+  d.orientation_angle = *orientation_angle;
+  const base::DictValue* window = display->FindDict("window");
+  if (!window) {
+    return Err("display.window", "is required and must be an object");
+  }
+  const IntField window_ints[] = {
+      {"outer_width", "display.window.outer_width", 1, &d.outer_width},
+      {"outer_height", "display.window.outer_height", 1, &d.outer_height},
+      {"screen_x", "display.window.screen_x", 0, &d.screen_x},
+      {"screen_y", "display.window.screen_y", 0, &d.screen_y},
+  };
+  for (const IntField& f : window_ints) {
+    std::optional<int> v = RequireInt(*window, f.key, f.field, f.minimum, &error);
+    if (!v) {
+      return error;
+    }
+    *f.out = *v;
+  }
+  if (d.outer_width > d.width || d.outer_height > d.height) {
+    return Err("display.window.outer_*", "must fit inside display.width x height");
+  }
+  d.inner_width = window->FindInt("inner_width");
+  d.inner_height = window->FindInt("inner_height");
+  if ((d.inner_width && (*d.inner_width < 1 || *d.inner_width > d.outer_width)) ||
+      (d.inner_height &&
+       (*d.inner_height < 1 || *d.inner_height > d.outer_height))) {
+    return Err("display.window.inner_*", "must be positive and not exceed outer_*");
+  }
+
+  // gpu.gl_version is not read.
+  const base::DictValue* gpu = dict.FindDict("gpu");
+  Gpu gpu_identity;
+  WebGL webgl;
+  WebGL webgl2;
+  WebGPU webgpu;
+  error = ParseGpu(*gpu, &gpu_identity);
+  if (error.empty()) {
+    error = ParseWebGL(*gpu, "webgl", /*webgl2=*/false, &webgl);
+  }
+  if (error.empty()) {
+    error = DeriveGpuIdentity(*gpu, webgl, &gpu_identity);
+  }
+  if (error.empty()) {
+    error = ParseWebGL(*gpu, "webgl2", /*webgl2=*/true, &webgl2);
+  }
+  if (error.empty()) {
+    error = ParseWebGPU(*gpu, *os_family, &webgpu);
+  }
+  if (!error.empty()) {
+    return error;
+  }
+
+  // locale.*
+  const base::DictValue* locale = dict.FindDict("locale");
+  const base::ListValue* languages = locale->FindList("languages");
+  if (!languages || languages->empty()) {
+    return Err("locale.languages", "must be a non-empty list of language tags");
+  }
+  std::vector<std::string> language_values;
+  for (const base::Value& entry : *languages) {
+    if (!entry.is_string() || entry.GetString().empty() ||
+        entry.GetString().find_first_of(",; \"") != std::string::npos) {
+      return Err("locale.languages", "entries must be language tags such as en-US");
+    }
+    language_values.push_back(entry.GetString());
+  }
+  const std::string* intl_locale = locale->FindString("intl_locale");
+  if (intl_locale && intl_locale->empty()) {
+    return Err("locale.intl_locale", "must not be empty when present");
+  }
+  const std::string* timezone = locale->FindString("timezone");
+  if (!timezone || timezone->empty() || timezone->find('/') == std::string::npos) {
+    return Err("locale.timezone", "must be an IANA zone id such as Europe/Berlin");
+  }
+
+  // network.webrtc.*
+  const base::DictValue* network = dict.FindDict("network");
+  const base::DictValue* webrtc = network->FindDict("webrtc");
+  if (!webrtc) {
+    return Err("network.webrtc", "is required and must be an object");
+  }
+  const std::string* webrtc_policy = RequireString(
+      *webrtc, "ip_handling_policy", "network.webrtc.ip_handling_policy", &error);
+  if (!webrtc_policy) {
+    return error;
+  }
+  if (!OneOf(*webrtc_policy, kWebRtcPolicies)) {
+    return Err("network.webrtc.ip_handling_policy",
+               "must be one of " + Listed(kWebRtcPolicies));
+  }
+  const std::string* public_ip = webrtc->FindString("public_ip");
+  if (public_ip && !LooksLikeIpLiteral(*public_ip)) {
+    return Err("network.webrtc.public_ip", "must be an IPv4 or IPv6 literal");
+  }
+
+  // automation.*
+  const base::DictValue* automation = dict.FindDict("automation");
+  std::optional<bool> report_headful = RequireBool(
+      *automation, "report_headful", "automation.report_headful", &error);
+  if (!report_headful) {
+    return error;
+  }
+
+  // canvas.* and audio.*. Noise keys are derived from the seed once, here.
+  NoiseKey seed_key;
+  if (!NoiseKeyFromSeed(*seed, &seed_key)) {
+    return Err("seed", "must be 32 lowercase hex characters");
+  }
+  const base::DictValue* canvas = dict.FindDict("canvas");
+  std::optional<bool> canvas_noise =
+      RequireBool(*canvas, "noise", "canvas.noise", &error);
+  if (!canvas_noise) {
+    return error;
+  }
+  const base::DictValue* audio = dict.FindDict("audio");
+  std::optional<int> audio_sample_rate = audio->FindInt("sample_rate");
+  if (!audio_sample_rate ||
+      (*audio_sample_rate != 44100 && *audio_sample_rate != 48000 &&
+       *audio_sample_rate != 96000)) {
+    return Err("audio.sample_rate", "must be one of 44100, 48000, 96000");
+  }
+  // AudioContext.baseLatency is the output buffer in frames divided by the
+  // sample rate (audio_context.cc), so only whole buffers exist.
+  std::optional<double> base_latency = audio->FindDouble("base_latency");
+  if (!base_latency || !(*base_latency > 0.0)) {
+    return Err("audio.base_latency", "must be a positive number of seconds");
+  }
+  const double frames = *base_latency * *audio_sample_rate;
+  const double whole_frames = std::round(frames);
+  if (std::abs(frames - whole_frames) > 1e-9 || whole_frames < 128 ||
+      whole_frames > 8192) {
+    return Err("audio.base_latency",
+               base::StringPrintf("times audio.sample_rate is %.9g frames; it "
+                                  "must be a whole number in [128, 8192]",
+                                  frames));
+  }
+  const int frames_per_buffer = static_cast<int>(whole_frames);
+  // The default ("interactive") buffer is the platform's hardware buffer:
+  // 512 frames with PulseAudio, 2048 with ALSA only, and the 10 ms WASAPI
+  // engine period on Windows.
+  if (*os_family == "linux" && frames_per_buffer != 512 &&
+      frames_per_buffer != 2048) {
+    return Err("audio.base_latency",
+               base::StringPrintf("is %d frames; a linux profile has 512 "
+                                  "(PulseAudio) or 2048 (ALSA)",
+                                  frames_per_buffer));
+  }
+  if (*os_family == "windows" &&
+      frames_per_buffer != *audio_sample_rate / 100) {
+    return Err("audio.base_latency",
+               base::StringPrintf("is %d frames; a windows profile has the "
+                                  "10 ms WASAPI period, %d",
+                                  frames_per_buffer, *audio_sample_rate / 100));
+  }
+  std::optional<double> output_latency = audio->FindDouble("output_latency");
+  if (!output_latency || !(*output_latency >= 0.0) ||
+      !(*output_latency < 0.5)) {
+    return Err("audio.output_latency", "must be a number in [0, 0.5)");
+  }
+  std::optional<int> max_channel_count = audio->FindInt("max_channel_count");
+  if (!max_channel_count || *max_channel_count < 1 ||
+      *max_channel_count > 32) {
+    return Err("audio.max_channel_count", "must be an integer in [1, 32]");
+  }
+  std::optional<bool> audio_noise =
+      RequireBool(*audio, "noise", "audio.noise", &error);
+  if (!audio_noise) {
+    return error;
+  }
+
+  const base::DictValue* widevine =
+      dict.FindDict("media") ? dict.FindDict("media")->FindDict("widevine")
+                             : nullptr;
+  if (!widevine) {
+    return Err("media.widevine", "is required and must be an object");
+  }
+  std::optional<bool> widevine_supported = RequireBool(
+      *widevine, "supported", "media.widevine.supported", &error);
+  if (!widevine_supported) {
+    return error;
+  }
+  const base::ListValue* robustness = widevine->FindList("robustness");
+  if (!robustness) {
+    return Err("media.widevine.robustness", "is required and must be a list");
+  }
+  for (const base::Value& level : *robustness) {
+    if (!level.is_string() || !OneOf(level.GetString(), kWidevineRobustness)) {
+      return Err("media.widevine.robustness",
+                 "may only list " + Listed(kWidevineRobustness) +
+                     ": stock Chrome on Linux and Windows reports every "
+                     "HW_SECURE_* level unsupported for com.widevine.alpha "
+                     "(widevine_key_system_info.cc GetRobustnessConfigRule)");
+    }
+  }
+  if (!*widevine_supported && !robustness->empty()) {
+    return Err("media.widevine.robustness",
+               "must be empty when media.widevine.supported is false");
+  }
+  // Whether this host can back the claim is checked in
+  // LoadAndExportFromCommandLine.
+
+  // Required: the quota manager would otherwise size quota from the host's
+  // disk.
+  std::optional<double> disk_total_bytes =
+      hardware->FindDouble("disk_total_bytes");
+  if (!disk_total_bytes || !IsExactInteger(*disk_total_bytes) ||
+      *disk_total_bytes < 1073741824.0) {
+    return Err("hardware.disk_total_bytes",
+               "is required and must be an integer of at least 1073741824");
+  }
+
+  // V8 derives the heap limit from the physical memory it is given, so a
+  // stated limit must be the one V8 derives.
+  const int heap_physical_memory_mb =
+      physical_memory_mb ? *physical_memory_mb : *device_memory * 1024;
+  if (hardware->Find("js_heap_size_limit")) {
+    const int64_t v8_limit = V8HeapSizeLimit(heap_physical_memory_mb);
+    std::optional<double> js_heap_size_limit =
+        hardware->FindDouble("js_heap_size_limit");
+    if (!js_heap_size_limit ||
+        *js_heap_size_limit != static_cast<double>(v8_limit)) {
+      return Err("hardware.js_heap_size_limit",
+                 "must be " + base::NumberToString(v8_limit) +
+                     ", V8's heap limit for " +
+                     base::NumberToString(heap_physical_memory_mb) +
+                     " MB of physical memory (hardware.physical_memory_mb)");
+    }
+  }
+
+  std::vector<SpeechVoice> speech_voices;
+  error = ParseSpeechVoices(dict, &speech_voices);
+  if (!error.empty()) {
+    return error;
+  }
+
+  Profile::MediaFeatures media_features;
+  error = ParseMediaFeatures(*display, *hardware, *os_family, &media_features);
+  if (!error.empty()) {
+    return error;
+  }
+
+  HardwareDecode hardware_decode;
+  bool bluetooth_available = false;
+  Capabilities capabilities;
+  error = ParseCapabilities(dict, *os_family, &hardware_decode,
+                            &bluetooth_available, &capabilities);
+  if (!error.empty()) {
+    return error;
+  }
+
+  MediaDevices media_devices;
+  error = ParseMediaDevices(*dict.FindDict("media_devices"), *os_family,
+                            &media_devices);
+  if (!error.empty()) {
+    return error;
+  }
+
+  Connection connection;
+  error = ParseConnection(*network, &connection);
+  if (!error.empty()) {
+    return error;
+  }
+
+  error = ParseBattery(*dict.FindDict("capabilities"), &capabilities);
+  if (!error.empty()) {
+    return error;
+  }
+
+  base::flat_map<std::string, SystemColor> system_colors;
+  bool system_colors_dark = false;
+  error = ParseSystemColors(dict, &system_colors, &system_colors_dark);
+  if (!error.empty()) {
+    return error;
+  }
+
+  Profile::Fonts font_set;
+  error = ParseFonts(*dict.FindDict("fonts"), *os_family, &font_set);
+  if (!error.empty()) {
+    return error;
+  }
+
+  std::optional<Geolocation> geolocation;
+  error = ParseGeolocation(*locale, *timezone, seed_key, &geolocation);
+  if (!error.empty()) {
+    return error;
+  }
+
+  id_ = *id;
+  seed_ = *seed;
+  os_family_ = *os_family;
+  ua_platform_token_ = *ua_platform_token;
+  navigator_platform_ = *navigator_platform;
+  ch_platform_ = *ch_platform;
+  ch_platform_version_ = *ch_platform_version;
+  architecture_ = *architecture;
+  bitness_ = *bitness;
+  wow64_ = *wow64;
+  model_ = *model;
+  form_factors_ = std::move(form_factor_values);
+  hardware_concurrency_ = *concurrency;
+  device_memory_gb_ = *device_memory;
+  physical_memory_mb_ =
+      physical_memory_mb ? *physical_memory_mb : *device_memory * 1024;
+  display_ = d;
+  gpu_ = std::move(gpu_identity);
+  webgl_ = std::move(webgl);
+  webgl2_ = std::move(webgl2);
+  webgpu_ = std::move(webgpu);
+  languages_ = std::move(language_values);
+  intl_locale_ = intl_locale ? *intl_locale : languages_.front();
+  timezone_ = *timezone;
+  webrtc_ip_handling_policy_ = *webrtc_policy;
+  webrtc_public_ip_ = public_ip ? *public_ip : std::string();
+  report_headful_ = *report_headful;
+  if (*canvas_noise) {
+    canvas_noise_key_ = DeriveNoiseKey(seed_key, "phasmid/canvas/1");
+  }
+  if (*audio_noise) {
+    audio_noise_key_ = DeriveNoiseKey(seed_key, "phasmid/audio/1");
+  }
+  audio_sample_rate_ = *audio_sample_rate;
+  audio_frames_per_buffer_ = frames_per_buffer;
+  audio_output_latency_ = *output_latency;
+  audio_max_channel_count_ = *max_channel_count;
+  widevine_supported_ = *widevine_supported;
+  disk_total_bytes_ = static_cast<int64_t>(*disk_total_bytes);
+  speech_voices_ = std::move(speech_voices);
+  media_features_ = std::move(media_features);
+  hardware_decode_ = hardware_decode;
+  bluetooth_available_ = bluetooth_available;
+  media_devices_ = std::move(media_devices);
+  media_device_id_key_ = DeriveNoiseKey(seed_key, "phasmid/media-devices/1");
+  connection_ = connection;
+  connection_noise_key_ = DeriveNoiseKey(seed_key, "phasmid/connection/1");
+  system_colors_ = std::move(system_colors);
+  system_colors_dark_ = system_colors_dark;
+  fonts_ = std::move(font_set);
+  capabilities_ = capabilities;
+  geolocation_ = geolocation;
+  dict_ = std::move(dict);
+  return std::string();
+}
+
+// static
+std::string Profile::LoadAndExportFromCommandLine(
+    const base::CommandLine& command_line,
+    std::vector<std::string>* warnings) {
+  if (!command_line.HasSwitch(switches::kPhasmidProfile)) {
+    return std::string();
+  }
+  base::FilePath path = command_line.GetSwitchValuePath(switches::kPhasmidProfile);
+  // ReadFileToString rejects paths containing "..", so resolve them first.
+  base::FilePath absolute = base::MakeAbsoluteFilePath(path);
+  std::string contents;
+  if (absolute.empty() || !base::ReadFileToString(absolute, &contents)) {
+    return "cannot read profile file " + path.AsUTF8Unsafe();
+  }
+  auto parsed = base::JSONReader::ReadAndReturnValueWithError(contents, base::JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    return "profile is not valid JSON: " + parsed.error().message;
+  }
+  if (!parsed->is_dict()) {
+    return "profile must be a JSON object";
+  }
+  std::unique_ptr<Profile> profile(new Profile());
+  std::string error = profile->Init(std::move(*parsed).TakeDict());
+  if (!error.empty()) {
+    return error;
+  }
+  std::string refused = RefusedFingerprintingSwitch(command_line);
+  if (!refused.empty()) {
+    return refused +
+           " adds random per-call noise and cannot be combined with "
+           "--phasmid-profile";
+  }
+
+  // Canonical, compact JSON so every process parses identical bytes.
+  std::optional<std::string> canonical = base::WriteJson(profile->dict());
+  if (!canonical) {
+    return "cannot serialize profile";
+  }
+  std::unique_ptr<base::Environment> env = base::Environment::Create();
+  // Claims this host cannot back run with a warning. These checks run in the
+  // browser process only, so child processes neither repeat nor log them.
+  //
+  // Widevine is the installed CDM or absent: decryption cannot be faked. The
+  // Linux CDM names Linux in every license request, so a windows profile
+  // reports Widevine unsupported too.
+  base::FilePath absolute_cdm;
+  if (profile->widevine_supported() && profile->os_family() != "linux") {
+    warnings->push_back(
+        "media.widevine.supported: is true for os.family " +
+        profile->os_family() +
+        " but the only CDM this host can load is the Linux one, which names "
+        "Linux in every license request; Widevine is reported unsupported");
+  } else if (profile->widevine_supported()) {
+    base::FilePath cdm =
+        command_line.HasSwitch(switches::kPhasmidWidevineCdm)
+            ? command_line.GetSwitchValuePath(switches::kPhasmidWidevineCdm)
+            : base::FilePath(kDefaultWidevineCdmDirectory);
+    absolute_cdm = base::MakeAbsoluteFilePath(cdm);
+    if (absolute_cdm.empty() ||
+        !base::PathExists(absolute_cdm.Append("manifest.json")) ||
+        !base::PathExists(absolute_cdm.Append("_platform_specific")
+                              .Append("linux_x64")
+                              .Append("libwidevinecdm.so"))) {
+      absolute_cdm.clear();
+      warnings->push_back(
+          "media.widevine.supported: is true but " + cdm.AsUTF8Unsafe() +
+          " holds no Widevine CDM (install Google Chrome or pass "
+          "--phasmid-widevine-cdm=<its WidevineCdm directory>); Widevine is "
+          "reported unsupported");
+    }
+  }
+  if (!absolute_cdm.empty()) {
+    if (!env->SetVar(kWidevineCdmEnvVar, absolute_cdm.value())) {
+      return "cannot export the Widevine CDM directory to the environment";
+    }
+  } else {
+    env->UnSetVar(kWidevineCdmEnvVar);
+  }
+  // The CSS system font keywords are Arial at the default font size, whatever
+  // a windows profile claims.
+  const base::DictValue* ui_font =
+      profile->dict().FindDict("fonts")->FindDict("ui_font");
+  const std::string* ui_family = ui_font->FindString("family");
+  const double ui_size = ui_font->FindDouble("size_px").value_or(0);
+  if (*ui_family != "Arial" || ui_size != 16.0) {
+    warnings->push_back(base::StringPrintf(
+        "fonts.ui_font: is %s at %g px but this build reports the CSS system "
+        "font keywords as Arial at 16 px",
+        ui_family->c_str(), ui_size));
+  }
+  warnings->insert(warnings->end(), profile->gpu().missing.begin(),
+                   profile->gpu().missing.end());
+  AppendUnbackedCapabilityWarnings(*profile, warnings);
+  // Without a claimed position the build's own network provider runs, and it
+  // cannot reach Google's location service.
+  if (!profile->geolocation()) {
+    warnings->push_back(
+        "locale.geolocation: no position claimed; a granted page gets "
+        "POSITION_UNAVAILABLE as an ungoogled build does");
+  }
+  if (!env->SetVar(kProfileEnvVar, *canonical)) {
+    return "cannot export profile to the environment";
+  }
+  // ICU and libc read TZ at process start in every child, so the host zone is
+  // never observed. TimeZoneMonitorLinux does not watch /etc/localtime when
+  // TZ is set.
+  if (!env->SetVar("TZ", profile->timezone())) {
+    return "cannot export TZ to the environment";
+  }
+  ProcessProfileSlot() = std::move(profile);
+  return std::string();
+}
+
+// static
+const Profile* Profile::Get() {
+  // The browser process fills the slot on the main thread before any other
+  // thread exists. A call before that sees null, and nothing is cached.
+  if (const Profile* loaded = ProcessProfileSlot().get()) {
+    return loaded;
+  }
+  // Every other process parses the exported JSON once.
+  static const base::NoDestructor<std::unique_ptr<Profile>> from_environment(
+      []() -> std::unique_ptr<Profile> {
+        std::unique_ptr<base::Environment> env = base::Environment::Create();
+        std::optional<std::string> json = env->GetVar(kProfileEnvVar);
+        if (!json || json->empty()) {
+          return nullptr;
+        }
+        std::optional<base::Value> value =
+            base::JSONReader::Read(*json, base::JSON_PARSE_RFC);
+        if (!value || !value->is_dict()) {
+          LOG(FATAL) << "Phasmid: " << kProfileEnvVar
+                     << " is not valid JSON in this process";
+        }
+        std::unique_ptr<Profile> parsed(new Profile());
+        std::string error = parsed->Init(std::move(*value).TakeDict());
+        if (!error.empty()) {
+          LOG(FATAL) << "Phasmid: exported profile failed validation: "
+                     << error;
+        }
+        return parsed;
+      }());
+  return from_environment->get();
+}
+
+double Profile::ConnectionNoiseMultiplier(std::string_view host) const {
+  // Stock: 0.9 + ((hash(host) + salt) % 21) * 0.01, in both
+  // NetworkStateNotifier::GetRandomMultiplier and client_hints.cc.
+  const uint64_t hash =
+      SipHash24(connection_noise_key_, base::as_byte_span(host));
+  return 0.9 + static_cast<double>(hash % 21) * 0.01;
+}
+
+base::FilePath WidevineCdmDirectory() {
+  const Profile* profile = Profile::Get();
+  if (!profile || !profile->widevine_supported()) {
+    return base::FilePath();
+  }
+  std::optional<std::string> directory =
+      base::Environment::Create()->GetVar(kWidevineCdmEnvVar);
+  return directory ? base::FilePath(*directory) : base::FilePath();
+}
+
+void ReportUnbackedGpuClaim(std::string_view field, std::string_view detail) {
+  // Each process keeps its own record: the GPU process reports limits and
+  // WebGPU claims, every renderer its extension claims.
+  static base::NoDestructor<base::Lock> lock;
+  static base::NoDestructor<std::set<std::string, std::less<>>> reported;
+  {
+    base::AutoLock auto_lock(*lock);
+    if (!reported->emplace(field).second) {
+      return;
+    }
+  }
+  LOG(ERROR) << "Phasmid: host cannot back gpu." << field << ": " << detail;
+}
+
+bool ClaimsWindows() {
+  const Profile* profile = Profile::Get();
+  return profile && profile->os_family() == "windows";
+}
+
+bool FontFamilyResolvable(std::string_view family) {
+  if (family.empty() || !ClaimsWindows()) {
+    return true;
+  }
+  for (const std::string& listed : Profile::Get()->fonts().families) {
+    if (base::EqualsCaseInsensitiveASCII(listed, family)) {
+      return true;
+    }
+  }
+  return false;
+}
