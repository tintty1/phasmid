+std::string Err(const char* field, const std::string& what) {
+  return base::StringPrintf("profile field '%s' %s", field, what.c_str());
+}
+
+std::string Err(const std::string& field, const std::string& what) {
+  return Err(field.c_str(), what);
+}
+
+template <size_t N>
+bool OneOf(const std::string& value, const char* const (&allowed)[N]) {
+  for (const char* candidate : allowed) {
+    if (value == candidate) {
+      return true;
+    }
+  }
+  return false;
+}
+
+template <size_t N>
+std::string Listed(const char* const (&allowed)[N]) {
+  std::string out;
+  for (const char* candidate : allowed) {
+    if (!out.empty()) {
+      out += ", ";
+    }
+    out += candidate;
+  }
+  return out;
+}
+
+const std::string* RequireString(const base::DictValue& dict,
+                                 const char* key,
+                                 const char* field,
+                                 std::string* error) {
+  const std::string* value = dict.FindString(key);
+  if (!value) {
+    *error = Err(field, "is required and must be a string");
+  }
+  return value;
+}
+
+std::optional<bool> RequireBool(const base::DictValue& dict,
+                                const char* key,
+                                const char* field,
+                                std::string* error) {
+  std::optional<bool> value = dict.FindBool(key);
+  if (!value) {
+    *error = Err(field, "is required and must be a boolean");
+  }
+  return value;
+}
