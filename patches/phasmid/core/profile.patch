+#ifndef COMPONENTS_PHASMID_FONT_ALLOWLIST_LINUX_H_
+#define COMPONENTS_PHASMID_FONT_ALLOWLIST_LINUX_H_
+
+#include <string>
+#include <vector>
+
+namespace phasmid {
+
+// Makes only the font files that publish a family in fonts.families
+// reachable, in every process: on Linux every font lookup ends in
+// fontconfig.
+//
+// Browser process, before any child process exists. Writes a fontconfig
+// configuration that includes the host's own and rejects every other font
+// file, exports it as FONTCONFIG_FILE and makes it this process's current
+// configuration. A windows profile with a Windows font store instead gets a
+// standalone configuration over the store, and the browser's global
+// SkFontConfigInterface matches the store's families as DirectWrite names
+// them. Returns an error naming the profile field when the filter cannot be
+// put in place, or an empty string. Claims the fonts cannot back are
+// appended to `warnings` as "<field>: <detail>". Does nothing when Phasmid
+// is not active.
+std::string ExportFontAllowlist(std::vector<std::string>* warnings);
+
+}  // namespace phasmid
+
+#endif  // COMPONENTS_PHASMID_FONT_ALLOWLIST_LINUX_H_
