+// One device profile (profiles/schema.json). The browser process loads and
+// validates --phasmid-profile and exports it as canonical JSON in
+// PHASMID_PROFILE, which every child process inherits and parses once.
+//
+// Get() returns null when Phasmid is not active; callers then leave
+// Chromium's own value untouched.
+class COMPONENT_EXPORT(PHASMID) Profile {
+ public:
+  // Sizes are CSS pixels.
+  struct Display {
+    int width = 0;
+    int height = 0;
+    int avail_left = 0;
+    int avail_top = 0;
+    int avail_width = 0;
+    int avail_height = 0;
+    int color_depth = 0;
+    double device_pixel_ratio = 1.0;
+    bool is_extended = false;
+    std::string orientation_type;
+    int orientation_angle = 0;
+    // The default top-level window.
+    int outer_width = 0;
+    int outer_height = 0;
+    int screen_x = 0;
+    int screen_y = 0;
+    std::optional<int> inner_width;
+    std::optional<int> inner_height;
+  };
+
+  // The GPU identity chrome://gpu, CDP SystemInfo and WebGL creation errors
+  // report. Reporting only: the host GPU still drives blocklists,
+  // workarounds, ANGLE and Dawn.
+  struct Gpu {
+    uint32_t vendor_id = 0;
+    uint32_t device_id = 0;
+    // GPUInfo::GPUDevice vendor_string and device_string.
+    std::string vendor_name;
+    std::string device_name;
+    std::string driver_vendor;
+    std::string driver_version;
+    std::string gl_vendor;
+    std::string gl_renderer;
+    std::string angle_backend;
+    // The fields above that the profile leaves out and the WebGL claim does
+    // not determine, as "gpu.<field>: <detail>". They are empty or 0.
+    std::vector<std::string> missing;
+  };
+
+  struct WebGL {
+    // getShaderPrecisionFormat() for one (shader, precision) pair.
+    struct Precision {
+      int range_min = 0;
+      int range_max = 0;
+      int precision = 0;
+    };
+
+    std::string unmasked_vendor;
+    std::string unmasked_renderer;
+    base::flat_set<std::string> extensions;
+    // Keyed by GL constant name. Doubles: MAX_ELEMENT_INDEX does not fit an
+    // int.
+    base::flat_map<std::string, std::vector<double>> params;
+    // [0] vertex, [1] fragment shader; then LOW_FLOAT, MEDIUM_FLOAT,
+    // HIGH_FLOAT, LOW_INT, MEDIUM_INT, HIGH_INT (the GL enum order).
+    std::array<std::array<Precision, 6>, 2> precision;
+    // Unset when EXT_texture_filter_anisotropic is not exposed.
+    std::optional<double> max_anisotropy;
+    // Unset when WEBGL_draw_buffers is not exposed.
+    std::optional<int> max_draw_buffers;
+    bool antialias = false;
+
+    bool HasExtension(std::string_view name) const {
+      return extensions.contains(name);
+    }
+    // params[name][index], or nullopt when the profile has no such value.
+    std::optional<double> Param(std::string_view name, size_t index = 0) const {
+      auto it = params.find(name);
+      if (it == params.end() || index >= it->second.size()) {
+        return std::nullopt;
+      }
+      return it->second[index];
+    }
+  };
+
+  struct WebGPU {
+    // Whether requestAdapter() resolves to an adapter. When false, the other
+    // fields are empty, except preferred_canvas_format.
+    bool available = false;
+    // GPUAdapterInfo.
+    std::string vendor;
+    std::string architecture;
+    std::string device;
+    std::string description;
+    uint32_t subgroup_min_size = 0;
+    uint32_t subgroup_max_size = 0;
+    base::flat_set<std::string> features;
+    base::flat_map<std::string, uint64_t> limits;
+    std::string preferred_canvas_format;
+
+    std::optional<uint64_t> Limit(std::string_view name) const {
+      auto it = limits.find(name);
+      if (it == limits.end()) {
+        return std::nullopt;
+      }
+      return it->second;
+    }
+  };
+
+  // One voice of speechSynthesis.getVoices(). Its voiceURI is its name; the
+  // first is the default.
+  struct SpeechVoice {
+    std::string name;
+    std::string lang;
+    // A local voice is listed as local but, like the network voices, never
+    // synthesized by the host.
+    bool local_service = false;
+  };
+
+  struct MediaFeatures {
+    std::string primary_pointer;
+    bool primary_hover = false;
+    bool any_pointer_fine = false;
+    bool any_pointer_coarse = false;
+    bool any_hover = false;
+    int max_touch_points = 0;
+    std::string color_gamut;
+    bool high_dynamic_range = false;
+    bool prefers_dark = false;
+    bool prefers_reduced_motion = false;
+    std::string prefers_contrast;
+    bool forced_colors = false;
+  };
+
+  // Which codecs the GPU decodes.
+  struct HardwareDecode {
+    bool h264 = false;
+    bool hevc = false;
+    bool vp9 = false;
+    bool av1 = false;
+  };
+
+  // Device labels in OS order. The virtual default devices are not listed.
+  struct MediaDevices {
+    std::vector<std::string> audio_inputs;
+    std::vector<std::string> audio_outputs;
+    std::vector<std::string> video_inputs;
+  };
+
+  // The network quality estimate, before stock Chrome's per-host noise and
+  // rounding.
+  struct Connection {
+    // In net::EffectiveConnectionType order.
+    enum class EffectiveType { kSlow2G, k2G, k3G, k4G };
+
+    EffectiveType effective_type = EffectiveType::k4G;
+    int rtt_ms = 0;
+    // A multiple of 50.
+    int downlink_kbps = 0;
+  };
+
+  // A CSS system color with 8-bit channels, as Blink stores it.
+  struct SystemColor {
+    uint8_t red = 0;
+    uint8_t green = 0;
+    uint8_t blue = 0;
+    uint8_t alpha = 255;
+
+    // 0xAARRGGBB, the layout of SkColor and blink::Color::FromRGBA32.
+    uint32_t argb() const {
+      return static_cast<uint32_t>(alpha) << 24 |
+             static_cast<uint32_t>(red) << 16 |
+             static_cast<uint32_t>(green) << 8 | static_cast<uint32_t>(blue);
+    }
+  };
+
+  // Family names are compared ignoring ASCII case, as fontconfig and Skia
+  // match them.
+  struct Fonts {
+    // The installed families. Only font files that publish one of them are
+    // reachable.
+    std::vector<std::string> families;
+    // Empty when the profile keeps Chrome's defaults.
+    std::string default_sans;
+    std::string default_serif;
+    std::string default_monospace;
+    std::string emoji;
+  };
+
+  struct Capabilities {
+    bool user_verifying_platform_authenticator = false;
+    // navigator.bluetooth and navigator.share exist.
+    bool web_bluetooth = false;
+    bool web_share = false;
+    bool battery_charging = true;
+    double battery_level = 1.0;
+  };
+
+  struct Geolocation {
+    double latitude = 0.0;
+    double longitude = 0.0;
+    double accuracy_m = 0.0;
+    // How long after the provider starts, or permission arrives, the first
+    // fix is delivered: 200 to 300 ms, drawn once from the seed.
+    int fix_delay_ms = 0;
+  };
+
+  Profile(const Profile&) = delete;
+  Profile& operator=(const Profile&) = delete;
+  ~Profile();
+
+  // Browser process. Reads the file named by --phasmid-profile, validates it
+  // and exports it. Returns an error message, or an empty string on success
+  // or when the switch is absent. A valid claim this host cannot back is not
+  // an error: it is appended to `warnings` as "<field>: <detail>".
+  static std::string LoadAndExportFromCommandLine(
+      const base::CommandLine& command_line,
+      std::vector<std::string>* warnings);
+
+  // Any process. The active profile, or nullptr when Phasmid is not active.
+  static const Profile* Get();
+
+  // Every accessor reads a validated field, so none can fail at call time.
+  const std::string& id() const { return id_; }
+  const std::string& seed() const { return seed_; }
+
+  // "windows" or "linux".
+  const std::string& os_family() const { return os_family_; }
+  // The parenthesised platform of the reduced UA, e.g. "X11; Linux x86_64".
+  const std::string& ua_platform_token() const { return ua_platform_token_; }
+  const std::string& navigator_platform() const { return navigator_platform_; }
+  const std::string& ch_platform() const { return ch_platform_; }
+  // May be empty.
+  const std::string& ch_platform_version() const {
+    return ch_platform_version_;
+  }
+  const std::string& architecture() const { return architecture_; }
+  const std::string& bitness() const { return bitness_; }
+  bool wow64() const { return wow64_; }
+  // Empty on desktop.
+  const std::string& model() const { return model_; }
+  const std::vector<std::string>& form_factors() const { return form_factors_; }
+
+  int hardware_concurrency() const { return hardware_concurrency_; }
+  // In GB.
+  int device_memory_gb() const { return device_memory_gb_; }
+  // hardware.physical_memory_mb when present, else device_memory_gb * 1024.
+  int physical_memory_mb() const { return physical_memory_mb_; }
+
+  const Display& display() const { return display_; }
+
+  // gpu.gl_version is not exposed: its ANGLE hash belongs to the build.
+  const Gpu& gpu() const { return gpu_; }
+  const WebGL& webgl(bool webgl2) const { return webgl2 ? webgl2_ : webgl_; }
+  // wgsl_language_features is not exposed: it belongs to the build's WGSL
+  // compiler, not to the device.
+  const WebGPU& webgpu() const { return webgpu_; }
+
+  // In navigator.languages order.
+  const std::vector<std::string>& languages() const { return languages_; }
+  // locale.intl_locale when present, else languages[0].
+  const std::string& intl_locale() const { return intl_locale_; }
+  // IANA id. Also exported as TZ for every process.
+  const std::string& timezone() const { return timezone_; }
+
+  // Chrome's own WebRTC IP handling policy name.
+  const std::string& webrtc_ip_handling_policy() const {
+    return webrtc_ip_handling_policy_;
+  }
+  // Empty when the profile does not claim one.
+  const std::string& webrtc_public_ip() const { return webrtc_public_ip_; }
+
+  bool report_headful() const { return report_headful_; }
+
+  // The keys of the deterministic perturbations, or nullopt when the profile
+  // turns them off.
+  const std::optional<NoiseKey>& canvas_noise_key() const {
+    return canvas_noise_key_;
+  }
+  const std::optional<NoiseKey>& audio_noise_key() const {
+    return audio_noise_key_;
+  }
+  // The default output device as Web Audio reports it.
+  int audio_sample_rate() const { return audio_sample_rate_; }
+  // audio.base_latency * audio.sample_rate.
+  int audio_frames_per_buffer() const { return audio_frames_per_buffer_; }
+  // In seconds.
+  double audio_output_latency() const { return audio_output_latency_; }
+  int audio_max_channel_count() const { return audio_max_channel_count_; }
+
+  // The claim; whether a CDM backs it is WidevineCdmDirectory().
+  bool widevine_supported() const { return widevine_supported_; }
+
+  // The size of the volume holding the browser profile, as the quota manager
+  // sees it. hardware.js_heap_size_limit has no accessor: V8 derives it from
+  // physical_memory_mb().
+  int64_t disk_total_bytes() const { return disk_total_bytes_; }
+
+  // In getVoices() order.
+  const std::vector<SpeechVoice>& speech_voices() const {
+    return speech_voices_;
+  }
+
+  const MediaFeatures& media_features() const { return media_features_; }
+
+  const HardwareDecode& hardware_decode() const { return hardware_decode_; }
+  // Whether the device has a Bluetooth adapter; false when absent.
+  bool bluetooth_available() const { return bluetooth_available_; }
+
+  const MediaDevices& media_devices() const { return media_devices_; }
+  // Media device ID salts are derived from this key per storage key, in
+  // place of Chrome's stored random salt, so device IDs are stable per
+  // profile and origin.
+  const NoiseKey& media_device_id_key() const { return media_device_id_key_; }
+
+  const Connection& connection() const { return connection_; }
+  // The factor, 0.90 to 1.10 in steps of 0.01, by which stock Chrome scales
+  // the RTT and downlink it reports for `host`. Stock adds a random salt per
+  // process; this keys it on the seed, so every process, header and restart
+  // agrees.
+  double ConnectionNoiseMultiplier(std::string_view host) const;
+
+
+  // The set for display.prefers_color_scheme, keyed by the lowercase keyword
+  // as GetCSSValueName() spells it ("canvastext"). Other names return
+  // nullptr.
+  const SystemColor* system_color(std::string_view keyword) const {
+    auto it = system_colors_.find(keyword);
+    return it == system_colors_.end() ? nullptr : &it->second;
+  }
+  // Whether that set is the dark one.
+  bool system_colors_dark() const { return system_colors_dark_; }
+
+  // fonts.ui_font has no accessor: the CSS system font keywords are Chrome's
+  // own (Arial at the default size).
+  const Fonts& fonts() const { return fonts_; }
+
+  // media.*, webauthn.* and capabilities.* beyond hardware_decode() and
+  // bluetooth_available().
+  const Capabilities& capabilities() const { return capabilities_; }
+
+  // nullopt when the profile claims no position.
+  const std::optional<Geolocation>& geolocation() const {
+    return geolocation_;
+  }
+
+  // The whole document. Prefer adding an accessor: it is validated once.
+  const base::DictValue& dict() const { return dict_; }
+
+ private:
+  Profile();
+
+  // Returns an error message, or empty on success.
+  std::string Init(base::DictValue dict);
+
+  base::DictValue dict_;
+  std::string id_;
+  std::string seed_;
+  std::string os_family_;
+  std::string ua_platform_token_;
+  std::string navigator_platform_;
+  std::string ch_platform_;
+  std::string ch_platform_version_;
+  std::string architecture_;
+  std::string bitness_;
+  bool wow64_ = false;
+  std::string model_;
+  std::vector<std::string> form_factors_;
+  int hardware_concurrency_ = 0;
+  int device_memory_gb_ = 0;
+  int physical_memory_mb_ = 0;
+  Display display_;
+  Gpu gpu_;
+  WebGL webgl_;
+  WebGL webgl2_;
+  WebGPU webgpu_;
+  std::vector<std::string> languages_;
+  std::string intl_locale_;
+  std::string timezone_;
+  std::string webrtc_ip_handling_policy_;
+  std::string webrtc_public_ip_;
+  bool report_headful_ = false;
+  std::optional<NoiseKey> canvas_noise_key_;
+  std::optional<NoiseKey> audio_noise_key_;
+  int audio_sample_rate_ = 0;
+  int audio_frames_per_buffer_ = 0;
+  double audio_output_latency_ = 0.0;
+  int audio_max_channel_count_ = 0;
+  bool widevine_supported_ = false;
+  int64_t disk_total_bytes_ = 0;
+  std::vector<SpeechVoice> speech_voices_;
+  MediaFeatures media_features_;
+  HardwareDecode hardware_decode_;
+  bool bluetooth_available_ = false;
+  MediaDevices media_devices_;
+  NoiseKey media_device_id_key_;
+  Connection connection_;
+  NoiseKey connection_noise_key_;
+  base::flat_map<std::string, SystemColor> system_colors_;
+  bool system_colors_dark_ = false;
+  Fonts fonts_;
+  Capabilities capabilities_;
+  std::optional<Geolocation> geolocation_;
+};
+
+// The Widevine CDM directory the browser process validated and exported, or
+// an empty path when Phasmid is not active, the profile says Widevine is
+// absent or the host could not back the claim.
+COMPONENT_EXPORT(PHASMID) base::FilePath WidevineCdmDirectory();
+
+// Reports a gpu.* claim this host cannot back, such as a WebGL limit above
+// the host's. `field` is the path below gpu., e.g.
+// "webgl2.params.MAX_TEXTURE_SIZE". Logs once per field and process; the
+// claimed value stays in place.
+COMPONENT_EXPORT(PHASMID)
+void ReportUnbackedGpuClaim(std::string_view field, std::string_view detail);
+
+// Whether the active profile claims os.family windows. False when Phasmid is
+// not active, and in the browser process before the profile is loaded.
+COMPONENT_EXPORT(PHASMID) bool ClaimsWindows();
+
+// Whether the browser's family matchers may resolve `family`. A windows
+// profile resolves only the families it lists and the empty name, as
+// DirectWrite resolves only installed families. Always true otherwise.
+COMPONENT_EXPORT(PHASMID) bool FontFamilyResolvable(std::string_view family);
+
+}  // namespace phasmid
