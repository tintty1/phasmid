+// One warning per claim the host cannot back. The claim is still reported;
+// what fails is the use behind it.
+void AppendUnbackedCapabilityWarnings(const Profile& profile,
+                                      std::vector<std::string>* warnings) {
+  const Profile::HardwareDecode& decode = profile.hardware_decode();
+  std::vector<std::string> codecs;
+  for (const auto& [name, claimed] :
+       {std::pair<const char*, bool>{"h264", decode.h264},
+        std::pair<const char*, bool>{"hevc", decode.hevc},
+        std::pair<const char*, bool>{"vp9", decode.vp9},
+        std::pair<const char*, bool>{"av1", decode.av1}}) {
+    if (claimed) {
+      codecs.push_back(name);
+    }
+  }
+  if (!codecs.empty()) {
+    warnings->push_back(
+        "gpu.hardware_decode: claims " + base::JoinString(codecs, ", ") +
+        "; decodingInfo() reports them decoded in hardware, but video "
+        "decodes with this host's VA-API driver where it has one, else in "
+        "software");
+  }
+  if (decode.hevc) {
+    warnings->push_back(
+        "media.hevc: is true; canPlayType(), isTypeSupported() and "
+        "decodingInfo() report HEVC, but this build decodes HEVC only "
+        "through the host's VA-API driver, so HEVC playback fails without "
+        "one");
+  }
+  const base::DictValue& media = *profile.dict().FindDict("media");
+  if (media.FindBool("playready").value_or(false)) {
+    warnings->push_back(
+        "media.playready: is true but this build has no PlayReady key "
+        "system; requestMediaKeySystemAccess() reports it unsupported");
+  }
+  const Profile::Capabilities& capabilities = profile.capabilities();
+  if (capabilities.user_verifying_platform_authenticator) {
+    warnings->push_back(
+        "webauthn.user_verifying_platform_authenticator: is true but this "
+        "host has no platform authenticator and this build no passkey "
+        "store; it is reported available and a passkey ceremony finds no "
+        "passkey");
+  }
+  if (profile.bluetooth_available()) {
+    warnings->push_back(
+        "capabilities.bluetooth_available: is true; hybridTransport and "
+        "navigator.bluetooth.getAvailability() report an adapter, but a "
+        "phone passkey or requestDevice() needs this host's BlueZ adapter");
+  }
+  if (capabilities.web_share) {
+    warnings->push_back(
+        "capabilities.web_share: is true but this host has no share target; "
+        "navigator.share() ends with AbortError as if the share sheet were "
+        "dismissed");
+  }
+  size_t local = 0;
+  std::string first_local;
+  for (const Profile::SpeechVoice& voice : profile.speech_voices()) {
+    if (voice.local_service) {
+      if (local++ == 0) {
+        first_local = voice.name;
+      }
+    }
+  }
+  if (local) {
+    warnings->push_back(base::StringPrintf(
+        "speech.voices: %zu voices have local_service true (%s first); they "
+        "are listed as local, but this build has no engine for them, so "
+        "speak() with one gets no event until cancel()",
+        local, first_local.c_str()));
+  }
+}
+
+// Optional. A claimed position is not (0, 0), the point an unset position
+// reads as, and its zone is not an Etc/ zone. The first-fix delay is drawn
+// from the seed in 200 to 300 ms, the latency of stock Chrome's network
+// provider.
+std::string ParseGeolocation(const base::DictValue& locale,
+                             const std::string& timezone,
+                             const NoiseKey& seed_key,
+                             std::optional<Profile::Geolocation>* out) {
+  const base::Value* value = locale.Find("geolocation");
+  if (!value) {
+    return std::string();
+  }
+  const base::DictValue* geolocation = value->GetIfDict();
+  if (!geolocation) {
+    return Err("locale.geolocation", "must be an object");
+  }
+  for (const auto [key, unused] : *geolocation) {
+    if (key != "latitude" && key != "longitude" && key != "accuracy") {
+      return Err("locale.geolocation." + key,
+                 "is not a field; only latitude, longitude and accuracy are");
+    }
+  }
+  std::optional<double> latitude = geolocation->FindDouble("latitude");
+  if (!latitude || !std::isfinite(*latitude) || *latitude < -90.0 ||
+      *latitude > 90.0) {
+    return Err("locale.geolocation.latitude",
+               "is required and must be a number in [-90, 90]");
+  }
+  std::optional<double> longitude = geolocation->FindDouble("longitude");
+  if (!longitude || !std::isfinite(*longitude) || *longitude < -180.0 ||
+      *longitude > 180.0) {
+    return Err("locale.geolocation.longitude",
+               "is required and must be a number in [-180, 180]");
+  }
+  if (*latitude == 0.0 && *longitude == 0.0) {
+    return Err("locale.geolocation",
+               "is (0, 0), which is no place a device reports");
+  }
+  std::optional<double> accuracy = geolocation->FindDouble("accuracy");
+  if (!accuracy || !std::isfinite(*accuracy) || *accuracy < 10.0 ||
+      *accuracy > 100000.0) {
+    return Err("locale.geolocation.accuracy",
+               "is required and must be a number of metres in [10, 100000]");
+  }
+  if (base::StartsWith(timezone, "Etc/")) {
+    return Err("locale.timezone",
+               "must be the zone of the claimed position, not " + timezone +
+                   ", when locale.geolocation is present");
+  }
+  Profile::Geolocation parsed;
+  parsed.latitude = *latitude;
+  parsed.longitude = *longitude;
+  parsed.accuracy_m = *accuracy;
+  parsed.fix_delay_ms =
+      200 + static_cast<int>(
+                DeriveNoiseKey(seed_key, "phasmid/geolocation/1").k0 % 101);
+  *out = parsed;
+  return std::string();
+}
+
+// angle::GetVendorString inverted, for the vendors whose PCI id fits the
+// schema's 16 bits. DXGI reports Qualcomm as 0x4D4F4351.
+std::optional<uint32_t> AngleVendorId(std::string_view vendor, bool dxgi) {
+  static constexpr std::pair<std::string_view, uint32_t> kVendors[] = {
+      {"AMD", 0x1002},
+      {"Apple", 0x106b},
+      {"ARM", 0x13b5},
+      {"Broadcom", 0x14e4},
+      {"Google", 0x1ae0},
+      {"Intel", 0x8086},
+      {"Microsoft", 0x1414},
+      {"NVIDIA", 0x10de},
+      {"Imagination Technologies", 0x1010},
+      {"Samsung Electronics Co. Ltd.", 0x144d},
+      {"Vivante", 0x9999},
+      {"VMware", 0x15ad},
+      {"VirtIO", 0x1af4}};
+  if (vendor == "Qualcomm" && !dxgi) {
+    return 0x5143u;
+  }
+  for (const auto& [name, id] : kVendors) {
+    if (vendor == name) {
+      return id;
+    }
+  }
+  return std::nullopt;
+}
+
+// The device id ANGLE's D3D11 and Vulkan renderer descriptions print after
+// the adapter name as "(0x%08X)", and in `name_end` where the name ends.
+std::optional<uint32_t> AngleDeviceId(std::string_view description,
+                                      size_t* name_end) {
+  const size_t pos = description.rfind(" (0x");
+  if (pos == std::string_view::npos || description.size() < pos + 13 ||
+      description[pos + 12] != ')') {
+    return std::nullopt;
+  }
+  const std::string_view hex = description.substr(pos + 4, 8);
+  uint32_t id = 0;
+  if (hex.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos ||
+      !base::HexStringToUInt(hex, &id)) {
+    return std::nullopt;
+  }
+  *name_end = pos;
+  return id;
+}
+
+// A copy of gl::GLVersionInfo::ParseDriverInfo: the driver vendor and version
+// Chrome reads from a native GL_VERSION string.
+void ParseGLDriverInfo(std::string_view version,
+                       std::string* vendor,
+                       std::string* driver_version) {
+  constexpr std::string_view kESPrefix = "OpenGL ES ";
+  if (version.starts_with(kESPrefix)) {
+    version.remove_prefix(kESPrefix.size());
+  }
+  std::vector<std::string_view> pieces = base::SplitStringPiece(
+      version, " -()@", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (pieces.size() < 2) {
+    return;
+  }
+  static constexpr std::pair<std::string_view, std::string_view> kVendors[] = {
+      {"ANGLE", "ANGLE"},       {"Mesa", "Mesa"},   {"INTEL", "INTEL"},
+      {"NVIDIA", "NVIDIA"},     {"ATI", "ATI"},     {"FireGL", "FireGL"},
+      {"Chromium", "Chromium"}, {"APPLE", "APPLE"}, {"AMD", "AMD"},
+      {"Metal", "Apple"}};
+  for (size_t i = 1; i < pieces.size(); ++i) {
+    for (const auto& [key, name] : kVendors) {
+      if (pieces[i] == key) {
+        *vendor = std::string(name);
+        if (i + 1 < pieces.size()) {
+          *driver_version = std::string(pieces[i + 1]);
+        }
+        return;
+      }
+    }
+  }
+  if (pieces.size() == 2) {
+    std::string_view piece = pieces[1];
+    if (piece.starts_with('V')) {
+      piece.remove_prefix(1);
+    }
+    *driver_version = std::string(piece);
+    return;
+  }
+  constexpr std::string_view kMaliPrefix = "v1.r";
+  if (pieces[1].starts_with(kMaliPrefix)) {
+    std::vector<std::string_view> numbers = base::SplitStringPiece(
+        pieces[1].substr(kMaliPrefix.size()), "p", base::TRIM_WHITESPACE,
+        base::SPLIT_WANT_NONEMPTY);
+    std::vector<std::string_view> parts = base::SplitStringPiece(
+        pieces[2], ".", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+    if (numbers.size() == 2 && parts.size() == 2) {
+      *vendor = "ARM";
+      *driver_version =
+          base::StrCat({numbers[0], ".", numbers[1], ".", parts[0]});
+    }
+    return;
+  }
+  for (size_t i = 1; i < pieces.size(); ++i) {
+    if (pieces[i].find('.') != std::string_view::npos) {
+      *driver_version = std::string(pieces[i]);
+      return;
+    }
+  }
+}
+
+// A copy of gl::GLVersionInfo::ExtractDriverVendorANGLE, which parses
+// "ANGLE (<vendor>, <renderer>, <native version>)".
+void ParseAngleDriverInfo(std::string_view gl_renderer,
+                          std::string* vendor,
+                          std::string* driver_version) {
+  constexpr std::string_view kAnglePrefix = "ANGLE (";
+  if (!gl_renderer.starts_with(kAnglePrefix) ||
+      gl_renderer.size() <= kAnglePrefix.size()) {
+    return;
+  }
+  std::vector<std::string_view> gl_strings = base::SplitStringPiece(
+      gl_renderer.substr(kAnglePrefix.size(),
+                         gl_renderer.size() - kAnglePrefix.size() - 1),
+      ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY);
+  if (gl_strings.size() < 3) {
+    return;
+  }
+  *vendor = std::string(gl_strings[0]);
+  ParseGLDriverInfo(base::TrimString(gl_strings[2], ")", base::TRIM_ALL),
+                    vendor, driver_version);
+}
+
+// Fills the GPU identity fields the profile leaves out from the WebGL claim,
+// where Chrome's and ANGLE's formats determine them, and refuses a given
+// value the format contradicts. ANGLE's WebGL renderer string lacks the
+// driver's full version that GPUInfo::gl_renderer has. A field neither given
+// nor determined is reported empty, or as id 0, never as the host's, and
+// named in `out->missing`.
+std::string DeriveGpuIdentity(const base::DictValue& gpu,
+                              const Profile::WebGL& webgl,
+                              Profile::Gpu* out) {
+  auto given = [&gpu](const char* key) { return gpu.contains(key); };
+  auto missing = [out](const char* field, const std::string& detail) {
+    out->missing.push_back(std::string("gpu.") + field + ": " + detail);
+  };
+  // GL_VENDOR is ANGLE's display vendor string in every context.
+  if (!given("gl_vendor")) {
+    out->gl_vendor = webgl.unmasked_vendor;
+  } else if (out->gl_vendor != webgl.unmasked_vendor) {
+    return Err("gpu.gl_vendor", "must equal gpu.webgl.unmasked_vendor \"" +
+                                    webgl.unmasked_vendor +
+                                    "\": both are ANGLE's GL_VENDOR");
+  }
+
+  const std::string& renderer = webgl.unmasked_renderer;
+  std::vector<std::string> parts;
+  if (renderer.starts_with("ANGLE (") && renderer.ends_with(")")) {
+    parts = base::SplitStringUsingSubstr(
+        std::string_view(renderer).substr(7, renderer.size() - 8), ", ",
+        base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  }
+  const bool angle = parts.size() == 3;
+  const std::string& backend = out->angle_backend;
+  const bool d3d11 = backend == "d3d11" && angle && parts[2] == "D3D11";
+
+  // Software GL reports 0xffff:0xffff. D3D11 and Vulkan print the adapter's
+  // ids; on D3D11 they are the DXGI adapter GPUInfo reads, so a given id must
+  // match.
+  std::optional<uint32_t> vendor_id;
+  std::optional<uint32_t> device_id;
+  size_t name_end = std::string::npos;
+  if (backend == "swiftshader") {
+    vendor_id = 0xffffu;
+    device_id = 0xffffu;
+  } else if (angle && (d3d11 || backend == "vulkan")) {
+    vendor_id = AngleVendorId(parts[0], d3d11);
+    device_id = AngleDeviceId(parts[1], &name_end);
+    if (device_id && *device_id > 0xffff) {
+      device_id.reset();
+    }
+  }
+  struct IdField {
+    const char* key;
+    std::optional<uint32_t> determined;
+    uint32_t* out;
+  };
+  for (const IdField& f : {IdField{"vendor_id", vendor_id, &out->vendor_id},
+                           IdField{"device_id", device_id, &out->device_id}}) {
+    if (given(f.key)) {
+      if (d3d11 && f.determined && *f.determined != *f.out) {
+        return Err(std::string("gpu.") + f.key,
+                   base::StringPrintf("is 0x%04x but gpu.webgl.unmasked_renderer "
+                                      "names the D3D11 adapter's 0x%04x",
+                                      *f.out, *f.determined));
+      }
+    } else if (f.determined) {
+      *f.out = *f.determined;
+    } else {
+      missing(f.key, "not in the profile, and gpu.webgl.unmasked_renderer (" +
+                         backend +
+                         ") names no PCI id; reported as 0x0000 (0xffff in "
+                         "a WebGL creation error's status message)");
+    }
+  }
+
+  // GL_RENDERER, then the driver Chrome parses from it.
+  bool renderer_known = true;
+  if (d3d11) {
+    // Renderer11::getVersionString: "D3D11", then "-<driver version>" when
+    // the driver version is known.
+    if (!given("driver_version") && given("gl_renderer")) {
+      std::string ignored;
+      ParseAngleDriverInfo(out->gl_renderer, &ignored, &out->driver_version);
+    }
+    const std::string expected =
+        "ANGLE (" + parts[0] + ", " + parts[1] + ", D3D11" +
+        (out->driver_version.empty() ? "" : "-" + out->driver_version) + ")";
+    if (!given("gl_renderer")) {
+      out->gl_renderer = expected;
+    } else if (out->gl_renderer != expected) {
+      return Err("gpu.gl_renderer",
+                 "must be \"" + expected +
+                     "\": gpu.webgl.unmasked_renderer with gpu.driver_version");
+    }
+  } else if (given("gl_renderer")) {
+    // The WebGL string is the full one cut before the driver part:
+    // SanitizeVersionString keeps "OpenGL ES <x.y>", vk::Renderer::
+    // getVersionString drops "-<driver version>".
+    const std::string_view head =
+        std::string_view(renderer).substr(0, renderer.size() - 1);
+    const std::string& full = out->gl_renderer;
+    if (angle && full != renderer &&
+        !(full.ends_with(")") && full.size() > renderer.size() &&
+          full.starts_with(head) &&
+          (full[head.size()] == ' ' || full[head.size()] == '-'))) {
+      return Err("gpu.gl_renderer",
+                 "must be gpu.webgl.unmasked_renderer with the driver's full "
+                 "version: \"" +
+                     std::string(head) + " <driver>)\"");
+    }
+  } else if (backend == "opengl" && angle &&
+             parts[2].starts_with("OpenGL ES ") &&
+             (out->driver_vendor == "NVIDIA" ||
+              out->driver_vendor == "Nvidia") &&
+             !out->driver_version.empty()) {
+    // NVIDIA's GL_VERSION is "OpenGL ES <x.y> NVIDIA <driver version>"
+    // ("Nvidia" is the same driver named by NV-CONTROL, below).
+    out->gl_renderer = renderer.substr(0, renderer.size() - 1) + " NVIDIA " +
+                       out->driver_version + ")";
+  } else {
+    out->gl_renderer = renderer;
+    renderer_known = false;
+    missing("gl_renderer",
+            "not in the profile, and gpu.webgl.unmasked_renderer (" + backend +
+                ") lacks the driver's full version; reported as the WebGL "
+                "renderer string");
+  }
+
+  std::string parsed_vendor;
+  std::string parsed_version;
+  // The WebGL fallback lacks the driver part, so its parse would name
+  // ANGLE's vendor, not the driver: nothing is determined then.
+  if (renderer_known) {
+    ParseAngleDriverInfo(out->gl_renderer, &parsed_vendor, &parsed_version);
+  }
+  if (backend == "swiftshader") {
+    // Set before GL info is collected, which fills only empty fields.
+    parsed_vendor = "SwANGLE";
+  }
+  // A given driver must be the one Chrome parses from a known GL_RENDERER, or
+  // on Linux the one ANGLE's system info names first: "Nvidia" from
+  // NV-CONTROL, "AMD (Brahma)" or "AMD (Catalyst)" on an AMD GPU.
+  const bool amd_system_info =
+      !d3d11 &&
+      (out->driver_vendor == "AMD (Brahma)" ||
+       out->driver_vendor == "AMD (Catalyst)") &&
+      (out->vendor_id == 0x1002 ||
+       (angle && (parts[0].starts_with("AMD") || parts[0].starts_with("ATI"))));
+  const bool nvctrl = !d3d11 && out->driver_vendor == "Nvidia" &&
+                      parsed_vendor == "NVIDIA";
+  if (given("driver_vendor") && !parsed_vendor.empty() &&
+      out->driver_vendor != parsed_vendor &&
+      !amd_system_info && !nvctrl) {
+    return Err("gpu.driver_vendor",
+               "is \"" + out->driver_vendor +
+                   "\" but gpu.gl_renderer names \"" + parsed_vendor +
+                   "\" (GLVersionInfo::ExtractDriverVendorANGLE)");
+  }
+  if (given("driver_version") && !parsed_version.empty() &&
+      out->driver_version != parsed_version && !amd_system_info) {
+    return Err("gpu.driver_version",
+               "is \"" + out->driver_version +
+                   "\" but gpu.gl_renderer names \"" + parsed_version +
+                   "\" (GLVersionInfo::ExtractDriverVendorANGLE)");
+  }
+  if (!given("driver_vendor")) {
+    out->driver_vendor = parsed_vendor;
+    if (parsed_vendor.empty()) {
+      missing("driver_vendor",
+              "not in the profile or gpu.gl_renderer; reported empty");
+    }
+  }
+  if (!given("driver_version") && out->driver_version.empty()) {
+    out->driver_version = parsed_version;
+    if (parsed_version.empty()) {
+      missing("driver_version",
+              "not in the profile or gpu.gl_renderer; reported empty "
+              "(chrome://gpu shows no DRIVER_VERSION, a WebGL creation "
+              "error's status message no GL_VERSION)");
+    }
+  }
+
+  // Windows identifies the active adapter by LUID and keeps DXGI's
+  // description with no vendor string (IdentifyActiveGPUWithLuid); a single
+  // GPU elsewhere is named by GL_VENDOR and GL_RENDERER (IdentifyActiveGPU).
+  if (!given("vendor_name")) {
+    out->vendor_name = d3d11 ? std::string() : out->gl_vendor;
+  }
+  if (!given("device_name")) {
+    out->device_name = d3d11 && name_end != std::string::npos
+                           ? parts[1].substr(0, name_end)
+                           : out->gl_renderer;
+  }
+  return std::string();
+}
+
+// Returns the first refused fingerprinting switch or feature, or an empty
+// string. Every Blink runtime feature also has a base::Feature of the same
+// name, so both feature lists are checked. chrome://flags entries become
+// switches later and are not seen here.
+std::string RefusedFingerprintingSwitch(const base::CommandLine& command_line) {
+  for (const char* name : kRefusedSwitches) {
+    if (command_line.HasSwitch(name)) {
+      return std::string("--") + name;
+    }
+  }
+  for (const char* list : {"enable-blink-features", "enable-features"}) {
+    for (const std::string& entry :
+         base::SplitString(command_line.GetSwitchValueASCII(list), ",",
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      std::string name = entry.substr(entry.front() == '*' ? 1 : 0);
+      name = name.substr(0, name.find_first_of("<:"));
+      if (OneOf(name, kRefusedFeatures)) {
+        return std::string("--") + list + "=" + name;
+      }
+    }
+  }
+  return std::string();
+}
