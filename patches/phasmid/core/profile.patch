+// Every CSS system color keyword Chrome resolves. Blink reads some of them
+// from one color provider entry (LayoutTheme::SystemColorFromColorProvider);
+// `same_as` names the keyword each such alias must equal.
+struct SystemColorName {
+  const char* name;
+  const char* same_as;
+};
+constexpr SystemColorName kSystemColorNames[] = {
+    {"AccentColor", nullptr},          {"AccentColorText", nullptr},
+    {"ActiveBorder", "ButtonText"},    {"ActiveCaption", "Canvas"},
+    {"ActiveText", nullptr},           {"AppWorkspace", "Canvas"},
+    {"Background", "Canvas"},          {"ButtonBorder", "ButtonText"},
+    {"ButtonFace", nullptr},           {"ButtonHighlight", "ButtonFace"},
+    {"ButtonShadow", "ButtonFace"},    {"ButtonText", nullptr},
+    {"Canvas", nullptr},               {"CanvasText", nullptr},
+    {"CaptionText", "CanvasText"},     {"Field", nullptr},
+    {"FieldText", nullptr},            {"GrayText", nullptr},
+    {"Highlight", nullptr},            {"HighlightText", nullptr},
+    {"InactiveBorder", "ButtonText"},  {"InactiveCaption", "Canvas"},
+    {"InactiveCaptionText", nullptr},  {"InfoBackground", "Canvas"},
+    {"InfoText", "CanvasText"},        {"LinkText", nullptr},
+    {"Mark", nullptr},                 {"MarkText", nullptr},
+    {"Menu", "Canvas"},                {"MenuText", "CanvasText"},
+    {"Scrollbar", "Canvas"},           {"SelectedItem", nullptr},
+    {"SelectedItemText", nullptr},     {"ThreeDDarkShadow", "ButtonText"},
+    {"ThreeDFace", "ButtonFace"},      {"ThreeDHighlight", "ButtonText"},
+    {"ThreeDLightShadow", "ButtonText"}, {"ThreeDShadow", "ButtonText"},
+    {"VisitedText", nullptr},          {"Window", "Canvas"},
+    {"WindowFrame", "ButtonText"},     {"WindowText", "CanvasText"},
+};
+
+// How getComputedStyle writes an 8-bit alpha below 255: two decimals when
+// they map back to the same byte, else three, without trailing zeros
+// (blink::Color::SerializeLegacyColorAsCSSColor, in float as there).
+std::string CanonicalAlpha(int alpha8) {
+  float value =
+      static_cast<float>(std::round(alpha8 * 100.0 / 255.0) / 100.0);
+  if (std::round(value * 255) != alpha8) {
+    value = static_cast<float>(std::round(alpha8 * 1000.0 / 255.0) / 1000.0);
+  }
+  std::string text = base::StringPrintf("%.3f", value);
+  text.erase(text.find_last_not_of('0') + 1);
+  if (text.back() == '.') {
+    text.pop_back();
+  }
+  return text;
+}
+
+// A color exactly as getComputedStyle serializes an sRGB system color:
+// "rgb(R, G, B)" when opaque, else "rgba(R, G, B, A)".
+std::optional<Profile::SystemColor> ParseSystemColor(const std::string& text) {
+  const bool translucent = text.starts_with("rgba(");
+  if ((!translucent && !text.starts_with("rgb(")) || !text.ends_with(")")) {
+    return std::nullopt;
+  }
+  const size_t open = text.find('(') + 1;
+  std::vector<std::string> parts =
+      base::SplitStringUsingSubstr(text.substr(open, text.size() - open - 1),
+                                   ", ", base::KEEP_WHITESPACE,
+                                   base::SPLIT_WANT_ALL);
+  if (parts.size() != (translucent ? 4u : 3u)) {
+    return std::nullopt;
+  }
+  int channels[3] = {0, 0, 0};
+  for (size_t i = 0; i < 3; ++i) {
+    const std::string& part = parts[i];
+    if (part.empty() || part.size() > 3 ||
+        part.find_first_not_of("0123456789") != std::string::npos ||
+        (part.size() > 1 && part[0] == '0') ||
+        !base::StringToInt(part, &channels[i]) || channels[i] > 255) {
+      return std::nullopt;
+    }
+  }
+  Profile::SystemColor color;
+  color.red = static_cast<uint8_t>(channels[0]);
+  color.green = static_cast<uint8_t>(channels[1]);
+  color.blue = static_cast<uint8_t>(channels[2]);
+  if (translucent) {
+    double alpha = 0;
+    if (!base::StringToDouble(parts[3], &alpha) || !(alpha >= 0 && alpha < 1)) {
+      return std::nullopt;
+    }
+    const int alpha8 = static_cast<int>(std::lround(alpha * 255));
+    if (alpha8 > 254 || parts[3] != CanonicalAlpha(alpha8)) {
+      return std::nullopt;
+    }
+    color.alpha = static_cast<uint8_t>(alpha8);
+  }
+  return color;
+}
+
+// The set is for display.prefers_color_scheme. There is no OS default table
+// to fall back on, so it is required and complete.
+std::string ParseSystemColors(
+    const base::DictValue& dict,
+    base::flat_map<std::string, Profile::SystemColor>* out,
+    bool* dark) {
+  const std::string* scheme =
+      dict.FindDict("display")->FindString("prefers_color_scheme");
+  if (!scheme || (*scheme != "light" && *scheme != "dark")) {
+    return Err("display.prefers_color_scheme", "must be \"light\" or \"dark\"");
+  }
+  *dark = *scheme == "dark";
+  const base::DictValue* colors = dict.FindDict("system_colors");
+  if (!colors) {
+    return Err("system_colors", "is required and must be an object");
+  }
+  for (const auto [key, value] : *colors) {
+    bool known = false;
+    for (const SystemColorName& entry : kSystemColorNames) {
+      known = known || key == entry.name;
+    }
+    if (!known) {
+      return Err("system_colors." + key,
+                 "is not a CSS system color keyword Chrome resolves");
+    }
+  }
+  std::vector<std::pair<std::string, Profile::SystemColor>> values;
+  for (const SystemColorName& entry : kSystemColorNames) {
+    const std::string field = std::string("system_colors.") + entry.name;
+    const std::string* text = colors->FindString(entry.name);
+    if (!text) {
+      return Err(field, "is required and must be a string");
+    }
+    std::optional<Profile::SystemColor> color = ParseSystemColor(*text);
+    if (!color) {
+      return Err(field,
+                 "must be \"rgb(R, G, B)\", or \"rgba(R, G, B, A)\" when "
+                 "translucent, exactly as getComputedStyle writes it");
+    }
+    const std::string* same = entry.same_as
+                                  ? colors->FindString(entry.same_as)
+                                  : nullptr;
+    if (same && *same != *text) {
+      return Err(field, std::string("must equal system_colors.") +
+                            entry.same_as +
+                            ": Chrome resolves both from one color");
+    }
+    values.emplace_back(base::ToLowerASCII(entry.name), *color);
+  }
+  *out = base::flat_map<std::string, Profile::SystemColor>(std::move(values));
+  return std::string();
+}
+
+// Which families this host has is checked in font_allowlist_linux.cc.
+std::string ParseFonts(const base::DictValue& fonts,
+                       const std::string& os_family,
+                       Profile::Fonts* out) {
+  const base::ListValue* families = fonts.FindList("families");
+  if (!families || families->size() < 10) {
+    return Err("fonts.families", "must be a list of at least 10 families");
+  }
+  std::set<std::string> listed;
+  for (const base::Value& family : *families) {
+    if (!family.is_string() || family.GetString().empty()) {
+      return Err("fonts.families", "entries must be non-empty family names");
+    }
+    if (!listed.insert(base::ToLowerASCII(family.GetString())).second) {
+      return Err("fonts.families", "lists " + family.GetString() + " twice");
+    }
+    out->families.push_back(family.GetString());
+  }
+
+  // Linux Chrome reports the CSS system font keywords (caption, menu, ...)
+  // as Arial at the default font size (LayoutThemeFontProvider).
+  const base::DictValue* ui_font = fonts.FindDict("ui_font");
+  const std::string* ui_family =
+      ui_font ? ui_font->FindString("family") : nullptr;
+  std::optional<double> ui_size =
+      ui_font ? ui_font->FindDouble("size_px") : std::nullopt;
+  if (!ui_family || ui_family->empty() || !ui_size || !(*ui_size > 0)) {
+    return Err("fonts.ui_font",
+               "must have a non-empty family and a positive size_px");
+  }
+  if (os_family == "linux" && (*ui_family != "Arial" || *ui_size != 16.0)) {
+    return Err("fonts.ui_font",
+               "must be Arial at 16 px for os.family linux: Linux Chrome "
+               "reports the system font keywords as Arial at the default "
+               "font size");
+  }
+
+  struct NamedFamily {
+    const char* key;
+    const char* field;
+    std::string* out;
+  };
+  for (const NamedFamily& f :
+       {NamedFamily{"default_sans", "fonts.default_sans", &out->default_sans},
+        NamedFamily{"default_serif", "fonts.default_serif",
+                    &out->default_serif},
+        NamedFamily{"default_monospace", "fonts.default_monospace",
+                    &out->default_monospace},
+        NamedFamily{"emoji", "fonts.emoji", &out->emoji}}) {
+    const base::Value* value = fonts.Find(f.key);
+    if (!value) {
+      continue;
+    }
+    if (!value->is_string() || value->GetString().empty()) {
+      return Err(f.field, "must be a non-empty family name");
+    }
+    if (!listed.contains(base::ToLowerASCII(value->GetString()))) {
+      return Err(f.field, "is " + value->GetString() +
+                              ", which is not in fonts.families");
+    }
+    *f.out = value->GetString();
+  }
+  return std::string();
+}
