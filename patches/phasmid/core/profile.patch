+
+# Depends only on //base so that blink, content, gpu and chrome can all use it.
+component("phasmid") {
+  sources = [
+    "noise.cc",
+    "noise.h",
+    "profile.cc",
+    "profile.h",
+    "switches.cc",
+    "switches.h",
+  ]
+
+  defines = [ "IS_PHASMID_IMPL" ]
+
+  deps = [ "//base" ]
+}
+
+# Browser process only. Kept out of :phasmid, which depends only on //base.
+if (is_linux || is_chromeos) {
+  source_set("font_allowlist") {
+    sources = [
+      "font_allowlist_linux.cc",
+      "font_allowlist_linux.h",
+    ]
+    deps = [
+      ":phasmid",
+      "//base",
+      "//crypto",
+      "//skia",
+      "//third_party/fontconfig",
+    ]
+  }
+}
+
+source_set("unit_tests") {
+  testonly = true
+  sources = [ "noise_unittest.cc" ]
+  deps = [
+    ":phasmid",
+    "//testing/gtest",
+  ]
+}
