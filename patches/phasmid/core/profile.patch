+
+TEST(PhasmidNoiseTest, SipHash24MatchesReferenceVectors) {
+  const NoiseKey key = {0x0706050403020100ULL, 0x0f0e0d0c0b0a0908ULL};
+  std::vector<uint8_t> message;
+  for (size_t n = 0; n < kReferenceVectors.size(); ++n) {
+    EXPECT_EQ(SipHash24(key, message), kReferenceVectors[n]) << "length " << n;
+    message.push_back(static_cast<uint8_t>(n));
+  }
+}
+
+TEST(PhasmidNoiseTest, SeedParsing) {
+  NoiseKey key;
+  ASSERT_TRUE(NoiseKeyFromSeed("000102030405060708090a0b0c0d0e0f", &key));
+  EXPECT_EQ(key.k0, 0x0706050403020100ULL);
+  EXPECT_EQ(key.k1, 0x0f0e0d0c0b0a0908ULL);
+  EXPECT_FALSE(NoiseKeyFromSeed("000102030405060708090A0B0C0D0E0F", &key));
+  EXPECT_FALSE(NoiseKeyFromSeed("0001020304050607", &key));
+  EXPECT_FALSE(NoiseKeyFromSeed("000102030405060708090a0b0c0d0e0g", &key));
+}
+
+// Frozen derivations: a failure here means every profile's canvas or audio
+// output changed.
+TEST(PhasmidNoiseTest, DerivedKeysAreFrozen) {
+  NoiseKey seed;
+  ASSERT_TRUE(NoiseKeyFromSeed("5b1d7c0e9a3f4d2c8e6b1a0f7c3d9e21", &seed));
+  const NoiseKey canvas = DeriveNoiseKey(seed, "phasmid/canvas/1");
+  EXPECT_EQ(canvas.k0, 0x76f2fb5423fa0ba9ULL);
+  EXPECT_EQ(canvas.k1, 0x312d93be81a91a51ULL);
+  const NoiseKey audio = DeriveNoiseKey(seed, "phasmid/audio/1");
+  EXPECT_EQ(audio.k0, 0x1a22400fd543118dULL);
+  EXPECT_EQ(audio.k1, 0x1ba979a29eccfb62ULL);
+}
+
