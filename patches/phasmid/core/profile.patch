+// Copyright 2026 The Phasmid Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef COMPONENTS_PHASMID_NOISE_H_
+#define COMPONENTS_PHASMID_NOISE_H_
+
+#include <stdint.h>
+
+#include <string_view>
+
+#include "base/component_export.h"
+#include "base/containers/span.h"
+
+namespace phasmid {
+
+// A 128-bit SipHash key, derived from the profile seed.
+struct NoiseKey {
+  uint64_t k0 = 0;
+  uint64_t k1 = 0;
+};
+
+// SipHash-2-4 of `data` under `key`, with the reference algorithm's
+// little-endian key and message loading.
+//
+// Frozen: changing it, or any key derivation below, changes every profile's
+// canvas and audio readback.
+COMPONENT_EXPORT(PHASMID)
+uint64_t SipHash24(const NoiseKey& key, base::span<const uint8_t> data);
+
+// The profile seed as a key: the 32 hex digits are 16 bytes in string order,
+// k0 is bytes 0..7 and k1 bytes 8..15, each read little-endian. Returns false
+// unless `hex` is exactly 32 lowercase hex digits.
+COMPONENT_EXPORT(PHASMID)
+bool NoiseKeyFromSeed(std::string_view hex, NoiseKey* key);
+
+// A key for one purpose, separated from every other purpose by `tag`:
+// k0 = SipHash24(seed, tag || 0x00), k1 = SipHash24(seed, tag || 0x01).
+COMPONENT_EXPORT(PHASMID)
+NoiseKey DeriveNoiseKey(const NoiseKey& seed, std::string_view tag);
+
+}  // namespace phasmid
+
+#endif  // COMPONENTS_PHASMID_NOISE_H_
