+                              int minimum,
+                              std::string* error) {
+  std::optional<int> value = dict.FindInt(key);
+  if (!value || *value < minimum) {
+    *error = Err(field, base::StringPrintf("must be an integer >= %d", minimum));
+    return std::nullopt;
+  }
+  return value;
+}
+
+// A dotted IPv4 quad or a bracket-free IPv6 literal. Only a typo check; the
+// network service parses it with net::IPAddress.
+bool LooksLikeIpLiteral(const std::string& ip) {
+  if (ip.find(':') != std::string::npos) {
+    return ip.find_first_not_of("0123456789abcdefABCDEF:.") ==
+           std::string::npos;
+  }
+  std::vector<std::string> parts = base::SplitString(
+      ip, ".", base::KEEP_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 4) {
+    return false;
+  }
+  for (const std::string& part : parts) {
+    int octet = 0;
+    if (part.empty() || !base::StringToInt(part, &octet) || octet < 0 ||
+        octet > 255) {
+      return false;
+    }
+  }
+  return true;
+}
+
+std::optional<std::vector<double>> Numbers(const base::Value& value) {
+  if (std::optional<double> number = value.GetIfDouble()) {
+    return std::vector<double>{*number};
+  }
+  if (!value.is_list()) {
+    return std::nullopt;
+  }
+  std::vector<double> out;
+  for (const base::Value& entry : value.GetList()) {
+    std::optional<double> number = entry.GetIfDouble();
+    if (!number) {
+      return std::nullopt;
+    }
+    out.push_back(*number);
+  }
+  return out;
+}
+
+bool IsExactInteger(double value) {
+  return std::isfinite(value) && std::abs(value) <= kMaxExactInteger &&
+         value == std::floor(value);
+}
+
+// Every identity field is optional; DeriveGpuIdentity fills the absent ones.
+std::string ParseGpu(const base::DictValue& gpu, Profile::Gpu* out) {
+  struct IdField {
+    const char* key;
+    uint32_t* out;
+  };
+  for (const IdField& f : {IdField{"vendor_id", &out->vendor_id},
+                           IdField{"device_id", &out->device_id}}) {
+    if (!gpu.contains(f.key)) {
+      continue;
+    }
+    const std::string* id = gpu.FindString(f.key);
+    if (!id || id->size() != 6 || !id->starts_with("0x") ||
+        id->find_first_not_of("0123456789abcdef", 2) != std::string::npos ||
+        !base::HexStringToUInt(std::string_view(*id).substr(2), f.out)) {
+      return Err(std::string("gpu.") + f.key,
+                 "must be a lowercase hex id such as 0x10de");
+    }
+  }
+  struct StringField {
+    const char* key;
+    std::string* out;
+    bool non_empty;
+  };
+  for (const StringField& f :
+       {StringField{"vendor_name", &out->vendor_name, false},
+        StringField{"device_name", &out->device_name, false},
+        StringField{"driver_vendor", &out->driver_vendor, false},
+        StringField{"driver_version", &out->driver_version, false},
+        StringField{"gl_vendor", &out->gl_vendor, true},
+        StringField{"gl_renderer", &out->gl_renderer, true},
+        StringField{"angle_backend", &out->angle_backend, true}}) {
+    const bool required = f.out == &out->angle_backend;
+    if (!required && !gpu.contains(f.key)) {
+      continue;
+    }
+    const std::string* value = gpu.FindString(f.key);
+    if (!value || (f.non_empty && value->empty())) {
+      return Err(std::string("gpu.") + f.key,
+                 std::string(required ? "is required and must be" : "must be") +
+                     (f.non_empty ? " a non-empty string" : " a string"));
+    }
+    *f.out = *value;
+  }
+  if (!OneOf(out->angle_backend, kAngleBackends)) {
+    return Err("gpu.angle_backend", "must be one of " + Listed(kAngleBackends));
+  }
+  return std::string();
+}
+
+std::string ParseWebGL(const base::DictValue& gpu,
+                       const char* key,
+                       bool webgl2,
+                       Profile::WebGL* out) {
+  const std::string prefix = std::string("gpu.") + key;
+  const base::DictValue* webgl = gpu.FindDict(key);
+  if (!webgl) {
+    return Err(prefix, "is required and must be an object");
+  }
+  struct StringField {
+    const char* key;
+    std::string* out;
+  };
+  for (const StringField& f :
+       {StringField{"unmasked_vendor", &out->unmasked_vendor},
+        StringField{"unmasked_renderer", &out->unmasked_renderer}}) {
+    const std::string* value = webgl->FindString(f.key);
+    if (!value || value->empty()) {
+      return Err(prefix + "." + f.key,
+                 "is required and must be a non-empty string");
+    }
+    *f.out = *value;
+  }
+
+  const base::ListValue* extensions = webgl->FindList("extensions");
+  if (!extensions) {
+    return Err(prefix + ".extensions",
+               "is required and must be a list of extension names");
+  }
+  std::vector<std::string> extension_names;
+  for (const base::Value& entry : *extensions) {
+    if (!entry.is_string() || entry.GetString().empty()) {
+      return Err(prefix + ".extensions", "entries must be extension names");
+    }
+    extension_names.push_back(entry.GetString());
+  }
+  out->extensions = base::flat_set<std::string>(std::move(extension_names));
+
+  const base::DictValue* params = webgl->FindDict("params");
+  if (!params) {
+    return Err(prefix + ".params", "is required and must be an object");
+  }
+  std::vector<std::pair<std::string, std::vector<double>>> numeric;
+  for (const auto [name, value] : *params) {
+    if (std::optional<std::vector<double>> numbers = Numbers(value)) {
+      numeric.emplace_back(name, std::move(*numbers));
+    }
+  }
+  out->params =
+      base::flat_map<std::string, std::vector<double>>(std::move(numeric));
+  auto check_param = [&](const char* name, size_t count, bool integer) {
+    auto it = out->params.find(name);
+    bool ok = it != out->params.end() && it->second.size() == count;
+    for (size_t i = 0; ok && i < count; ++i) {
+      double value = it->second[i];
+      ok = integer ? IsExactInteger(value) : std::isfinite(value);
+    }
+    if (ok) {
+      return std::string();
+    }
+    return Err(prefix + ".params." + name,
+               count == 1 ? (integer ? "is required and must be an integer"
+                                     : "is required and must be a number")
+                          : "is required and must be a list of two numbers");
+  };
+  std::string error;
+  for (const char* name : kWebGLParams) {
+    if (error.empty()) {
+      error = check_param(name, 1, true);
+    }
+  }
+  for (const char* name : kWebGLRangeParams) {
+    if (error.empty()) {
+      error = check_param(name, 2, false);
+    }
+  }
+  for (const char* name : kWebGL2Params) {
+    if (webgl2 && error.empty()) {
+      error = check_param(name, 1,
+                          std::string_view(name) != "MAX_TEXTURE_LOD_BIAS");
+    }
+  }
+  if (!error.empty()) {
+    return error;
+  }
+
+  const base::DictValue* precision = webgl->FindDict("precision");
+  if (!precision) {
+    return Err(prefix + ".precision", "is required and must be an object");
+  }
+  for (size_t shader = 0; shader < std::size(kPrecisionShaders); ++shader) {
+    for (size_t type = 0; type < std::size(kPrecisionTypes); ++type) {
+      const std::string name = std::string(kPrecisionShaders[shader]) + "." +
+                               kPrecisionTypes[type];
+      const base::DictValue* entry = precision->FindDict(name);
+      std::optional<int> range_min =
+          entry ? entry->FindInt("rangeMin") : std::nullopt;
+      std::optional<int> range_max =
+          entry ? entry->FindInt("rangeMax") : std::nullopt;
+      std::optional<int> bits =
+          entry ? entry->FindInt("precision") : std::nullopt;
+      if (!range_min || !range_max || !bits || *range_min < 0 ||
+          *range_min > 127 || *range_max < 0 || *range_max > 127 ||
+          *bits < 0 || *bits > 127) {
+        return Err(prefix + ".precision." + name,
+                   "must hold rangeMin, rangeMax and precision, integers in "
+                   "[0, 127]");
+      }
+      out->precision[shader][type] = {*range_min, *range_max, *bits};
+    }
+  }
+
+  const base::DictValue* attributes = webgl->FindDict("context_attributes");
+  std::optional<bool> antialias =
+      attributes ? attributes->FindBool("antialias") : std::nullopt;
+  if (!antialias) {
+    return Err(prefix + ".context_attributes.antialias",
+               "is required and must be a boolean");
+  }
+  out->antialias = *antialias;
+
+  const base::Value* anisotropy = webgl->Find("max_anisotropy");
+  if (!anisotropy ||
+      !(anisotropy->is_none() || (anisotropy->GetIfDouble() &&
+                                  anisotropy->GetDouble() >= 1.0 &&
+                                  std::isfinite(anisotropy->GetDouble())))) {
+    return Err(prefix + ".max_anisotropy",
+               "is required and must be a number >= 1, or null");
+  }
+  if (!anisotropy->is_none()) {
+    out->max_anisotropy = anisotropy->GetDouble();
+  }
+  const base::Value* draw_buffers = webgl->Find("max_draw_buffers");
+  if (draw_buffers && !draw_buffers->is_none()) {
+    if (!draw_buffers->is_int() || draw_buffers->GetInt() < 1) {
+      return Err(prefix + ".max_draw_buffers",
+                 "must be an integer >= 1, or null");
+    }
+    out->max_draw_buffers = draw_buffers->GetInt();
+  }
+  return std::string();
+}
+
+// wgsl_language_features is not read: the build decides it.
+std::string ParseWebGPU(const base::DictValue& gpu,
+                        const std::string& os_family,
+                        Profile::WebGPU* out) {
+  const base::DictValue* webgpu = gpu.FindDict("webgpu");
+  if (!webgpu) {
+    return Err("gpu.webgpu", "is required and must be an object");
+  }
+  std::optional<bool> available = webgpu->FindBool("available");
+  if (!available) {
+    return Err("gpu.webgpu.available", "is required and must be a boolean");
+  }
+  // GPU::GetPreferredCanvasFormat picks the format by OS at compile time,
+  // with or without an adapter.
+  const std::string os_format =
+      os_family == "linux" ? "rgba8unorm" : "bgra8unorm";
+  const std::string* format = webgpu->FindString("preferred_canvas_format");
+  if ((*available && !format) || (format && *format != os_format)) {
+    return Err("gpu.webgpu.preferred_canvas_format",
+               "must be " + os_format + " for os.family " + os_family);
+  }
+  out->available = *available;
+  out->preferred_canvas_format = os_format;
+  if (!out->available) {
+    return std::string();
+  }
+
+  struct StringField {
+    const char* key;
+    std::string* out;
+    bool must_be_empty;
+  };
+  // Stock Chrome fills device and description only with WebGPU developer
+  // features, so a capture always has them empty.
+  for (const StringField& f :
+       {StringField{"vendor", &out->vendor, false},
+        StringField{"architecture", &out->architecture, false},
+        StringField{"device", &out->device, true},
+        StringField{"description", &out->description, true}}) {
+    const std::string* value = webgpu->FindString(f.key);
+    if (!value || (f.must_be_empty && !value->empty())) {
+      return Err(std::string("gpu.webgpu.") + f.key,
+                 f.must_be_empty ? "is required and must be empty"
+                                 : "is required and must be a string");
+    }
+    *f.out = *value;
+  }
+  struct SubgroupField {
+    const char* key;
+    uint32_t* out;
+  };
+  for (const SubgroupField& f :
+       {SubgroupField{"subgroup_min_size", &out->subgroup_min_size},
+        SubgroupField{"subgroup_max_size", &out->subgroup_max_size}}) {
+    std::optional<int> size = webgpu->FindInt(f.key);
+    if (!size || *size < 0 || *size > 1024 || (*size & (*size - 1)) != 0) {
+      return Err(std::string("gpu.webgpu.") + f.key,
+                 "must be 0 or a power of two up to 1024");
+    }
+    *f.out = static_cast<uint32_t>(*size);
+  }
+  if (out->subgroup_min_size > out->subgroup_max_size) {
+    return Err("gpu.webgpu.subgroup_min_size",
+               "must not exceed gpu.webgpu.subgroup_max_size");
+  }
+  // isFallbackAdapter is true only for a CPU adapter, which no GPU profile
+  // claims.
+  if (webgpu->FindBool("is_fallback_adapter") != std::optional<bool>(false)) {
+    return Err("gpu.webgpu.is_fallback_adapter", "is required and must be false");
+  }
+
+  const base::ListValue* features = webgpu->FindList("features");
+  if (!features) {
+    return Err("gpu.webgpu.features",
+               "is required and must be a list of feature names");
+  }
+  std::vector<std::string> feature_names;
+  for (const base::Value& entry : *features) {
+    if (!entry.is_string() || entry.GetString().empty()) {
+      return Err("gpu.webgpu.features", "entries must be feature names");
+    }
+    feature_names.push_back(entry.GetString());
+  }
+  out->features = base::flat_set<std::string>(std::move(feature_names));
+
+  const base::DictValue* limits = webgpu->FindDict("limits");
+  if (!limits) {
+    return Err("gpu.webgpu.limits", "is required and must be an object");
+  }
+  for (const auto entry : *limits) {
+    if (!OneOf(entry.first, kWebGPULimits)) {
+      return Err("gpu.webgpu.limits." + entry.first,
+                 "is not a limit this build reports");
+    }
+  }
+  std::vector<std::pair<std::string, uint64_t>> limit_values;
+  for (const char* name : kWebGPULimits) {
+    std::optional<double> value = limits->FindDouble(name);
+    if (!value || *value < 0 || !IsExactInteger(*value)) {
+      return Err(std::string("gpu.webgpu.limits.") + name,
+                 "is required and must be a non-negative integer");
+    }
+    limit_values.emplace_back(name, static_cast<uint64_t>(*value));
+  }
+  out->limits =
+      base::flat_map<std::string, uint64_t>(std::move(limit_values));
+  return std::string();
+}
+
+// performance.memory.jsHeapSizeLimit for `physical_memory_mb` of RAM on
+// 64-bit desktop: V8's Heap::MaxReserved() after
+// ResourceConstraints::ConfigureDefaults() and Heap::ConfigureHeap(). The old
+// generation is half the RAM within [256 MB, 4 GB]; a semi-space is 1/128 of
+// the RAM within [2 MB, 32 MB], rounded up to a power of two; the limit adds
+// two semi-spaces and a new large-object space of one semi-space. V8 is
+// handed the profile's RAM, so it arrives at the same value.
+int64_t V8HeapSizeLimit(int physical_memory_mb) {
+  constexpr int64_t kMB = 1024 * 1024;
+  const int64_t physical = int64_t{physical_memory_mb} * kMB;
+  int64_t old_generation = physical / 2;
+  if (old_generation < 256 * kMB) {
+    old_generation = 256 * kMB;
+  }
+  if (old_generation > 4096 * kMB) {
+    old_generation = 4096 * kMB;
+  }
+  const int64_t semi_space_target = physical / 4 / 32;
+  int64_t semi_space = 2 * kMB;
+  while (semi_space < semi_space_target && semi_space < 32 * kMB) {
+    semi_space *= 2;
+  }
+  return old_generation + 3 * semi_space;
+}
+
+// SpeechSynthesisImpl::SendVoiceListToObserver reports voiceURI as the voice
+// name and marks only the first voice default, so a profile saying otherwise
+// cannot be reported.
+std::string ParseSpeechVoices(const base::DictValue& dict,
+                              std::vector<Profile::SpeechVoice>* out) {
+  const base::DictValue* speech = dict.FindDict("speech");
+  if (!speech) {
+    return Err("speech", "is required and must be an object");
+  }
+  const base::ListValue* voices = speech->FindList("voices");
+  if (!voices) {
+    return Err("speech.voices", "is required and must be a list");
+  }
+  std::set<std::string> names;
+  for (size_t i = 0; i < voices->size(); ++i) {
+    const std::string field = base::StringPrintf("speech.voices[%zu]", i);
+    const base::DictValue* voice = (*voices)[i].GetIfDict();
+    if (!voice) {
+      return Err(field, "must be an object");
+    }
+    const std::string* name = voice->FindString("name");
+    if (!name || name->empty()) {
+      return Err(field + ".name", "is required and must be a non-empty string");
+    }
+    if (!names.insert(*name).second) {
+      return Err(field + ".name", "repeats an earlier voice's name");
+    }
+    const std::string* lang = voice->FindString("lang");
+    if (!lang || lang->empty()) {
+      return Err(field + ".lang", "is required and must be a non-empty string");
+    }
+    const std::string* voice_uri = voice->FindString("voice_uri");
+    if (!voice_uri || *voice_uri != *name) {
+      return Err(field + ".voice_uri",
+                 "must equal the voice's name: Chromium reports the name as "
+                 "voiceURI");
+    }
+    std::optional<bool> local_service = voice->FindBool("local_service");
+    if (!local_service) {
+      return Err(field + ".local_service", "is required and must be a boolean");
+    }
+    if (voice->FindBool("default") != std::optional<bool>(i == 0)) {
+      return Err(field + ".default",
+                 i == 0 ? "must be true: Chromium marks the first voice default"
+                        : "must be false: Chromium marks only the first voice "
+                          "default");
+    }
+    out->push_back(Profile::SpeechVoice{*name, *lang, *local_service});
+  }
+  return std::string();
+}
+
+// Beyond the schema's enums, only what Chrome can report on the claimed OS is
+// accepted:
+// - pointer and hover follow the input devices on both OSes
+//   (pointer_device_linux.cc, pointer_device_win.cc): a mouse or touchpad
+//   gives any-pointer fine and any-hover hover, a touchscreen any-pointer
+//   coarse and maxTouchPoints > 0; the primary pointer is fine over coarse
+//   over none, and the primary hover is hover only with a mouse;
+// - an HDR screen always reports color-gamut p3 (GetColorSpaceGamut);
+// - prefers-contrast is never less, and is more whenever forced colors are
+//   active. On Windows it is set only with forced colors
+//   (NativeTheme::CalculatePreferredContrast).
+std::string ParseMediaFeatures(const base::DictValue& display,
+                               const base::DictValue& hardware,
+                               const std::string& os_family,
+                               Profile::MediaFeatures* out) {
+  static constexpr const char* kPrimaryPointers[] = {"fine", "coarse", "none"};
+  static constexpr const char* kHovers[] = {"hover", "none"};
+  static constexpr const char* kColorGamuts[] = {"srgb", "p3", "rec2020"};
+  static constexpr const char* kDynamicRanges[] = {"standard", "high"};
+  static constexpr const char* kColorSchemes[] = {"light", "dark"};
+  static constexpr const char* kReducedMotions[] = {"no-preference", "reduce"};
+  static constexpr const char* kContrasts[] = {"no-preference", "more",
+                                               "less"};
+  static constexpr const char* kForcedColors[] = {"none", "active"};
+
+  const base::DictValue* pointer = display.FindDict("pointer");
+  if (!pointer) {
+    return Err("display.pointer", "is required and must be an object");
+  }
+  // The first field that is not one of `allowed` names the error.
+  std::string error;
+  auto one_of = [&error](const base::DictValue& dict, const char* key,
+                         const char* field, const auto& allowed) {
+    const std::string* value = dict.FindString(key);
+    if (value && OneOf(*value, allowed)) {
+      return *value;
+    }
+    if (error.empty()) {
+      error = Err(field, "must be one of " + Listed(allowed));
+    }
+    return std::string();
+  };
+  const std::string primary = one_of(
+      *pointer, "primary", "display.pointer.primary", kPrimaryPointers);
+  const std::string hover =
+      one_of(*pointer, "hover", "display.pointer.hover", kHovers);
+  const std::string color_gamut =
+      one_of(display, "color_gamut", "display.color_gamut", kColorGamuts);
+  const std::string dynamic_range =
+      one_of(display, "dynamic_range", "display.dynamic_range", kDynamicRanges);
+  const std::string color_scheme =
+      one_of(display, "prefers_color_scheme", "display.prefers_color_scheme",
+             kColorSchemes);
+  const std::string reduced_motion =
+      one_of(display, "prefers_reduced_motion",
+             "display.prefers_reduced_motion", kReducedMotions);
+  const std::string contrast = one_of(display, "prefers_contrast",
+                                      "display.prefers_contrast", kContrasts);
+  const std::string forced_colors =
+      one_of(display, "forced_colors", "display.forced_colors", kForcedColors);
+  if (!error.empty()) {
+    return error;
+  }
+
+  const base::ListValue* any_pointer = pointer->FindList("any_pointer");
+  if (!any_pointer) {
+    return Err("display.pointer.any_pointer", "is required and must be a list");
+  }
+  bool fine = false;
+  bool coarse = false;
+  for (const base::Value& entry : *any_pointer) {
+    bool* seen = nullptr;
+    if (entry.is_string() && entry.GetString() == "fine") {
+      seen = &fine;
+    } else if (entry.is_string() && entry.GetString() == "coarse") {
+      seen = &coarse;
+    }
+    if (!seen || *seen) {
+      return Err("display.pointer.any_pointer",
+                 "may only list fine and coarse, each once");
+    }
+    *seen = true;
+  }
+  const base::ListValue* any_hover = pointer->FindList("any_hover");
+  if (!any_hover || any_hover->size() > 1 ||
+      (any_hover->size() == 1 && (!any_hover->front().is_string() ||
+                                  any_hover->front().GetString() != "hover"))) {
+    return Err("display.pointer.any_hover",
+               "must be a list that is empty or holds hover once");
+  }
+  const bool hovers = any_hover->size() == 1;
+  std::optional<int> max_touch_points = hardware.FindInt("max_touch_points");
+  if (!max_touch_points || *max_touch_points < 0 || *max_touch_points > 20) {
+    return Err("hardware.max_touch_points", "must be an integer in [0, 20]");
+  }
+
+  if (dynamic_range == "high" && color_gamut != "p3") {
+    return Err("display.color_gamut",
+               "must be p3 when display.dynamic_range is high: Chrome reports "
+               "every HDR screen as p3");
+  }
+  const bool windows = os_family == "windows";
+  const std::string os_name = windows ? "Windows" : "Linux";
+  if (fine != hovers) {
+    return Err("display.pointer.any_hover",
+               "must hold hover exactly when any_pointer lists fine: on " +
+                   os_name + " a mouse or touchpad gives both");
+  }
+  if (coarse != (*max_touch_points > 0)) {
+    return Err("hardware.max_touch_points",
+               "must be above 0 exactly when display.pointer.any_pointer "
+               "lists coarse: on " +
+                   os_name + " both come from a touchscreen");
+  }
+  const char* derived_primary = fine ? "fine" : coarse ? "coarse" : "none";
+  if (primary != derived_primary) {
+    return Err("display.pointer.primary",
+               std::string("must be ") + derived_primary +
+                   " for this any_pointer: on " + os_name +
+                   " a mouse is primary over a touchscreen");
+  }
+  if ((hover == "hover") != hovers) {
+    return Err("display.pointer.hover",
+               "must be hover exactly when any_hover holds hover");
+  }
+  if (contrast == "less") {
+    return Err("display.prefers_contrast",
+               "cannot be less on " + os_name +
+                   ": only more or no-preference are claimed");
+  }
+  if (forced_colors == "active" && contrast != "more") {
+    return Err("display.prefers_contrast",
+               "must be more when display.forced_colors is active: page "
+               "colors set both");
+  }
+  if (windows && contrast == "more" && forced_colors != "active") {
+    return Err("display.prefers_contrast",
+               "can only be more on Windows when display.forced_colors is "
+               "active: Windows sets prefers-contrast only with forced "
+               "colors");
+  }
+
+  out->primary_pointer = primary;
+  out->primary_hover = hover == "hover";
+  out->any_pointer_fine = fine;
+  out->any_pointer_coarse = coarse;
+  out->any_hover = hovers;
+  out->max_touch_points = *max_touch_points;
+  out->color_gamut = color_gamut;
+  out->high_dynamic_range = dynamic_range == "high";
+  out->prefers_dark = color_scheme == "dark";
+  out->prefers_reduced_motion = reduced_motion == "reduce";
+  out->prefers_contrast = contrast;
+  out->forced_colors = forced_colors == "active";
+  return std::string();
+}
+
+// A value no stock Chrome on the claimed OS reports stops the browser; a
+// value this host cannot back runs, and LoadAndExportFromCommandLine logs it.
+// HEVC is decoded only in hardware (IsDecoderHevcProfileSupported reads the
+// GPU's decoder configs), so media.hevc must equal gpu.hardware_decode.hevc.
+std::string ParseCapabilities(const base::DictValue& dict,
+                              const std::string& os_family,
+                              Profile::HardwareDecode* hardware_decode,
+                              bool* bluetooth_available,
+                              Profile::Capabilities* out) {
+  std::string error;
+  const base::DictValue* decode =
+      dict.FindDict("gpu")->FindDict("hardware_decode");
+  if (!decode) {
+    return Err("gpu.hardware_decode", "is required and must be an object");
+  }
+  struct DecodeField {
+    const char* key;
+    const char* field;
+    bool* out;
+  };
+  for (const DecodeField& f :
+       {DecodeField{"h264", "gpu.hardware_decode.h264", &hardware_decode->h264},
+        DecodeField{"hevc", "gpu.hardware_decode.hevc", &hardware_decode->hevc},
+        DecodeField{"vp9", "gpu.hardware_decode.vp9", &hardware_decode->vp9},
+        DecodeField{"av1", "gpu.hardware_decode.av1", &hardware_decode->av1}}) {
+    std::optional<bool> value = RequireBool(*decode, f.key, f.field, &error);
+    if (!value) {
+      return error;
+    }
+    *f.out = *value;
+  }
+
+  const base::DictValue* media = dict.FindDict("media");
+  std::optional<bool> hevc = RequireBool(*media, "hevc", "media.hevc", &error);
+  if (!hevc) {
+    return error;
+  }
+  std::optional<bool> dolby_audio =
+      RequireBool(*media, "dolby_audio", "media.dolby_audio", &error);
+  if (!dolby_audio) {
+    return error;
+  }
+  const base::Value* playready = media->Find("playready");
+  if (playready && !playready->is_bool()) {
+    return Err("media.playready", "must be a boolean when present");
+  }
+  const base::DictValue* webauthn = dict.FindDict("webauthn");
+  std::optional<bool> uvpaa = RequireBool(
+      *webauthn, "user_verifying_platform_authenticator",
+      "webauthn.user_verifying_platform_authenticator", &error);
+  if (!uvpaa) {
+    return error;
+  }
+  std::optional<bool> conditional_mediation =
+      RequireBool(*webauthn, "conditional_mediation",
+                  "webauthn.conditional_mediation", &error);
+  if (!conditional_mediation) {
+    return error;
+  }
+  const base::DictValue* capabilities = dict.FindDict("capabilities");
+  std::optional<bool> bluetooth = RequireBool(
+      *capabilities, "bluetooth", "capabilities.bluetooth", &error);
+  if (!bluetooth) {
+    return error;
+  }
+  const base::Value* available = capabilities->Find("bluetooth_available");
+  if (available && !available->is_bool()) {
+    return Err("capabilities.bluetooth_available",
+               "must be a boolean when present");
+  }
+  std::optional<bool> web_share = RequireBool(
+      *capabilities, "web_share", "capabilities.web_share", &error);
+  if (!web_share) {
+    return error;
+  }
+  // Absent means the device has no Bluetooth adapter.
+  *bluetooth_available = available && available->GetBool();
+
+  const bool windows = os_family == "windows";
+  struct Claim {
+    const char* field;
+    bool claimed;
+    bool stock;
+    const char* why;
+  };
+  const Claim claims[] = {
+      {"webauthn.conditional_mediation", *conditional_mediation, true,
+       "desktop Chrome always offers conditional mediation"},
+      {"media.dolby_audio", *dolby_audio, false,
+       "desktop Chrome 155 has no AC-3 or E-AC-3 support "
+       "(enable_platform_ac3_eac3_audio is on only for Cast and tvOS)"},
+      {"capabilities.bluetooth", *bluetooth, windows,
+       windows ? "Web Bluetooth is always enabled on Windows"
+               : "Web Bluetooth is not enabled on Linux"},
+      {"capabilities.web_share", *web_share, windows,
+       windows ? "Web Share is always enabled on Windows"
+               : "Web Share is not enabled on Linux"},
+  };
+  for (const Claim& claim : claims) {
+    if (claim.claimed != claim.stock) {
+      return Err(claim.field,
+                 base::StringPrintf(
+                     "is %s but stock Chrome reports %s on %s: %s",
+                     claim.claimed ? "true" : "false",
+                     claim.stock ? "true" : "false",
+                     windows ? "Windows" : "Linux", claim.why));
+    }
+  }
+  if (!windows && playready && playready->GetBool()) {
+    return Err("media.playready",
+               "is true but stock Chrome reports false on Linux: Linux has no "
+               "PlayReady key system");
+  }
+  if (*hevc != hardware_decode->hevc) {
+    return Err("media.hevc",
+               base::StringPrintf(
+                   "is %s but gpu.hardware_decode.hevc is %s: Chrome decodes "
+                   "HEVC only in hardware, so it plays HEVC exactly when it "
+                   "decodes HEVC in hardware",
+                   *hevc ? "true" : "false",
+                   hardware_decode->hevc ? "true" : "false"));
+  }
+  out->user_verifying_platform_authenticator = *uvpaa;
+  out->web_bluetooth = *bluetooth;
+  out->web_share = *web_share;
+  return std::string();
+}
+
+// A count per kind and exactly that many labels: after permission a page
+// sees every label. The virtual default and communications devices are not
+// listed; the browser adds them as the claimed OS's audio manager does.
+std::string ParseMediaDevices(const base::DictValue& devices,
+                              const std::string& os_family,
+                              Profile::MediaDevices* out) {
+  struct Kind {
+    const char* key;
+    int maximum;
+    bool audio;
+    std::vector<std::string>* labels;
+  };
+  const Kind kinds[] = {
+      {"audioinput", 8, true, &out->audio_inputs},
+      {"audiooutput", 8, true, &out->audio_outputs},
+      {"videoinput", 4, false, &out->video_inputs},
+  };
+  const base::DictValue* labels = devices.FindDict("labels");
+  for (const Kind& kind : kinds) {
+    const std::string field = std::string("media_devices.") + kind.key;
+    const std::string labels_field =
+        std::string("media_devices.labels.") + kind.key;
+    std::optional<int> count = devices.FindInt(kind.key);
+    if (!count || *count < 0 || *count > kind.maximum) {
+      return Err(field, base::StringPrintf("must be an integer in [0, %d]",
+                                           kind.maximum));
+    }
+    const base::ListValue* list = labels ? labels->FindList(kind.key) : nullptr;
+    if ((list ? list->size() : 0u) != static_cast<size_t>(*count)) {
+      return Err(labels_field,
+                 base::StringPrintf("must hold one label per device, %d, as "
+                                    "enumerateDevices() reports them after "
+                                    "permission",
+                                    *count));
+    }
+    if (!list) {
+      continue;
+    }
+    for (const base::Value& entry : *list) {
+      if (!entry.is_string() || entry.GetString().empty()) {
+        return Err(labels_field, "entries must be non-empty strings");
+      }
+      const std::string& label = entry.GetString();
+      if (kind.audio &&
+          (label == "Default" ||
+           (os_family == "windows" &&
+            (label == "Communications" ||
+             base::StartsWith(label, "Default - ") ||
+             base::StartsWith(label, "Communications - "))))) {
+        return Err(labels_field,
+                   "lists a virtual default or communications device, which "
+                   "the browser adds itself; list only the real devices");
+      }
+      kind.labels->push_back(entry.GetString());
+    }
+  }
+  return std::string();
+}
