+namespace blink::phasmid_canvas {
+
+namespace {
+
+// Frozen. Every constant and every byte of the hashed messages below decides
+// which pixels a profile changes; changing one re-keys every profile's canvas.
+constexpr std::array<uint8_t, 3> kOpaqueTag = {'o', 'p', '1'};
+constexpr std::array<uint8_t, 3> kAlphaTag = {'a', 'l', '1'};
+
+constexpr size_t kR = 0;
+constexpr size_t kG = 1;
+constexpr size_t kB = 2;
+constexpr size_t kA = 3;
+
+// Channels by name, never by memory order.
+using Rgba = std::array<uint8_t, 4>;
+
+// Bit positions of R, G and B in a 32-bit pixel; alpha is always at 24.
+struct Layout {
+  int r;
+  int g;
+  int b;
+};
+
+std::optional<Layout> LayoutOf(const SkImageInfo& info) {
+  if (info.alphaType() != kPremul_SkAlphaType &&
+      info.alphaType() != kOpaque_SkAlphaType) {
+    return std::nullopt;
+  }
+  switch (info.colorType()) {
+    case kRGBA_8888_SkColorType:
+      return Layout{0, 8, 16};
+    case kBGRA_8888_SkColorType:
+      return Layout{16, 8, 0};
+    default:
+      // Float16 and 10-bit canvases are not noised.
+      return std::nullopt;
+  }
+}
+
+class Pixels {
+ public:
+  Pixels(const SkPixmap& pixmap, const Layout& layout)
+      : pixmap_(pixmap), layout_(layout) {}
+
+  bool Contains(int x, int y) const {
+    return x >= 0 && y >= 0 && x < pixmap_.width() && y < pixmap_.height();
+  }
+
+  Rgba Get(int x, int y) const {
+    const uint32_t v = *pixmap_.addr32(x, y);
+    return {static_cast<uint8_t>(v >> layout_.r),
+            static_cast<uint8_t>(v >> layout_.g),
+            static_cast<uint8_t>(v >> layout_.b),
+            static_cast<uint8_t>(v >> 24)};
+  }
+
+  std::optional<Rgba> Neighbour(int x, int y) const {
+    if (!Contains(x, y)) {
+      return std::nullopt;
+    }
+    return Get(x, y);
+  }
+
+  void Set(int x, int y, const Rgba& p) const {
+    *pixmap_.writable_addr32(x, y) = (uint32_t{p[kR]} << layout_.r) |
+                                     (uint32_t{p[kG]} << layout_.g) |
+                                     (uint32_t{p[kB]} << layout_.b) |
+                                     (uint32_t{p[kA]} << 24);
+  }
+
+ private:
+  const SkPixmap& pixmap_;
+  const Layout layout_;
+};
+
+// The upper 7 bits. N changes only least significant bits, so every value
+// the tests below read is the same before and after N.
+int Q(uint8_t v) {
+  return v >> 1;
+}
+
+// The hashed message: a tag, the pixel's own bits, then the qualifying axes
+// as unordered pairs in sorted order, so that flipping or transposing the
+// neighbourhood hashes the same.
+class Message {
+ public:
+  explicit Message(const std::array<uint8_t, 3>& tag) { Append(tag); }
+
+  template <size_t N>
+  void Append(const std::array<uint8_t, N>& bytes) {
+    for (uint8_t byte : bytes) {
+      bytes_[size_++] = byte;
+    }
+  }
+
+  template <size_t N>
+  void AppendSorted(std::array<uint8_t, N> first,
+                    std::array<uint8_t, N> second) {
+    if (second < first) {
+      std::swap(first, second);
+    }
+    Append(first);
+    Append(second);
+  }
+
+  uint64_t Hash(const ::phasmid::NoiseKey& key) const {
+    return ::phasmid::SipHash24(
+        key, base::span<const uint8_t>(bytes_).first(size_));
+  }
+
+ private:
+  std::array<uint8_t, 18> bytes_ = {};
+  size_t size_ = 0;
+};
+
+// An opaque pixel P qualifies along the axis (A, B) when both neighbours are
+// opaque, P lies between them in every colour channel and on the line from A
+// to B (within rounding), and strictly between them in at least one channel.
+// Returns the strict channels as a bit mask (R = 1, G = 2, B = 4), or 0.
+unsigned OpaqueAxis(const Rgba& p,
+                    const std::optional<Rgba>& a,
+                    const std::optional<Rgba>& b,
+                    std::array<uint8_t, 6>* pair) {
+  if (!a || !b || (*a)[kA] != 255 || (*b)[kA] != 255) {
+    return 0;
+  }
+  std::array<int, 3> qp;
+  std::array<int, 3> qa;
+  std::array<int, 3> qb;
+  unsigned strict = 0;
+  for (size_t c = kR; c <= kB; ++c) {
+    qp[c] = Q(p[c]);
+    qa[c] = Q((*a)[c]);
+    qb[c] = Q((*b)[c]);
+    const int lo = std::min(qa[c], qb[c]);
+    const int hi = std::max(qa[c], qb[c]);
+    if (qp[c] < lo || qp[c] > hi) {
+      return 0;
+    }
+    if (lo < qp[c] && qp[c] < hi) {
+      strict |= 1u << c;
+    }
+  }
+  if (!strict) {
+    return 0;
+  }
+  constexpr std::array<std::pair<size_t, size_t>, 3> kChannelPairs = {
+      {{kR, kG}, {kR, kB}, {kG, kB}}};
+  for (const auto& [c, k] : kChannelPairs) {
+    const int cross = (qp[c] - qa[c]) * (qb[k] - qa[k]) -
+                      (qp[k] - qa[k]) * (qb[c] - qa[c]);
+    if (std::abs(cross) > std::abs(qb[c] - qa[c]) + std::abs(qb[k] - qa[k])) {
+      return 0;
+    }
+  }
+  std::array<uint8_t, 3> ea = {static_cast<uint8_t>(qa[kR]),
+                               static_cast<uint8_t>(qa[kG]),
+                               static_cast<uint8_t>(qa[kB])};
+  std::array<uint8_t, 3> eb = {static_cast<uint8_t>(qb[kR]),
+                               static_cast<uint8_t>(qb[kG]),
+                               static_cast<uint8_t>(qb[kB])};
+  if (eb < ea) {
+    std::swap(ea, eb);
+  }
+  *pair = {ea[0], ea[1], ea[2], eb[0], eb[1], eb[2]};
+  return strict;
+}
+
+// A semi-transparent pixel qualifies along the axis (A, B) when its alpha
+// lies strictly between theirs, in the upper 7 bits.
+bool AlphaAxis(uint8_t alpha,
+               const std::optional<Rgba>& a,
+               const std::optional<Rgba>& b,
+               std::array<uint8_t, 2>* pair) {
+  if (!a || !b) {
+    return false;
+  }
+  const int lo = std::min(Q((*a)[kA]), Q((*b)[kA]));
+  const int hi = std::max(Q((*a)[kA]), Q((*b)[kA]));
+  if (!(lo < Q(alpha) && Q(alpha) < hi)) {
+    return false;
+  }
+  *pair = {static_cast<uint8_t>(lo), static_cast<uint8_t>(hi)};
+  return true;
+}
+
+// Exact integer conversions with round-half-up. Premul(Unpremul(c, a), a) == c
+// for every valid premultiplied c <= a.
+int Unpremul(int c, int a) {
+  return (std::min(c, a) * 510 + a) / (2 * a);
+}
+int Premul(int u, int a) {
+  return (u * a + 127) / 255;
+}
+
+// N at one pixel. Returns true and updates `p` when the pixel changes.
+bool NoisePixel(const ::phasmid::NoiseKey& key,
+                const Pixels& pixels,
+                int x,
+                int y,
+                Rgba* p) {
+  const uint8_t alpha = (*p)[kA];
+  if (alpha == 0) {
+    return false;
+  }
+  const std::optional<Rgba> left = pixels.Neighbour(x - 1, y);
+  const std::optional<Rgba> right = pixels.Neighbour(x + 1, y);
+  const std::optional<Rgba> up = pixels.Neighbour(x, y - 1);
+  const std::optional<Rgba> down = pixels.Neighbour(x, y + 1);
+
+  if (alpha == 255) {
+    std::array<uint8_t, 6> horizontal;
+    std::array<uint8_t, 6> vertical;
+    const unsigned h_strict = OpaqueAxis(*p, left, right, &horizontal);
+    const unsigned v_strict = OpaqueAxis(*p, up, down, &vertical);
+    if (!h_strict && !v_strict) {
+      return false;
+    }
+    Message message(kOpaqueTag);
+    message.Append(std::array<uint8_t, 3>{static_cast<uint8_t>(Q((*p)[kR])),
+                                          static_cast<uint8_t>(Q((*p)[kG])),
+                                          static_cast<uint8_t>(Q((*p)[kB]))});
+    if (h_strict && v_strict) {
+      message.AppendSorted(horizontal, vertical);
+    } else {
+      message.Append(h_strict ? horizontal : vertical);
+    }
+    const uint64_t h = message.Hash(key);
+    if ((h & 3) != 0) {
+      return false;
+    }
+    const unsigned channels = h_strict | v_strict;
+    const int count = std::popcount(channels);
+    int pick = static_cast<int>((h >> 2) % static_cast<uint64_t>(count));
+    size_t channel = kR;
+    for (size_t c = kR; c <= kB; ++c) {
+      if ((channels >> c) & 1u) {
+        if (pick-- == 0) {
+          channel = c;
+          break;
+        }
+      }
+    }
+    const uint8_t value = static_cast<uint8_t>(((*p)[channel] & ~1u) |
+                                               ((h >> 8) & 1u));
+    if (value == (*p)[channel]) {
+      return false;
+    }
+    (*p)[channel] = value;
+    return true;
+  }
+
+  // 0 < alpha < 255: an anti-aliased edge over transparency. The alpha LSB
+  // moves and the colour is re-derived at the new alpha.
+  std::array<uint8_t, 2> horizontal;
+  std::array<uint8_t, 2> vertical;
+  const bool h_axis = AlphaAxis(alpha, left, right, &horizontal);
+  const bool v_axis = AlphaAxis(alpha, up, down, &vertical);
+  if (!h_axis && !v_axis) {
+    return false;
+  }
+  Message message(kAlphaTag);
+  message.Append(std::array<uint8_t, 1>{static_cast<uint8_t>(Q(alpha))});
+  if (h_axis && v_axis) {
+    message.AppendSorted(horizontal, vertical);
+  } else {
+    message.Append(h_axis ? horizontal : vertical);
+  }
+  const uint64_t h = message.Hash(key);
+  if ((h & 3) != 0) {
+    return false;
+  }
+  // Strictly inside (2 * lo + 1, 2 * hi), so 2 <= new_alpha <= 253.
+  const int new_alpha = (alpha & ~1) | static_cast<int>((h >> 8) & 1u);
+  if (new_alpha == alpha) {
+    return false;
+  }
+  for (size_t c = kR; c <= kB; ++c) {
+    (*p)[c] = static_cast<uint8_t>(
+        Premul(Unpremul((*p)[c], alpha), new_alpha));
+  }
+  (*p)[kA] = static_cast<uint8_t>(new_alpha);
+  return true;
+}
+
+const ::phasmid::NoiseKey* Key() {
+  const ::phasmid::Profile* profile = ::phasmid::Profile::Get();
+  if (!profile || !profile->canvas_noise_key()) {
+    return nullptr;
+  }
+  return &*profile->canvas_noise_key();
+}
+
+std::atomic<ProvenanceGetter> g_provenance_getter{nullptr};
+
+}  // namespace
+
+bool IsActive() {
+  return Key() != nullptr;
+}
+
+void SetProvenanceGetter(ProvenanceGetter getter) {
+  g_provenance_getter.store(getter, std::memory_order_release);
+}
+
+int ApplyKernel(const ::phasmid::NoiseKey& key,
+                const SkRegion* region,
+                const SkIPoint& origin,
+                const SkIRect& target,
+                const SkPixmap& pixmap,
+                Vector<SkIPoint>* changed) {
+  const std::optional<Layout> layout = LayoutOf(pixmap.info());
+  SkIRect bounds = target;
+  if (!layout || !bounds.intersect(pixmap.bounds())) {
+    return 0;
+  }
+  const Pixels pixels(pixmap, *layout);
+  int count = 0;
+  // In place: N changes only least significant bits of opaque colour or of
+  // a semi-transparent alpha, never what a neighbour's test reads.
+  auto apply = [&](const SkIRect& rect) {
+    for (int y = rect.top(); y < rect.bottom(); ++y) {
+      for (int x = rect.left(); x < rect.right(); ++x) {
+        Rgba p = pixels.Get(x, y);
+        if (NoisePixel(key, pixels, x, y, &p)) {
+          pixels.Set(x, y, p);
+          ++count;
+          if (changed) {
+            changed->push_back(SkIPoint::Make(x, y));
+          }
+        }
+      }
+    }
+  };
+  if (!region) {
+    apply(bounds);
+    return count;
+  }
+  for (SkRegion::Cliperator it(*region, bounds.makeOffset(origin.x(),
+                                                            origin.y()));
+       !it.done(); it.next()) {
+    apply(it.rect().makeOffset(-origin.x(), -origin.y()));
+  }
+  return count;
+}
+
+scoped_refptr<StaticBitmapImage> NoiseForExport(
+    const CanvasRenderingContext* context,
+    bool is_placeholder,
+    scoped_refptr<StaticBitmapImage> image) {
+  const ::phasmid::NoiseKey* key = Key();
+  if (!image || !key) {
+    return image;
+  }
+  // Null: every pixel is eligible and the content test alone decides.
+  const SkRegion* region = nullptr;
+  if (!is_placeholder) {
+    if (!context) {
+      return image;
+    }
+    if (context->IsRenderingContext2D()) {
+      const ProvenanceGetter getter =
+          g_provenance_getter.load(std::memory_order_acquire);
+      region = getter ? getter(*context) : nullptr;
+      if (!region) {
+        return image;
+      }
+    } else if (!context->IsImageBitmapRenderingContext()) {
+      return image;
+    }
+  }
+  scoped_refptr<StaticBitmapImage> raster = image->MakeUnaccelerated();
+  if (!raster) {
+    return image;
+  }
+  sk_sp<SkImage> source = raster->PaintImageForCurrentFrame().GetSwSkImage();
+  if (!source || !LayoutOf(source->imageInfo())) {
+    return image;
+  }
+  // Same colour type, alpha type and colour space, so the encoders convert
+  // the result exactly as they would have converted `image`.
+  SkBitmap bitmap;
+  if (!bitmap.tryAllocPixels(source->imageInfo()) ||
+      !source->readPixels(bitmap.pixmap(), 0, 0)) {
+    return image;
+  }
+  if (!ApplyKernel(*key, region, SkIPoint::Make(0, 0), bitmap.bounds(),
+                   bitmap.pixmap(), nullptr)) {
+    return image;
+  }
+  bitmap.setImmutable();
+  scoped_refptr<StaticBitmapImage> noised =
+      UnacceleratedStaticBitmapImage::Create(
+          bitmap.asImage(), image->Orientation(), image->GetHdrMetadata());
+  noised->SetOriginClean(image->OriginClean());
+  return noised;
+}
+
+void NoiseImageData(StaticBitmapImage& snapshot,
+                    const SkRegion& region,
+                    const gfx::Rect& rect,
+                    const SkPixmap& dst) {
+  const ::phasmid::NoiseKey* key = Key();
+  if (!key || region.isEmpty()) {
+    return;
+  }
+  PaintImage paint_image = snapshot.PaintImageForCurrentFrame();
+  const SkImageInfo info = paint_image.GetSkImageInfo();
+  SkIRect target = gfx::RectToSkIRect(rect);
+  if (!LayoutOf(info) || !target.intersect(info.bounds())) {
+    return;
+  }
+  // Every target pixel's neighbourhood: one more pixel on each side, inside
+  // the canvas, so a sub-rectangle reads exactly the slice of a full read.
+  SkIRect area = target.makeOutset(1, 1);
+  if (!area.intersect(info.bounds())) {
+    return;
+  }
+  SkBitmap pixels;
+  if (!pixels.tryAllocPixels(info.makeWH(area.width(), area.height())) ||
+      !paint_image.readPixels(pixels.info(), pixels.getPixels(),
+                              pixels.rowBytes(), area.x(), area.y())) {
+    return;
+  }
+  Vector<SkIPoint> changed;
+  if (!ApplyKernel(*key, &region, SkIPoint::Make(area.x(), area.y()),
+                   target.makeOffset(-area.x(), -area.y()), pixels.pixmap(),
+                   &changed)) {
+    return;
+  }
+  // Each changed pixel goes through the same conversion getImageData used,
+  // one pixel at a time.
+  for (const SkIPoint& point : changed) {
+    SkPixmap from;
+    SkPixmap to;
+    if (pixels.pixmap().extractSubset(
+            &from, SkIRect::MakeXYWH(point.x(), point.y(), 1, 1)) &&
+        dst.extractSubset(&to, SkIRect::MakeXYWH(
+                                   point.x() + area.x() - rect.x(),
+                                   point.y() + area.y() - rect.y(), 1, 1))) {
+      from.readPixels(to);
+    }
+  }
+}
