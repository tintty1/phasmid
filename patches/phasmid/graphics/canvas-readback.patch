+namespace blink {
+
+class CanvasRenderingContext;
+class StaticBitmapImage;
+
+// Deterministic canvas readback noise.
+//
+// The page-visible exits of a 2D or bitmaprenderer canvas (getImageData,
+// toDataURL, toBlob, OffscreenCanvas.convertToBlob) apply one function N to
+// the canvas pixels. N at a pixel depends only on the profile's canvas key,
+// the upper 7 bits of the pixel and of its four neighbours, and whether the
+// pixel lies in the context's provenance region (pixels last written by
+// anti-aliased or blending rasterization, kept by modules/canvas). It never
+// depends on the readback rectangle or on coordinates, and N(N(x)) = N(x),
+// so every exit and every round trip through put, decode or drawImage agrees.
+// Nothing on screen changes: only the exits call into this file.
+namespace phasmid_canvas {
+
+// True when the profile turns canvas noise on (canvas.noise).
+CORE_EXPORT bool IsActive();
+
+// Returns the provenance region of a 2D context, in canvas pixels. Registered
+// once by modules (which own the 2D context classes) before any canvas exists.
+using ProvenanceGetter = const SkRegion* (*)(const CanvasRenderingContext&);
+CORE_EXPORT void SetProvenanceGetter(ProvenanceGetter getter);
+
+// toDataURL, toBlob and convertToBlob: returns `image` itself unless noise
+// is on and changes a pixel. A transferControlToOffscreen placeholder
+// (`is_placeholder`) has no reachable region and uses the content test alone;
+// WebGL and WebGPU canvases are never noised.
+CORE_EXPORT scoped_refptr<StaticBitmapImage> NoiseForExport(
+    const CanvasRenderingContext* context,
+    bool is_placeholder,
+    scoped_refptr<StaticBitmapImage> image);
+
+// getImageData: rewrites the pixels of `dst`, which holds `rect` of
+// `snapshot` as read by getImageData, that N changes. Unchanged pixels keep
+// the bytes the stock conversion produced.
+CORE_EXPORT void NoiseImageData(StaticBitmapImage& snapshot,
+                                const SkRegion& region,
+                                const gfx::Rect& rect,
+                                const SkPixmap& dst);
+
+// The kernel. Applies N in place to the pixels of `target` in `pixels`
+// (premultiplied or opaque RGBA or BGRA 8888; pixels outside `pixels` are
+// absent neighbours). `origin` is the canvas position of pixel (0, 0); a
+// non-null `region` restricts N to the canvas pixels it contains. Returns the
+// number of pixels changed and appends their positions to `changed`.
+CORE_EXPORT int ApplyKernel(const ::phasmid::NoiseKey& key,
+                            const SkRegion* region,
+                            const SkIPoint& origin,
+                            const SkIRect& target,
+                            const SkPixmap& pixels,
+                            Vector<SkIPoint>* changed);
+
+}  // namespace phasmid_canvas
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_CANVAS_PHASMID_READBACK_NOISE_H_
