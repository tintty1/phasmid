+namespace blink {
+namespace {
+
+// The key the example profile derives for canvas noise (noise_unittest.cc).
+constexpr ::phasmid::NoiseKey kKey = {0x76f2fb5423fa0ba9ULL,
+                                      0x312d93be81a91a51ULL};
+constexpr ::phasmid::NoiseKey kOtherKey = {0x1111, 0x2222};
+
+SkBitmap Copy(const SkBitmap& source) {
+  SkBitmap copy;
+  copy.allocPixels(source.info());
+  EXPECT_TRUE(source.pixmap().readPixels(copy.pixmap()));
+  return copy;
+}
+
+// Anti-aliased circles over an opaque or a transparent background: edges
+// that blend two colours, and alpha ramps.
+SkBitmap Scene(bool opaque) {
+  SkBitmap bitmap;
+  bitmap.allocPixels(SkImageInfo::MakeN32Premul(97, 61));
+  SkCanvas canvas(bitmap);
+  canvas.clear(opaque ? SK_ColorWHITE : SK_ColorTRANSPARENT);
+  SkPaint paint;
+  paint.setAntiAlias(true);
+  paint.setColor(SkColorSetARGB(255, 255, 102, 0));
+  canvas.drawCircle(30.3f, 28.7f, 20.2f, paint);
+  paint.setColor(SkColorSetARGB(opaque ? 255 : 179, 0, 102, 153));
+  canvas.drawCircle(55.1f, 33.4f, 17.9f, paint);
+  paint.setColor(SkColorSetARGB(179, 102, 204, 0));
+  canvas.drawCircle(70.6f, 20.2f, 12.3f, paint);
+  return bitmap;
+}
+
+int Apply(const ::phasmid::NoiseKey& key,
+          SkBitmap& bitmap,
+          const SkRegion* region = nullptr) {
+  return phasmid_canvas::ApplyKernel(key, region, SkIPoint::Make(0, 0),
+                                     bitmap.bounds(), bitmap.pixmap(),
+                                     nullptr);
+}
+
+bool SamePixels(const SkBitmap& a, const SkBitmap& b) {
+  if (a.dimensions() != b.dimensions()) {
+    return false;
+  }
+  for (int y = 0; y < a.height(); ++y) {
+    for (int x = 0; x < a.width(); ++x) {
+      if (*a.getAddr32(x, y) != *b.getAddr32(x, y)) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// The alpha branch re-derives colour at a new alpha, and getImageData -> putImageData -> getImageData stays stable only
+// if Skia's 8-bit premultiply undoes its unpremultiply for every valid pixel.
+TEST(PhasmidReadbackNoiseTest, SkiaPremulRoundTripIsIdentity) {
+  for (SkColorType color_type : {kRGBA_8888_SkColorType,
+                                 kBGRA_8888_SkColorType}) {
+    for (int a = 0; a < 256; ++a) {
+      // One row holds every valid c <= a, so the SIMD bodies run too.
+      const int width = a + 1;
+      SkBitmap premul;
+      premul.allocPixels(SkImageInfo::Make(width, 1, color_type,
+                                           kPremul_SkAlphaType,
+                                           SkColorSpace::MakeSRGB()));
+      for (int c = 0; c <= a; ++c) {
+        *premul.getAddr32(c, 0) = static_cast<uint32_t>(a) << 24 |
+                                  static_cast<uint32_t>(c) << 16 |
+                                  static_cast<uint32_t>(a - c) << 8 |
+                                  static_cast<uint32_t>(c / 2);
+      }
+      SkBitmap unpremul;
+      unpremul.allocPixels(premul.info()
+                               .makeColorType(kRGBA_8888_SkColorType)
+                               .makeAlphaType(kUnpremul_SkAlphaType));
+      ASSERT_TRUE(premul.pixmap().readPixels(unpremul.pixmap()));
+      SkBitmap again;
+      again.allocPixels(premul.info());
+      ASSERT_TRUE(unpremul.pixmap().readPixels(again.pixmap()));
+      for (int c = 0; c <= a; ++c) {
+        ASSERT_EQ(*premul.getAddr32(c, 0), *again.getAddr32(c, 0))
+            << "alpha " << a << " colour " << c;
+      }
+    }
+  }
+}
+
+TEST(PhasmidReadbackNoiseTest, KernelIsIdempotent) {
+  for (bool opaque : {true, false}) {
+    SkBitmap noised = Scene(opaque);
+    EXPECT_GT(Apply(kKey, noised), 0) << opaque;
+    SkBitmap twice = Copy(noised);
+    EXPECT_EQ(Apply(kKey, twice), 0) << opaque;
+    EXPECT_TRUE(SamePixels(noised, twice)) << opaque;
+  }
+}
+
+TEST(PhasmidReadbackNoiseTest, SubRectangleMatchesFullRead) {
+  const SkBitmap scene = Scene(true);
+  SkBitmap full = Copy(scene);
+  Apply(kKey, full);
+  for (const SkIRect& target :
+       {SkIRect::MakeXYWH(20, 20, 50, 40), SkIRect::MakeXYWH(0, 0, 1, 1),
+        SkIRect::MakeXYWH(9, 8, 1, 1), SkIRect::MakeXYWH(40, 10, 57, 51)}) {
+    // As NoiseImageData reads: the target plus one pixel, inside the canvas.
+    SkIRect area = target.makeOutset(1, 1);
+    ASSERT_TRUE(area.intersect(scene.bounds()));
+    SkBitmap part;
+    part.allocPixels(scene.info().makeWH(area.width(), area.height()));
+    ASSERT_TRUE(scene.pixmap().readPixels(part.pixmap(), area.x(), area.y()));
+    phasmid_canvas::ApplyKernel(kKey, nullptr,
+                                SkIPoint::Make(area.x(), area.y()),
+                                target.makeOffset(-area.x(), -area.y()),
+                                part.pixmap(), nullptr);
+    for (int y = target.top(); y < target.bottom(); ++y) {
+      for (int x = target.left(); x < target.right(); ++x) {
+        ASSERT_EQ(*full.getAddr32(x, y),
+                  *part.getAddr32(x - area.x(), y - area.y()))
+            << x << "," << y;
+      }
+    }
+  }
+}
+
+TEST(PhasmidReadbackNoiseTest, TranslationAndFlipInvariant) {
+  const SkBitmap scene = Scene(true);
+  SkBitmap noised = Copy(scene);
+  Apply(kKey, noised);
+
+  SkBitmap moved;
+  moved.allocPixels(scene.info().makeWH(scene.width() + 20,
+                                        scene.height() + 15));
+  moved.eraseColor(SK_ColorWHITE);
+  SkBitmap flipped;
+  flipped.allocPixels(scene.info());
+  for (int y = 0; y < scene.height(); ++y) {
+    for (int x = 0; x < scene.width(); ++x) {
+      *moved.getAddr32(x + 7, y + 5) = *scene.getAddr32(x, y);
+      *flipped.getAddr32(scene.width() - 1 - x, y) = *scene.getAddr32(x, y);
+    }
+  }
+  Apply(kKey, moved);
+  Apply(kKey, flipped);
+  for (int y = 0; y < scene.height(); ++y) {
+    for (int x = 0; x < scene.width(); ++x) {
+      ASSERT_EQ(*flipped.getAddr32(scene.width() - 1 - x, y),
+                *noised.getAddr32(x, y));
+      // The copied rectangle's 1-pixel border sees other neighbours.
+      if (x > 0 && y > 0 && x < scene.width() - 1 && y < scene.height() - 1) {
+        ASSERT_EQ(*moved.getAddr32(x + 7, y + 5), *noised.getAddr32(x, y));
+      }
+    }
+  }
+}
+
+TEST(PhasmidReadbackNoiseTest, ExactPixelsAreNeverChanged) {
+  SkBitmap uniform;
+  uniform.allocPixels(SkImageInfo::MakeN32Premul(40, 30));
+  uniform.eraseColor(SkColorSetARGB(255, 12, 200, 99));
+  EXPECT_EQ(Apply(kKey, uniform), 0);
+  uniform.eraseColor(SK_ColorTRANSPARENT);
+  EXPECT_EQ(Apply(kKey, uniform), 0);
+
+  SkBitmap scene = Scene(true);
+  const SkRegion empty;
+  EXPECT_EQ(Apply(kKey, scene, &empty), 0);
+}
+
+TEST(PhasmidReadbackNoiseTest, KeysSelectDifferentPixels) {
+  SkBitmap first = Scene(false);
+  SkBitmap second = Scene(false);
+  Apply(kKey, first);
+  Apply(kOtherKey, second);
+  EXPECT_FALSE(SamePixels(first, second));
+}
