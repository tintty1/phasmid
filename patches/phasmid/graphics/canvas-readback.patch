+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_PHASMID_READBACK_PROVENANCE_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_CANVAS_CANVAS2D_PHASMID_READBACK_PROVENANCE_H_
+
+#include "base/memory/stack_allocated.h"
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/platform/wtf/allocator/allocator.h"
+#include "third_party/skia/include/core/SkRegion.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace gfx {
+class RectF;
+}
+
+namespace blink {
+
+class CanvasImageSource;
+class CanvasRenderingContext;
+class CanvasRenderingContext2DState;
+class Image;
+
+// The pixels of a 2D context last written by anti-aliased or blending
+// rasterization, in canvas pixels. Readback noise
+// (core/html/canvas/phasmid_readback_noise.h) applies only inside this
+// region, so pixels written exactly read back exactly: putImageData, a
+// pixel-aligned solid fillRect or clearRect, a 1:1 drawImage of a decoded
+// image. A 1:1 drawImage of another 2D canvas copies that canvas's region.
+// Without canvas noise in the profile nothing is ever recorded.
+class MODULES_EXPORT PhasmidReadbackProvenance final {
+  DISALLOW_NEW();
+
+ public:
+  // What one draw call does to the region. kRasterized leaves it to
+  // WillDraw, which adds the dirty rectangle.
+  struct Op {
+    enum class Kind { kRasterized, kExact, kRasterizedRect, kCopy };
+    Kind kind = Kind::kRasterized;
+    gfx::Rect rect;
+    gfx::Rect source_rect;
+    const PhasmidReadbackProvenance* source = nullptr;
+  };
+
+  // Records `op` once the draw call it wraps has run. While it lives,
+  // WillDraw adds nothing.
+  class Scope {
+    STACK_ALLOCATED();
+
+   public:
+    Scope(PhasmidReadbackProvenance& provenance, const Op& op);
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+    ~Scope();
+
+   private:
+    PhasmidReadbackProvenance& provenance_;
+    const Op op_;
+  };
+
+  PhasmidReadbackProvenance();
+
+  const SkRegion& region() const { return region_; }
+
+  // WillDraw: `dirty_rect`, outset by one pixel for anti-aliasing, was
+  // rasterized.
+  void Rasterized(const gfx::Rect& dirty_rect);
+  // reset() and resizing clear the canvas.
+  void Reset();
+
+  Op ForFillRect(const CanvasRenderingContext2DState& state,
+                 const gfx::RectF& rect) const;
+  Op ForClearRect(const CanvasRenderingContext2DState& state,
+                  const gfx::RectF& rect) const;
+  Op ForDrawImage(const CanvasRenderingContext2DState& state,
+                  CanvasImageSource* image_source,
+                  const Image* image,
+                  const gfx::RectF& src_rect,
+                  const gfx::RectF& dst_rect) const;
+  Op ForPutImageData(const gfx::Rect& dest_rect) const;
+
+  // The region of a 2D context, or null for any other context. Registered
+  // with core as phasmid_canvas::ProvenanceGetter.
+  static const SkRegion* RegionOf(const CanvasRenderingContext& context);
+
+ private:
+  static const PhasmidReadbackProvenance* Of(
+      const CanvasRenderingContext* context);
+  void Add(const gfx::Rect& rect);
+  void Apply(const Op& op);
+
+  SkRegion region_;
+  const bool active_;
+  int suppressed_ = 0;
+};
