+#include "third_party/blink/renderer/modules/canvas/canvas2d/phasmid_readback_provenance.h"
+
+#include <optional>
+
+#include "third_party/blink/renderer/core/html/canvas/canvas_image_source.h"
+#include "third_party/blink/renderer/core/html/canvas/canvas_rendering_context.h"
+#include "third_party/blink/renderer/core/html/canvas/canvas_rendering_context_host.h"
+#include "third_party/blink/renderer/core/html/canvas/phasmid_readback_noise.h"
+#include "third_party/blink/renderer/modules/canvas/canvas2d/base_rendering_context_2d.h"
+#include "third_party/blink/renderer/modules/canvas/canvas2d/canvas_rendering_context_2d_state.h"
+#include "third_party/blink/renderer/modules/canvas/canvas2d/canvas_style.h"
+#include "third_party/blink/renderer/platform/graphics/image.h"
+#include "third_party/blink/renderer/platform/transforms/affine_transform.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/rect_f.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+
+namespace blink {
+
+namespace {
+
+// Past this many rectangles the region collapses to its bounds. A larger
+// region only makes more pixels eligible, and eligible pixels still have to
+// pass the kernel's content test.
+constexpr int kMaxRegionComplexity = 256;
+
+// The canvas pixels `rect` covers when the transform moves it by whole pixels
+// onto whole pixels and no clip can anti-alias its edges.
+std::optional<gfx::Rect> AlignedDeviceRect(
+    const CanvasRenderingContext2DState& state,
+    const gfx::RectF& rect) {
+  if (!state.IsTransformInvertible() || state.HasClip() ||
+      !state.GetTransform().IsIdentityOrTranslation()) {
+    return std::nullopt;
+  }
+  const gfx::RectF mapped = state.GetTransform().MapRect(rect);
+  const gfx::Rect device = gfx::ToEnclosedRect(mapped);
+  if (device.IsEmpty() || gfx::RectF(device) != mapped) {
+    return std::nullopt;
+  }
+  return device;
+}
+
+bool HasShadowOrFilter(const CanvasRenderingContext2DState& state) {
+  return state.ShouldDrawShadows() || state.IsFilterUnresolved() ||
+         state.IsFilterResolved();
+}
+
+}  // namespace
+
+PhasmidReadbackProvenance::Scope::Scope(PhasmidReadbackProvenance& provenance,
+                                        const Op& op)
+    : provenance_(provenance), op_(op) {
+  if (op_.kind != Op::Kind::kRasterized) {
+    ++provenance_.suppressed_;
+  }
+}
+
+PhasmidReadbackProvenance::Scope::~Scope() {
+  if (op_.kind != Op::Kind::kRasterized) {
+    --provenance_.suppressed_;
+    provenance_.Apply(op_);
+  }
+}
+
+PhasmidReadbackProvenance::PhasmidReadbackProvenance()
+    : active_(phasmid_canvas::IsActive()) {}
+
+void PhasmidReadbackProvenance::Rasterized(const gfx::Rect& dirty_rect) {
+  if (active_ && !suppressed_) {
+    Add(dirty_rect);
+  }
+}
+
+void PhasmidReadbackProvenance::Reset() {
+  region_.setEmpty();
+}
+
+PhasmidReadbackProvenance::Op PhasmidReadbackProvenance::ForFillRect(
+    const CanvasRenderingContext2DState& state,
+    const gfx::RectF& rect) const {
+  if (!active_ || HasShadowOrFilter(state) ||
+      state.FillStyle().GetCanvasGradient() ||
+      state.FillStyle().GetCanvasPattern()) {
+    return Op();
+  }
+  // A solid colour: each pixel is a function of its own old value only.
+  // globalAlpha and the composite operation do not blend neighbours.
+  const std::optional<gfx::Rect> device = AlignedDeviceRect(state, rect);
+  if (!device) {
+    return Op();
+  }
+  return Op{Op::Kind::kExact, *device};
+}
+
+PhasmidReadbackProvenance::Op PhasmidReadbackProvenance::ForClearRect(
+    const CanvasRenderingContext2DState& state,
+    const gfx::RectF& rect) const {
+  if (!active_) {
+    return Op();
+  }
+  // clearRect ignores shadows, filters, globalAlpha and compositing.
+  if (const std::optional<gfx::Rect> device = AlignedDeviceRect(state, rect)) {
+    return Op{Op::Kind::kExact, *device};
+  }
+  // Only the cleared rectangle's edges are anti-aliased, not the whole clip
+  // that WillDraw reports.
+  return Op{Op::Kind::kRasterizedRect,
+            gfx::ToEnclosingRect(state.GetTransform().MapRect(rect))};
+}
+
+PhasmidReadbackProvenance::Op PhasmidReadbackProvenance::ForDrawImage(
+    const CanvasRenderingContext2DState& state,
+    CanvasImageSource* image_source,
+    const Image* image,
+    const gfx::RectF& src_rect,
+    const gfx::RectF& dst_rect) const {
+  if (!active_ || HasShadowOrFilter(state) ||
+      src_rect.size() != dst_rect.size() ||
+      gfx::RectF(gfx::ToEnclosedRect(src_rect)) != src_rect) {
+    return Op();
+  }
+  const std::optional<gfx::Rect> device = AlignedDeviceRect(state, dst_rect);
+  if (!device) {
+    return Op();
+  }
+  if (image_source->IsCanvasElement() || image_source->IsOffscreenCanvas()) {
+    // A 2D canvas copied pixel for pixel keeps its provenance. Any other
+    // canvas (WebGL, WebGPU, bitmaprenderer, a placeholder) is rasterized.
+    const PhasmidReadbackProvenance* source =
+        Of(static_cast<CanvasRenderingContextHost*>(image_source)
+               ->RenderingContext());
+    if (!source) {
+      return Op();
+    }
+    return Op{Op::Kind::kCopy, *device, gfx::ToEnclosedRect(src_rect),
+              source};
+  }
+  // Decoded pixels drawn 1:1. SVG images are rasterized vector content, and
+  // an ImageBitmap's origin is not tracked, so both stay rasterized.
+  if ((image_source->IsImageElement() && image && image->IsBitmapImage()) ||
+      image_source->IsVideoElement() || image_source->IsVideoFrame()) {
+    return Op{Op::Kind::kExact, *device};
+  }
+  return Op();
+}
+
+PhasmidReadbackProvenance::Op PhasmidReadbackProvenance::ForPutImageData(
+    const gfx::Rect& dest_rect) const {
+  if (!active_) {
+    return Op();
+  }
+  return Op{Op::Kind::kExact, dest_rect};
+}
+
+// static
+const SkRegion* PhasmidReadbackProvenance::RegionOf(
+    const CanvasRenderingContext& context) {
+  const PhasmidReadbackProvenance* provenance = Of(&context);
+  return provenance ? &provenance->region_ : nullptr;
+}
+
+// static
+const PhasmidReadbackProvenance* PhasmidReadbackProvenance::Of(
+    const CanvasRenderingContext* context) {
+  // Every 2D context, on a canvas element or an OffscreenCanvas, is a
+  // BaseRenderingContext2D.
+  if (!context || !context->IsRenderingContext2D()) {
+    return nullptr;
+  }
+  return &static_cast<const BaseRenderingContext2D*>(context)
+              ->phasmid_provenance();
+}
+
+void PhasmidReadbackProvenance::Add(const gfx::Rect& rect) {
+  gfx::Rect outset = rect;
+  outset.Outset(1);
+  region_.op(gfx::RectToSkIRect(outset), SkRegion::kUnion_Op);
+  if (region_.computeRegionComplexity() > kMaxRegionComplexity) {
+    region_.setRect(region_.getBounds());
+  }
+}
+
+void PhasmidReadbackProvenance::Apply(const Op& op) {
+  switch (op.kind) {
+    case Op::Kind::kRasterized:
+      return;
+    case Op::Kind::kExact:
+      region_.op(gfx::RectToSkIRect(op.rect), SkRegion::kDifference_Op);
+      return;
+    case Op::Kind::kRasterizedRect:
+      Add(op.rect);
+      return;
+    case Op::Kind::kCopy: {
+      // Read the source first: it may be this canvas.
+      SkRegion copied(op.source->region_);
+      copied.op(gfx::RectToSkIRect(op.source_rect), SkRegion::kIntersect_Op);
+      copied.translate(op.rect.x() - op.source_rect.x(),
+                       op.rect.y() - op.source_rect.y());
+      region_.op(gfx::RectToSkIRect(op.rect), SkRegion::kDifference_Op);
+      region_.op(copied, SkRegion::kUnion_Op);
+      if (region_.computeRegionComplexity() > kMaxRegionComplexity) {
+        region_.setRect(region_.getBounds());
+      }
+      return;
+    }
+  }
+}
+
