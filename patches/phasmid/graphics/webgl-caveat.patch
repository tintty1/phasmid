Phasmid: WebGL performance caveat on the SwiftShader fallback

What:     With a profile claiming a hardware ANGLE backend,
          getContext("webgl"/"webgl2", {failIfMajorPerformanceCaveat: true})
          returns a context when WebGL falls back to SwiftShader because the
          host has no usable GPU, instead of null. Hosts with a usable GPU,
          headless, swiftshader profiles and no profile are unchanged.
Why:      The claimed hardware GPU creates this context; refusing it
          contradicts the profile's renderer in one cheap call.
Profile:  gpu.angle_backend
Hooks:    gpu/ipc/service/gles2_command_buffer_stub.cc
          (GLES2CommandBufferStub::Initialize); gpu/ipc/service/BUILD.gn
Contexts: main, cross-origin iframe, dedicated worker (OffscreenCanvas)
Guard:    tests/guards/graphics/webgl-caveat.py

--- a/gpu/ipc/service/gles2_command_buffer_stub.cc
+++ b/gpu/ipc/service/gles2_command_buffer_stub.cc
@@ -19,6 +19,7 @@
 #include "base/time/time.h"
 #include "base/trace_event/trace_event.h"
 #include "build/build_config.h"
+#include "components/phasmid/profile.h"
 #include "gpu/command_buffer/common/constants.h"
 #include "gpu/command_buffer/common/mailbox.h"
 #include "gpu/command_buffer/common/swap_buffers_flags.h"
@@ -114,7 +115,13 @@
         (useANGLE == gl::kANGLEImplementationSwiftShaderForWebGLName ||
          useANGLE == gl::kANGLEImplementationD3D11WarpForWebGLName);
 
-    if (is_software_webgl) {
+    // Phasmid: software WebGL under a hardware GPU claim means the host has
+    // no usable GPU; the claimed device would create this context.
+    const phasmid::Profile* profile = phasmid::Profile::Get();
+    const bool claims_hardware_gpu =
+        profile && profile->gpu().angle_backend != "swiftshader";
+
+    if (is_software_webgl && !claims_hardware_gpu) {
       LOG(ERROR) << "ContextResult::kFatalFailure: "
                     "fail_if_major_perf_caveat + software gl";
       return gpu::ContextResult::kFatalFailure;
