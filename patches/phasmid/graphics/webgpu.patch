+// Dawn's limit classes (dawn/native/Limits.h): a maximum is better when
+// higher, an alignment when lower.
+enum class LimitClass { kMaximum, kAlignment };
+
+// One GPUSupportedLimits entry and where it lives: a uint32_t or uint64_t
+// member of WGPULimits, or a member of the chained
+// WGPUCompatibilityModeLimits.
+struct LimitRow {
+  const char* name;
+  uint32_t WGPULimits::* u32 = nullptr;
+  uint64_t WGPULimits::* u64 = nullptr;
+  uint32_t WGPUCompatibilityModeLimits::* compat = nullptr;
+  LimitClass limit_class = LimitClass::kMaximum;
+};
+
+// Every limit Blink exposes, in the order Dawn validates required limits
