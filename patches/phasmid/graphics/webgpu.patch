+// Every feature WebGPUDecoderImpl::IsFeatureExposed can expose, so a listed
+// name maps to Dawn's enum even where the backing adapter lacks it.
+constexpr wgpu::FeatureName kWebFeatures[] = {
+    wgpu::FeatureName::CoreFeaturesAndLimits,
+    wgpu::FeatureName::DepthClipControl,
+    wgpu::FeatureName::Depth32FloatStencil8,
+    wgpu::FeatureName::TextureCompressionBC,
+    wgpu::FeatureName::TextureCompressionBCSliced3D,
