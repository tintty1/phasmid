+
+// The active profile's gpu.webgpu when it claims an adapter, else null.
+const phasmid::Profile::WebGPU* ClaimedAdapter() {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile || !profile->webgpu().available) {
+    return nullptr;
+  }
+  return &profile->webgpu();
+}
+
+const WGPUCompatibilityModeLimits* FindCompat(const WGPULimits* limits) {
+  for (const WGPUChainedStruct* chain = limits->nextInChain; chain;
+       chain = chain->next) {
+    if (chain->sType == WGPUSType_CompatibilityModeLimits) {
+      return reinterpret_cast<const WGPUCompatibilityModeLimits*>(chain);
+    }
+  }
+  return nullptr;
+}
+
+// The row's value, or nullopt when it is undefined or lives in a chained
+// struct `limits` does not carry.
+std::optional<uint64_t> Read(const LimitRow& row,
+                             const WGPULimits& limits,
+                             const WGPUCompatibilityModeLimits* compat) {
+  if (row.u64) {
+    const uint64_t value = limits.*row.u64;
+    return value == WGPU_LIMIT_U64_UNDEFINED ? std::nullopt
+                                             : std::optional<uint64_t>(value);
+  }
+  if (!row.u32 && !compat) {
+    return std::nullopt;
+  }
+  const uint32_t value = row.u32 ? limits.*row.u32 : compat->*row.compat;
+  return value == WGPU_LIMIT_U32_UNDEFINED ? std::nullopt
+                                           : std::optional<uint64_t>(value);
+}
+
+void Write(const LimitRow& row,
+           uint64_t value,
+           WGPULimits* limits,
+           WGPUCompatibilityModeLimits* compat) {
+  if (row.u64) {
+    limits->*row.u64 = value;
+  } else if (row.u32) {
+    limits->*row.u32 = base::saturated_cast<uint32_t>(value);
+  } else if (compat) {
+    compat->*row.compat = base::saturated_cast<uint32_t>(value);
+  }
+}
+
+// Whether `a` is a better limit than `b` (dawn/native/Limits.h IsBetter).
+bool IsBetter(const LimitRow& row, uint64_t a, uint64_t b) {
+  return row.limit_class == LimitClass::kMaximum ? a > b : a < b;
+}
+
+// Dawn frees adapter info strings with delete[]
+// (APIAdapterInfoFreeMembers), so the replacement is allocated with new[].
+void ReplaceString(WGPUStringView* view, const std::string& value) {
+  delete[] view->data;
+  char* copy = new char[value.size()];
+  std::ranges::copy(value, copy);
+  *view = {copy, value.size()};
+}
+
+// Subgroup sizes are readable from WGSL, so a claim must equal the host's.
+void ClaimSubgroupSize(std::string_view field,
+                       uint32_t claim,
+                       uint32_t* value) {
+  if (*value != claim) {
+    phasmid::ReportUnbackedGpuClaim(
+        field, base::StrCat({"profile ", base::NumberToString(claim),
+                             ", host ", base::NumberToString(*value)}));
+  }
+  *value = claim;
+}
+
+// Whether Dawn's `feature` is the one WebGPU calls `name`. Dawn's FeatureInfo
+// names come from dawn.json and differ from the WebGPU names in hyphens
+// only: "float32filterable" is "float32-filterable".
+bool IsFeatureNamed(wgpu::FeatureName feature, std::string_view name) {
+  const dawn::native::FeatureInfo* info = dawn::native::GetFeatureInfo(feature);
+  if (!info) {
+    return false;
+  }
+  std::string dawn_key;
+  std::string key;
+  base::RemoveChars(info->name, "-", &dawn_key);
+  base::RemoveChars(name, "-", &key);
+  return dawn_key == key;
+}
+
+}  // namespace
+
+bool PhasmidWebGPUAvailable() {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  return !profile || profile->webgpu().available;
+}
+
+bool PhasmidAllowsFallbackAdapter() {
+  return ClaimedAdapter() != nullptr;
+}
+
+bool PhasmidFeatureListed(wgpu::FeatureName feature) {
+  const phasmid::Profile::WebGPU* claimed = ClaimedAdapter();
+  if (!claimed) {
+    return true;
+  }
+  return std::ranges::any_of(claimed->features,
+                             [feature](const std::string& name) {
+                               return IsFeatureNamed(feature, name);
+                             });
+}
+
+void PhasmidClaimFeatures(std::vector<wgpu::FeatureName>* exposed) {
+  const phasmid::Profile::WebGPU* claimed = ClaimedAdapter();
+  if (!claimed) {
+    return;
+  }
+  std::vector<wgpu::FeatureName> features;
+  for (const std::string& name : claimed->features) {
+    const wgpu::FeatureName* known = std::ranges::find_if(
+        kWebFeatures, [&name](wgpu::FeatureName feature) {
+          return IsFeatureNamed(feature, name);
+        });
+    if (known == std::end(kWebFeatures)) {
+      phasmid::ReportUnbackedGpuClaim(
+          base::StrCat({"webgpu.features.", name}),
+          "not a feature this build exposes; left out");
+      continue;
+    }
+    features.push_back(*known);
+    if (!std::ranges::contains(*exposed, *known)) {
+      phasmid::ReportUnbackedGpuClaim(
+          base::StrCat({"webgpu.features.", name}),
+          "not exposed by the host adapter; listed, and requestDevice() "
+          "requiring it fails");
+    }
+  }
+  *exposed = std::move(features);
+}
+
+bool PhasmidFeatureBacked(wgpu::Adapter adapter, wgpu::FeatureName feature) {
+  return !ClaimedAdapter() || adapter.HasFeature(feature);
+}
+
+WGPUStatus PhasmidAdapterGetInfo(WGPUAdapter adapter, WGPUAdapterInfo* info) {
+  const WGPUStatus status =
+      dawn::native::GetProcs().adapterGetInfo(adapter, info);
+  const phasmid::Profile::WebGPU* claimed = ClaimedAdapter();
+  if (!claimed || status != WGPUStatus_Success) {
+    return status;
+  }
+  ReplaceString(&info->vendor, claimed->vendor);
+  ReplaceString(&info->architecture, claimed->architecture);
+  ReplaceString(&info->device, claimed->device);
+  ReplaceString(&info->description, claimed->description);
+  info->vendorID = phasmid::Profile::Get()->gpu().vendor_id;
+  info->deviceID = phasmid::Profile::Get()->gpu().device_id;
+  ClaimSubgroupSize("webgpu.subgroup_min_size", claimed->subgroup_min_size,
+                    &info->subgroupMinSize);
+  ClaimSubgroupSize("webgpu.subgroup_max_size", claimed->subgroup_max_size,
+                    &info->subgroupMaxSize);
+  // The adapter type stays the host's (the renderer's swap buffers need it
+  // for the fallback); Blink reports isFallbackAdapter false for a profile,
+  // which never claims a fallback adapter.
+  if (info->adapterType == WGPUAdapterType_CPU) {
+    phasmid::ReportUnbackedGpuClaim(
+        "webgpu.adapter",
+        "no hardware adapter on this host; the SwiftShader fallback backs "
+        "the claim");
+  }
+  return status;
+}
+
+WGPUStatus PhasmidAdapterGetLimits(WGPUAdapter adapter, WGPULimits* limits) {
+  const WGPUStatus status =
+      dawn::native::GetProcs().adapterGetLimits(adapter, limits);
+  const phasmid::Profile::WebGPU* claimed = ClaimedAdapter();
+  if (!claimed || status != WGPUStatus_Success) {
+    return status;
+  }
+  WGPUCompatibilityModeLimits* compat =
+      const_cast<WGPUCompatibilityModeLimits*>(FindCompat(limits));
+  for (const LimitRow& row : kLimits) {
+    const std::optional<uint64_t> claim = claimed->Limit(row.name);
+    CHECK(claim) << "Phasmid: gpu.webgpu.limits." << row.name
+                 << " is not validated";
+    const std::optional<uint64_t> host = Read(row, *limits, compat);
+    if (host && IsBetter(row, *claim, *host)) {
+      phasmid::ReportUnbackedGpuClaim(
+          base::StrCat({"webgpu.limits.", row.name}),
+          base::StrCat({"profile ", base::NumberToString(*claim), ", host ",
+                        base::NumberToString(*host)}));
+    }
+    Write(row, *claim, limits, compat);
+  }
+  return status;
+}
+
+std::string PhasmidCheckRequiredLimits(WGPUAdapter adapter,
+                                       const WGPULimits* required) {
+  const phasmid::Profile::WebGPU* claimed = ClaimedAdapter();
+  if (!claimed || !required) {
+    return std::string();
+  }
+  // The backing adapter's limits, as Dawn validates a request against them.
+  WGPUCompatibilityModeLimits host_compat = WGPU_COMPATIBILITY_MODE_LIMITS_INIT;
+  WGPULimits host = {};
+  host.nextInChain = &host_compat.chain;
+  const bool have_host = dawn::native::GetProcs().adapterGetLimits(
+                             adapter, &host) == WGPUStatus_Success;
+  const WGPUCompatibilityModeLimits* compat = FindCompat(required);
+  for (const LimitRow& row : kLimits) {
+    const std::optional<uint64_t> value = Read(row, *required, compat);
+    const std::optional<uint64_t> supported = claimed->Limit(row.name);
+    if (!value || !supported) {
+      continue;
+    }
+    if (!IsBetter(row, *value, *supported)) {
+      // Within the claim: a value the backing adapter cannot give is refused
+      // without naming the backing limit, which would contradict the claim.
+      const std::optional<uint64_t> backed =
+          have_host ? Read(row, host, &host_compat) : std::nullopt;
+      if (backed && IsBetter(row, *value, *backed)) {
+        return "Disallowed limit requested.";
+      }
+      continue;
+    }
+    // CheckLimit<>::Validate in dawn/native/Limits.h, then the contexts
+    // ValidateLimits and AdapterBase::CreateDeviceInternal add.
+    return base::StrCat(
+        {"Required limit (", base::NumberToString(*value), ") is ",
+         row.limit_class == LimitClass::kMaximum ? "greater" : "lower",
+         " than the supported limit (", base::NumberToString(*supported),
+         ").\n - While validating ", row.name,
+         "\n - While validating required limits\n"});
+  }
+  return std::string();
+}
