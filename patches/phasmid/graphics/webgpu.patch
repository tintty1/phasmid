+namespace gpu::webgpu {
+
+// The WebGPU adapter a renderer sees, from the profile's gpu.webgpu. Without
+// a profile every function leaves Dawn's answer alone. Only what the wire
+// server sends changes; the decoder's own decisions keep reading Dawn.
+
+// False when gpu.webgpu.available is false: requestAdapter() then resolves
+// to null with "No available adapters.", as on a device without WebGPU.
+bool PhasmidWebGPUAvailable();
+
+// Whether the profile claims an adapter (gpu.webgpu.available), so the
+// SwiftShader fallback may back it when the host has no hardware adapter,
+// without --enable-unsafe-webgpu and its other effects.
+bool PhasmidAllowsFallbackAdapter();
+
+// Whether `feature` may be exposed: gpu.webgpu.features lists it.
+bool PhasmidFeatureListed(wgpu::FeatureName feature);
+
+// Replaces `exposed`, the features the host adapter backs, with every listed
+// feature this build knows, reporting each listed one missing from it
+// through phasmid::ReportUnbackedGpuClaim.
+void PhasmidClaimFeatures(std::vector<wgpu::FeatureName>* exposed);
+
+// Whether a required `feature` can be enabled on `adapter`: always without a
+// claimed adapter (Dawn validates), else whether the backing adapter has it.
+bool PhasmidFeatureBacked(wgpu::Adapter adapter, wgpu::FeatureName feature);
+
+// Wire-server procs: Dawn's answer, then the profile's vendor, architecture,
+// device, description, ids and subgroup sizes, or its limits. backendType and
+// adapterType stay the host's. A subgroup size, limit or CPU adapter the
+// claim does not match is reported.
+WGPUStatus PhasmidAdapterGetInfo(WGPUAdapter adapter, WGPUAdapterInfo* info);
+WGPUStatus PhasmidAdapterGetLimits(WGPUAdapter adapter, WGPULimits* limits);
+
+// The rejection message for the first requiredLimits entry, in Dawn's order,
+// beyond the profile's limit (Dawn's own text) or within it but beyond the
+// backing `adapter`'s ("Disallowed limit requested."), or empty when every
+// required limit is backed.
+std::string PhasmidCheckRequiredLimits(WGPUAdapter adapter,
+                                       const WGPULimits* required);
+
+}  // namespace gpu::webgpu
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_PHASMID_WEBGPU_H_
