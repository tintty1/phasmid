+    {"MAX_SERVER_WAIT_TIMEOUT", &GLCapabilities::max_server_wait_timeout,
+     Backing::kAtMost},
+    {"MAX_UNIFORM_BLOCK_SIZE", &GLCapabilities::max_uniform_block_size,
+     Backing::kAtMost},
+};
+
+constexpr CapRow<float> kWebGL2FloatCaps[] = {
+    {"MAX_TEXTURE_LOD_BIAS", &GLCapabilities::max_texture_lod_bias,
+     Backing::kAtMost},
+};
+
+bool IsWebGL2(const FeatureInfo* feature_info) {
+  return feature_info->context_type() == CONTEXT_TYPE_WEBGL2;
+}
+
+// The profile's capture for this context type, or null when Phasmid is not
+// active or the context is not a WebGL context.
+const phasmid::Profile::WebGL* ProfileWebGL(const FeatureInfo* feature_info) {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile || !feature_info || !feature_info->IsWebGLContext()) {
+    return nullptr;
+  }
+  return &profile->webgl(IsWebGL2(feature_info));
+}
+
+// "webgl" or "webgl2", the profile section below gpu.
+std::string_view Section(const FeatureInfo* feature_info) {
+  return IsWebGL2(feature_info) ? "webgl2" : "webgl";
+}
+
+template <typename T>
+T FromDouble(double value) {
+  if constexpr (std::is_integral_v<T>) {
+    return base::saturated_cast<T>(value);
+  } else {
+    return static_cast<T>(value);
+  }
+}
+
+// Replaces the host's `*value` with `claim`, first reporting a claim the
+// host's value cannot back.
+template <typename T>
+void Claim(std::string_view field, double claim, Backing backing, T* value) {
+  const double host = static_cast<double>(*value);
+  const bool backed = backing == Backing::kAtMost    ? claim <= host
+                      : backing == Backing::kAtLeast ? claim >= host
+                                                     : true;
+  if (!backed) {
+    phasmid::ReportUnbackedGpuClaim(
+        field, base::StrCat({"profile ", base::NumberToString(claim),
+                             ", host ", base::NumberToString(host)}));
+  }
+  *value = FromDouble<T>(claim);
+}
+
+// The profile value of a required parameter. Profile::Init refuses a profile
+// without it, so a miss is a mismatch between this table and the validation.
+double RequiredParam(const phasmid::Profile::WebGL& webgl,
+                     const char* name,
+                     size_t index = 0) {
+  std::optional<double> value = webgl.Param(name, index);
+  CHECK(value) << "Phasmid: gpu.webgl params." << name << " is not validated";
+  return *value;
+}
+
+template <typename T, size_t N>
+void ApplyCaps(const phasmid::Profile::WebGL& webgl,
+               std::string_view section,
+               const CapRow<T> (&rows)[N],
+               GLCapabilities* caps) {
+  for (const CapRow<T>& row : rows) {
+    Claim(base::StrCat({section, ".params.", row.name}),
+          RequiredParam(webgl, row.name), row.backing, &(caps->*row.member));
+  }
+}
+
+template <typename T>
+void PatchNumeric(const FeatureInfo* feature_info,
+                  GLenum pname,
+                  GLsizei length,
+                  T* params) {
+  const phasmid::Profile::WebGL* webgl = ProfileWebGL(feature_info);
+  if (!webgl || length < 1) {
+    return;
+  }
+  const std::string_view section = Section(feature_info);
+  const char* range_name = nullptr;
+  switch (pname) {
+    case GL_ALIASED_LINE_WIDTH_RANGE:
+      range_name = "ALIASED_LINE_WIDTH_RANGE";
+      break;
+    case GL_ALIASED_POINT_SIZE_RANGE:
+      range_name = "ALIASED_POINT_SIZE_RANGE";
+      break;
+    case GL_MAX_VIEWPORT_DIMS:
+      range_name = "MAX_VIEWPORT_DIMS";
+      break;
+    case GL_SUBPIXEL_BITS:
+      Claim(base::StrCat({section, ".params.SUBPIXEL_BITS"}),
+            RequiredParam(*webgl, "SUBPIXEL_BITS"), Backing::kAtMost, params);
+      return;
+    case GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT:
+      if (webgl->max_anisotropy) {
+        Claim(base::StrCat({section, ".max_anisotropy"}),
+              *webgl->max_anisotropy, Backing::kAtMost, params);
+      }
+      return;
+    case GL_MAX_DRAW_BUFFERS:
+      // GL_MAX_DRAW_BUFFERS_EXT in WebGL1 (WEBGL_draw_buffers). WebGL2
+      // answers MAX_DRAW_BUFFERS from GLCapabilities.
+      if (!IsWebGL2(feature_info) && webgl->max_draw_buffers) {
+        Claim(base::StrCat({section, ".max_draw_buffers"}),
+              *webgl->max_draw_buffers, Backing::kAtMost, params);
+      }
+      return;
+    default:
+      return;
+  }
+  // A range's low end is backed at or above the host's, its high end at or
+  // below. Both viewport dimensions are maxima.
+  const std::string field = base::StrCat({section, ".params.", range_name});
+  const bool is_range = pname != GL_MAX_VIEWPORT_DIMS;
+  Claim(field, RequiredParam(*webgl, range_name, 0),
+        is_range ? Backing::kAtLeast : Backing::kAtMost, &params[0]);
+  if (length >= 2) {
+    Claim(field, RequiredParam(*webgl, range_name, 1), Backing::kAtMost,
+          &params[1]);
+  }
+}
+
+}  // namespace
+
+const char* PhasmidWebGLString(const FeatureInfo* feature_info, GLenum name) {
+  const phasmid::Profile::WebGL* webgl = ProfileWebGL(feature_info);
+  if (!webgl) {
+    return nullptr;
+  }
+  if (name == GL_RENDERER) {
+    return webgl->unmasked_renderer.c_str();
+  }
+  if (name == GL_VENDOR) {
+    return webgl->unmasked_vendor.c_str();
+  }
+  return nullptr;
+}
+
+void PhasmidApplyGLCapabilities(const FeatureInfo* feature_info,
+                                GLCapabilities* caps) {
+  const phasmid::Profile::WebGL* webgl = ProfileWebGL(feature_info);
+  if (!webgl) {
+    return;
+  }
+  const std::string_view section = Section(feature_info);
+  ApplyCaps(*webgl, section, kCaps, caps);
+  const std::string viewport =
+      base::StrCat({section, ".params.MAX_VIEWPORT_DIMS"});
+  Claim(viewport, RequiredParam(*webgl, "MAX_VIEWPORT_DIMS", 0),
+        Backing::kAtMost, &caps->max_viewport_width);
+  Claim(viewport, RequiredParam(*webgl, "MAX_VIEWPORT_DIMS", 1),
+        Backing::kAtMost, &caps->max_viewport_height);
+  if (IsWebGL2(feature_info)) {
+    ApplyCaps(*webgl, section, kWebGL2IntCaps, caps);
+    ApplyCaps(*webgl, section, kWebGL2Int64Caps, caps);
+    ApplyCaps(*webgl, section, kWebGL2FloatCaps, caps);
+  }
+  // Report-only: the host still computes at its own precision.
+  caps->VisitPrecisions([webgl](GLenum shader, GLenum type,
+                                GLCapabilities::ShaderPrecision* out) {
+    if (type < GL_LOW_FLOAT || type > GL_HIGH_INT) {
+      return;
+    }
+    const phasmid::Profile::WebGL::Precision& claimed =
+        webgl->precision[shader == GL_FRAGMENT_SHADER ? 1 : 0]
+                        [type - GL_LOW_FLOAT];
+    out->min_range = claimed.range_min;
+    out->max_range = claimed.range_max;
+    out->precision = claimed.precision;
+  });
+}
+
+void PhasmidApplyCapabilities(const FeatureInfo* feature_info,
+                              Capabilities* caps) {
+  const phasmid::Profile::WebGL* webgl = ProfileWebGL(feature_info);
+  if (!webgl) {
+    return;
+  }
+  Claim(base::StrCat({Section(feature_info), ".params.MAX_TEXTURE_SIZE"}),
+        RequiredParam(*webgl, "MAX_TEXTURE_SIZE"), Backing::kAtMost,
+        &caps->max_texture_size);
+}
+
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLint* params) {
+  PatchNumeric(feature_info, pname, length, params);
+}
+
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLint64* params) {
+  PatchNumeric(feature_info, pname, length, params);
+}
+
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLfloat* params) {
+  PatchNumeric(feature_info, pname, length, params);
+}
+
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLboolean* params) {
+  PatchNumeric(feature_info, pname, length, params);
+}
+
+void PhasmidPatchShaderPrecision(const FeatureInfo* feature_info,
+                                 GLenum shader_type,
+                                 GLenum precision_type,
+                                 GLint* range,
+                                 GLint* precision) {
+  const phasmid::Profile::WebGL* webgl = ProfileWebGL(feature_info);
+  if (!webgl || precision_type < GL_LOW_FLOAT ||
+      precision_type > GL_HIGH_INT ||
+      (shader_type != GL_VERTEX_SHADER && shader_type != GL_FRAGMENT_SHADER)) {
+    return;
+  }
+  const phasmid::Profile::WebGL::Precision& claimed =
+      webgl->precision[shader_type == GL_FRAGMENT_SHADER ? 1 : 0]
+                      [precision_type - GL_LOW_FLOAT];
+  range[0] = claimed.range_min;
+  range[1] = claimed.range_max;
+  *precision = claimed.precision;
+}
+
+}  // namespace gpu::gles2
