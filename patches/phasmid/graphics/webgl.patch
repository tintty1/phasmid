+// How a claim must compare with the host's value to be backed. Most limits
+// are maxima. A minimum offset and an alignment are backed at or above the
+// host's value. MAX_ELEMENTS_INDICES and MAX_ELEMENTS_VERTICES are hints
+// that limit nothing.
+enum class Backing { kAtMost, kAtLeast, kHint };
+
+template <typename T>
+struct CapRow {
+  const char* name;
+  T GLCapabilities::* member;
+  Backing backing;
+};
+
+// Limits GLES2Implementation answers from GLCapabilities in WebGL1 and
+// WebGL2. MAX_VIEWPORT_DIMS is applied separately (two members).
+constexpr CapRow<int> kCaps[] = {
+    {"MAX_COMBINED_TEXTURE_IMAGE_UNITS",
+     &GLCapabilities::max_combined_texture_image_units, Backing::kAtMost},
+    {"MAX_CUBE_MAP_TEXTURE_SIZE", &GLCapabilities::max_cube_map_texture_size,
+     Backing::kAtMost},
+    {"MAX_FRAGMENT_UNIFORM_VECTORS",
+     &GLCapabilities::max_fragment_uniform_vectors, Backing::kAtMost},
+    {"MAX_RENDERBUFFER_SIZE", &GLCapabilities::max_renderbuffer_size,
+     Backing::kAtMost},
+    {"MAX_TEXTURE_IMAGE_UNITS", &GLCapabilities::max_texture_image_units,
+     Backing::kAtMost},
+    {"MAX_TEXTURE_SIZE", &GLCapabilities::max_texture_size, Backing::kAtMost},
+    {"MAX_VARYING_VECTORS", &GLCapabilities::max_varying_vectors,
+     Backing::kAtMost},
+    {"MAX_VERTEX_ATTRIBS", &GLCapabilities::max_vertex_attribs,
+     Backing::kAtMost},
+    {"MAX_VERTEX_TEXTURE_IMAGE_UNITS",
+     &GLCapabilities::max_vertex_texture_image_units, Backing::kAtMost},
+    {"MAX_VERTEX_UNIFORM_VECTORS", &GLCapabilities::max_vertex_uniform_vectors,
+     Backing::kAtMost},
+};
+
+// WebGL2 only: the client reads these from GLCapabilities when the context
+// is ES3.
+constexpr CapRow<int> kWebGL2IntCaps[] = {
+    {"MAX_3D_TEXTURE_SIZE", &GLCapabilities::max_3d_texture_size,
+     Backing::kAtMost},
+    {"MAX_ARRAY_TEXTURE_LAYERS", &GLCapabilities::max_array_texture_layers,
+     Backing::kAtMost},
+    {"MAX_COLOR_ATTACHMENTS", &GLCapabilities::max_color_attachments,
+     Backing::kAtMost},
+    {"MAX_COMBINED_UNIFORM_BLOCKS",
+     &GLCapabilities::max_combined_uniform_blocks, Backing::kAtMost},
+    {"MAX_DRAW_BUFFERS", &GLCapabilities::max_draw_buffers, Backing::kAtMost},
+    {"MAX_ELEMENTS_INDICES", &GLCapabilities::max_elements_indices,
+     Backing::kHint},
+    {"MAX_ELEMENTS_VERTICES", &GLCapabilities::max_elements_vertices,
+     Backing::kHint},
+    {"MAX_FRAGMENT_INPUT_COMPONENTS",
+     &GLCapabilities::max_fragment_input_components, Backing::kAtMost},
+    {"MAX_FRAGMENT_UNIFORM_BLOCKS",
+     &GLCapabilities::max_fragment_uniform_blocks, Backing::kAtMost},
+    {"MAX_FRAGMENT_UNIFORM_COMPONENTS",
+     &GLCapabilities::max_fragment_uniform_components, Backing::kAtMost},
+    {"MAX_PROGRAM_TEXEL_OFFSET", &GLCapabilities::max_program_texel_offset,
+     Backing::kAtMost},
+    {"MAX_SAMPLES", &GLCapabilities::max_samples, Backing::kAtMost},
+    {"MAX_TRANSFORM_FEEDBACK_INTERLEAVED_COMPONENTS",
+     &GLCapabilities::max_transform_feedback_interleaved_components,
