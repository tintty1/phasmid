+#ifndef GPU_COMMAND_BUFFER_SERVICE_PHASMID_WEBGL_H_
+#define GPU_COMMAND_BUFFER_SERVICE_PHASMID_WEBGL_H_
+
+#include "ui/gl/gl_bindings.h"
+
+namespace gpu {
+
+struct Capabilities;
+struct GLCapabilities;
+
+namespace gles2 {
+
+class FeatureInfo;
+
+// Phasmid: what a WebGL context reports, from the profile's gpu.webgl or
+// gpu.webgl2. Every function below leaves its output alone unless a profile
+// is active and `feature_info` belongs to a WebGL context, so the
+// compositor, raster and interop contexts keep the host's values.
+// Framebuffer-dependent values (*_BITS, SAMPLES, SAMPLE_BUFFERS,
+// IMPLEMENTATION_COLOR_READ_*) are never touched: they answer for whatever
+// framebuffer the page has bound.
+
+// UNMASKED_RENDERER_WEBGL for GL_RENDERER and UNMASKED_VENDOR_WEBGL for
+// GL_VENDOR, or null for any other name. The string lives as long as the
+// process.
+const char* PhasmidWebGLString(const FeatureInfo* feature_info, GLenum name);
+
+// Overwrites every limit the client caches and the twelve shader
+// precisions. A claim beyond the host's value, after the host's driver
+// workarounds, goes to phasmid::ReportUnbackedGpuClaim.
+void PhasmidApplyGLCapabilities(const FeatureInfo* feature_info,
+                                GLCapabilities* caps);
+
+// Capabilities::max_texture_size, so it agrees with GLCapabilities.
+void PhasmidApplyCapabilities(const FeatureInfo* feature_info,
+                              Capabilities* caps);
+
+// Fixed limits the client does not cache: ALIASED_LINE_WIDTH_RANGE,
+// ALIASED_POINT_SIZE_RANGE, SUBPIXEL_BITS, MAX_VIEWPORT_DIMS,
+// MAX_TEXTURE_MAX_ANISOTROPY_EXT and, in WebGL1, MAX_DRAW_BUFFERS_EXT.
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLint* params);
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLint64* params);
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLfloat* params);
+void PhasmidPatchNumeric(const FeatureInfo* feature_info,
+                         GLenum pname,
+                         GLsizei length,
+                         GLboolean* params);
+
+// getShaderPrecisionFormat() when the client cache misses.
+void PhasmidPatchShaderPrecision(const FeatureInfo* feature_info,
+                                 GLenum shader_type,
+                                 GLenum precision_type,
+                                 GLint* range,
+                                 GLint* precision);
+
+}  // namespace gles2
+}  // namespace gpu
+
+#endif  // GPU_COMMAND_BUFFER_SERVICE_PHASMID_WEBGL_H_
