+    {"MAX_UNIFORM_BUFFER_BINDINGS",
+     &GLCapabilities::max_uniform_buffer_bindings, Backing::kAtMost},
+    {"MAX_VARYING_COMPONENTS", &GLCapabilities::max_varying_components,
+     Backing::kAtMost},
+    {"MAX_VERTEX_OUTPUT_COMPONENTS",
+     &GLCapabilities::max_vertex_output_components, Backing::kAtMost},
+    {"MAX_VERTEX_UNIFORM_BLOCKS", &GLCapabilities::max_vertex_uniform_blocks,
+     Backing::kAtMost},
+    {"MAX_VERTEX_UNIFORM_COMPONENTS",
+     &GLCapabilities::max_vertex_uniform_components, Backing::kAtMost},
+    {"MIN_PROGRAM_TEXEL_OFFSET", &GLCapabilities::min_program_texel_offset,
+     Backing::kAtLeast},
+    {"UNIFORM_BUFFER_OFFSET_ALIGNMENT",
+     &GLCapabilities::uniform_buffer_offset_alignment, Backing::kAtLeast},
+};
+
+constexpr CapRow<int64_t> kWebGL2Int64Caps[] = {
+    {"MAX_COMBINED_FRAGMENT_UNIFORM_COMPONENTS",
+     &GLCapabilities::max_combined_fragment_uniform_components,
+     Backing::kAtMost},
+    {"MAX_COMBINED_VERTEX_UNIFORM_COMPONENTS",
+     &GLCapabilities::max_combined_vertex_uniform_components,
