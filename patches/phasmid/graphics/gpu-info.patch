--- a/content/browser/gpu/phasmid_gpu_info.cc
+++ b/content/browser/gpu/phasmid_gpu_info.cc
@@ -0,0 +1,29 @@
+// Copyright 2026 The Phasmid Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/browser/gpu/phasmid_gpu_info.h"
+
+#include "components/phasmid/profile.h"
+
+namespace content {
+
+gpu::GPUInfo PhasmidReportedGpuInfo(gpu::GPUInfo info) {
+  const phasmid::Profile* profile = phasmid::Profile::Get();
+  if (!profile) {
+    return info;
+  }
+  const phasmid::Profile::Gpu& claimed = profile->gpu();
+  gpu::GPUInfo::GPUDevice& active = info.active_gpu();
+  active.vendor_id = claimed.vendor_id;
+  active.device_id = claimed.device_id;
+  active.vendor_string = claimed.vendor_name;
+  active.device_string = claimed.device_name;
+  active.driver_vendor = claimed.driver_vendor;
+  active.driver_version = claimed.driver_version;
+  info.gl_vendor = claimed.gl_vendor;
+  info.gl_renderer = claimed.gl_renderer;
+  return info;
+}
+
+}  // namespace content
