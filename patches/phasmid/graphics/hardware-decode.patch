                  [gpu::GPU_FEATURE_TYPE_ACCELERATED_VIDEO_DECODE] !=
@@ -66,6 +76,37 @@
          gl::GetGLImplementation() == gl::kGLImplementationDisabled;
 }
 
+// Phasmid: the decoder configs of the claimed codecs, the profiles and sizes
+// D3D11VideoDecoder and VaapiVideoDecoder commonly offer for them
+// (media/gpu/windows/supported_profile_helpers.cc: 64x64 up to the largest
+// probed size; 1920x1088 is only its H.264 fallback), unencrypted only.
+SupportedVideoDecoderConfigs PhasmidDecoderConfigs(
+    const phasmid::Profile::HardwareDecode& decode) {
+  constexpr gfx::Size kMin(64, 64);
+  SupportedVideoDecoderConfigs configs;
+  if (decode.h264) {
+    configs.emplace_back(H264PROFILE_BASELINE, H264PROFILE_HIGH, kMin,
+                         gfx::Size(4096, 2304), /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (decode.hevc) {
+    configs.emplace_back(HEVCPROFILE_MAIN, HEVCPROFILE_MAIN10, kMin,
+                         gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (decode.vp9) {
+    configs.emplace_back(VP9PROFILE_PROFILE0, VP9PROFILE_PROFILE0, kMin,
+                         gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  if (decode.av1) {
+    configs.emplace_back(AV1PROFILE_PROFILE_MAIN, AV1PROFILE_PROFILE_MAIN, kMin,
+                         gfx::Size(8192, 8192), /*allow_encrypted=*/false,
+                         /*require_encrypted=*/false);
+  }
+  return configs;
+}
+
