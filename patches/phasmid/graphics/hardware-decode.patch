+  // Phasmid: a profile that claims no hardware decode gets none on any host,
+  // so HEVC support, main-thread decodingInfo() powerEfficient and WebCodecs
+  // never reveal the host's VA-API driver.
+  if (const phasmid::Profile* profile = phasmid::Profile::Get()) {
+    const phasmid::Profile::HardwareDecode& decode = profile->hardware_decode();
+    if (!decode.h264 && !decode.hevc && !decode.vp9 && !decode.av1) {
+      return true;
+    }
+  }
   return gpu_preferences.disable_accelerated_video_decode ||
