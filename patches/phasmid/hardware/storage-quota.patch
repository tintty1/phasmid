Phasmid: storage quota

What:     navigator.storage.estimate(), webkitTemporaryStorage and
          StorageBucket.estimate() report the quota stock Chrome computes for a
          disk of hardware.disk_total_bytes; usage stays real. The enforced
          quota, eviction and the incognito pool follow the same values.
Why:      The reported quota implies the host's disk size.
Profile:  hardware.disk_total_bytes, hardware.physical_memory_mb
Hooks:    storage/browser/quota/quota_device_info_helper.cc
          QuotaDeviceInfoHelper::AmountOfTotalDiskSpace, AmountOfPhysicalMemory;
          storage/browser/quota/quota_manager_impl.cc
          QuotaManagerImpl::CallGetVolumeInfo; storage/browser/BUILD.gn
Contexts: main, iframe, worker, shared worker, service worker
Guard:    tests/guards/hardware/storage-quota.py

--- a/storage/browser/quota/quota_device_info_helper.cc
+++ b/storage/browser/quota/quota_device_info_helper.cc
@@ -6,6 +6,7 @@
 
 #include "base/byte_size.h"
 #include "base/metrics/histogram_macros.h"
+#include "components/phasmid/profile.h"
 
 namespace storage {
 
@@ -13,12 +14,18 @@
 
 int64_t QuotaDeviceInfoHelper::AmountOfTotalDiskSpace(
     const base::FilePath& path) const {
+  if (const phasmid::Profile* profile = phasmid::Profile::Get()) {
+    return profile->disk_total_bytes();
+  }
   int64_t disk_space = base::SysInfo::AmountOfTotalDiskSpace(path).value_or(-1);
   UMA_HISTOGRAM_BOOLEAN("Quota.TotalDiskSpaceIsZero", disk_space <= 0);
   return disk_space;
 }
 
 uint64_t QuotaDeviceInfoHelper::AmountOfPhysicalMemory() const {
+  if (const phasmid::Profile* profile = phasmid::Profile::Get()) {
+    return static_cast<uint64_t>(profile->physical_memory_mb()) * 1024 * 1024;
+  }
   return base::SysInfo::AmountOfTotalPhysicalMemory().InBytes();
 }
 
