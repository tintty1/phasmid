     return {};
   }
 
+  // Phasmid: free space stays real, since writes can only use what is
+  // really free, capped at the claimed size.
+  if (const phasmid::Profile* profile = phasmid::Profile::Get()) {
+    disk_space->total =
+        base::ByteSize(static_cast<uint64_t>(profile->disk_total_bytes()));
+    if (disk_space->available > disk_space->total) {
+      disk_space->available = disk_space->total;
+    }
+  }
