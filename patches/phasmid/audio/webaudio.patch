+// Phasmid: audio.noise. Two seeded offsets of 1 to 4 ULPs, on the makeup gain
+// and on the total gain. Both multiply the signal, so silence stays zero and
+// graphs without a compressor are untouched. Changing the message or the
+// mapping changes every profile's output.
+struct PhasmidUlps {
+  int post_gain = 0;
+  int total_gain = 0;
+};
+
+PhasmidUlps PhasmidCompressorUlps() {
+  static const PhasmidUlps ulps = [] {
+    const phasmid::Profile* profile = phasmid::Profile::Get();
+    if (!profile || !profile->audio_noise_key()) {
+      return PhasmidUlps();
+    }
+    constexpr std::array<uint8_t, 3> kMessage = {'d', 'c', '1'};
+    const uint64_t h =
+        phasmid::SipHash24(*profile->audio_noise_key(), kMessage);
+    auto offset = [](uint64_t bits) {
+      const int magnitude = 1 + static_cast<int>(bits & 3);
+      return (bits & 4) ? -magnitude : magnitude;
+    };
+    return PhasmidUlps{offset(h), offset(h >> 3)};
+  }();
+  return ulps;
+}
+
+float ShiftUlps(float value, int ulps) {
+  if (value == 0 || !std::isfinite(value)) {
+    return value;
+  }
+  const float toward = ulps > 0 ? std::numeric_limits<float>::infinity()
+                                : -std::numeric_limits<float>::infinity();
+  for (int i = 0; i < std::abs(ulps); ++i) {
+    value = std::nextafter(value, toward);
+  }
+  return value;
+}
+
 }  // namespace
 
