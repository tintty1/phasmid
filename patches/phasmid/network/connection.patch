 #include "services/network/public/mojom/network_service.mojom.h"
 
 namespace network {
 
+namespace {
+
+net::EffectiveConnectionType PhasmidEffectiveConnectionType(
+    phasmid::Profile::Connection::EffectiveType type) {
+  switch (type) {
+    case phasmid::Profile::Connection::EffectiveType::kSlow2G:
+      return net::EFFECTIVE_CONNECTION_TYPE_SLOW_2G;
+    case phasmid::Profile::Connection::EffectiveType::k2G:
+      return net::EFFECTIVE_CONNECTION_TYPE_2G;
+    case phasmid::Profile::Connection::EffectiveType::k3G:
+      return net::EFFECTIVE_CONNECTION_TYPE_3G;
+    case phasmid::Profile::Connection::EffectiveType::k4G:
+      return net::EFFECTIVE_CONNECTION_TYPE_4G;
+  }
+  NOTREACHED();
+}
+
+}  // namespace
